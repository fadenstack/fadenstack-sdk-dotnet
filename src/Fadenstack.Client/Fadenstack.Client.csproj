<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fadenstack</RootNamespace>
    <PackageId>Fadenstack.Client</PackageId>
    <Description>The Fadenstack core client: an IChatClient for the gateway (agent-scoped or plain), sign-in and agent tokens, the agent profile, governance outcomes, tool classes and modes, and the server-session resources.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.11.0" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fadenstack.Client.Tests" />
    <InternalsVisibleTo Include="Fadenstack.Secrets.Tests" />
    <InternalsVisibleTo Include="Fadenstack.Agents" />
    <InternalsVisibleTo Include="Fadenstack.Agents.Tests" />
    <InternalsVisibleTo Include="Fadenstack.Mcp.Tests" />
  </ItemGroup>
</Project>
