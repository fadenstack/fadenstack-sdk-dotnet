<UserControl x:Class="Fadenstack.UI.Wpf.Views.ToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:t="clr-namespace:Fadenstack.UI.Tools;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=t:ToolsViewModel}"
             d:DesignWidth="380" d:DesignHeight="900"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" Focusable="True">
    <!--
        The Tools view (sdk/51 F05) for a ToolsViewModel: the policy banner, "On this computer" with the server cards (the switch, the
        status line, the tool chips and the fix of a card) and "On your server" with the governed tools; over the page the details drawer
        (facts, Trusted, the tools with their class and the raise picker, Advanced with the plain-http switch and its warning, Test,
        Restart, Edit and Remove) and the sheets (add or edit a server, import, scan). Binding and commands only: the code behind picks the
        colours, gives the panel its texts' language and direction, follows the width (the number of card columns, the drawer's width) and
        sends Esc to the warning, the sheet or the drawer. A secret value is typed into a password box that carries it to its row
        (b:SecretBox), which forgets it when the sheet is saved or closed. Every text is a UiStrings name; every control has an automation
        name. It works on .NET Framework 4.7.2 and on .NET 8. The module's own icons are Material Icons (Apache-2.0), in Tools.xaml.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Tools.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/WebSearch.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="Tools.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Form.Strong}">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            </Style>
            <Style x:Key="Tools.SubtitleWrap" TargetType="TextBlock" BasedOn="{StaticResource Form.Strong}">
                <Setter Property="FontSize" Value="15" />
            </Style>

            <!-- ===== A secret row: a name, a masked value (or "saved" with Replace), remove ===== -->
            <DataTemplate DataType="{x:Type t:SecretRowViewModel}">
                <Grid Margin="{StaticResource Fadenstack.Space.Item}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="SecretNameBox" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Fadenstack.Space.Beside}"
                             AutomationProperties.Name="{local:Text ToolsRowName}" />
                    <PasswordBox x:Name="SecretValueBox" Grid.Column="1" b:SecretBox.Value="{Binding Value}" Margin="{StaticResource Fadenstack.Space.Beside}"
                                 Visibility="{Binding ShowsInput, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                 AutomationProperties.Name="{local:Text ToolsRowValue}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="{StaticResource Fadenstack.Space.Beside}"
                                Visibility="{Binding IsKept, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{local:Text ToolsValueSaved}" VerticalAlignment="Center" Margin="0,0,4,0"
                                   AutomationProperties.Name="{local:Text ToolsValueSavedName}" />
                        <Button x:Name="ReplaceValueButton" Style="{StaticResource Form.Quiet}" Command="{Binding ReplaceCommand}" MinHeight="28" Padding="8,0"
                                Content="{local:Text ToolsReplaceValue}" AutomationProperties.Name="{local:Text ToolsReplaceValue}" />
                    </StackPanel>
                    <Button x:Name="RemoveRowButton" Grid.Column="2" Style="{StaticResource Form.IconButton}" Command="{Binding RemoveCommand}"
                            ToolTip="{local:Text ToolsRemoveRow}" AutomationProperties.Name="{local:Text ToolsRemoveRow}">
                        <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Close}" />
                    </Button>
                </Grid>
            </DataTemplate>

            <!-- ===== Add or edit a server: a modal sheet ===== -->
            <DataTemplate DataType="{x:Type t:ServerSheetViewModel}">
                <Border x:Name="ServerSheet" Style="{StaticResource Tools.Sheet}" b:DrawerFocus.IsEnabled="True" AutomationProperties.Name="{Binding Title}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,12,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Tools.SubtitleWrap}" Text="{Binding Title}" VerticalAlignment="Center" />
                            <Button x:Name="SheetCloseButton" Grid.Column="1" Style="{StaticResource Form.IconButton}" Command="{Binding CancelCommand}"
                                    ToolTip="{local:Text ToolsCloseSheet}" AutomationProperties.Name="{local:Text ToolsCloseSheet}">
                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Close}" />
                            </Button>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Tools.Rule}" Padding="16,12">
                            <DockPanel LastChildFill="False">
                                <Button x:Name="ImportMoreButton" DockPanel.Dock="Left" Style="{StaticResource Form.Quiet}" Command="{Binding ImportCommand}"
                                        Visibility="{Binding IsAdding, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                        Content="{local:Text ToolsImportMore}" AutomationProperties.Name="{local:Text ToolsImportMore}" />
                                <Button x:Name="SaveServerButton" DockPanel.Dock="Right" Style="{StaticResource Form.Primary}" Command="{Binding SaveCommand}"
                                        Content="{Binding PrimaryText}" AutomationProperties.Name="{Binding PrimaryText}" />
                                <Button x:Name="TestServerButton" DockPanel.Dock="Right" Style="{StaticResource Form.Secondary}" Command="{Binding TestCommand}" Margin="0,0,8,0"
                                        Content="{local:Text ToolsTestButton}" AutomationProperties.Name="{local:Text ToolsTestButton}" />
                            </DockPanel>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="16,0,16,12">
                                <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldLabel}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                <TextBox x:Name="LabelBox" Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="32" Margin="{StaticResource Fadenstack.Space.Tight}"
                                         IsEnabled="{Binding IsBusy, Converter={StaticResource Fadenstack.InverseBool}}" AutomationProperties.Name="{local:Text ToolsFieldLabel}" />
                                <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsFieldLabelHelp}" Margin="{StaticResource Fadenstack.Space.Block}" />
                                <StackPanel Orientation="Horizontal" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.Name="{local:Text ToolsKindName}">
                                    <RadioButton x:Name="KindProgramButton" Style="{StaticResource Tools.Segment}" IsChecked="{Binding IsProgram}" Content="{local:Text ToolsKindProgram}"
                                                 AutomationProperties.Name="{local:Text ToolsKindProgram}" />
                                    <RadioButton x:Name="KindAddressButton" Style="{StaticResource Tools.Segment}" IsChecked="{Binding IsAddress}" Content="{local:Text ToolsKindAddress}"
                                                 AutomationProperties.Name="{local:Text ToolsKindAddress}" />
                                </StackPanel>

                                <!-- A program: command, arguments, folder, environment. -->
                                <StackPanel Visibility="{Binding IsProgram, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldCommand}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <TextBox x:Name="CommandBox" Text="{Binding Command, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Fadenstack.Space.Block}"
                                             AutomationProperties.Name="{local:Text ToolsFieldCommand}" />
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldArguments}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <TextBox x:Name="ArgumentsBox" Text="{Binding ArgumentsText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" MinHeight="72" TextWrapping="NoWrap"
                                             VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" Margin="{StaticResource Fadenstack.Space.Block}"
                                             AutomationProperties.Name="{local:Text ToolsFieldArguments}" />
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldFolder}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <DockPanel Margin="{StaticResource Fadenstack.Space.Block}" LastChildFill="True">
                                        <Button x:Name="ChooseFolderButton" DockPanel.Dock="Right" Style="{StaticResource Form.Secondary}" Command="{Binding ChooseFolderCommand}" Margin="8,0,0,0"
                                                Content="{local:Text ToolsChooseFolder}" AutomationProperties.Name="{local:Text ToolsChooseFolder}" />
                                        <TextBox x:Name="FolderBox" Text="{Binding WorkingFolder, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{local:Text ToolsFieldFolder}" />
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldEnvironment}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <ItemsControl x:Name="EnvironmentRowsList" ItemsSource="{Binding EnvironmentRows}" Focusable="False" />
                                    <Button x:Name="AddEnvironmentButton" Style="{StaticResource Form.Quiet}" HorizontalAlignment="Left" Command="{Binding AddEnvironmentCommand}"
                                            Margin="{StaticResource Fadenstack.Space.Block}" Content="{local:Text ToolsAddRow}" AutomationProperties.Name="{local:Text ToolsAddRow}" />
                                </StackPanel>

                                <!-- An address: URL and headers. -->
                                <StackPanel Visibility="{Binding IsAddress, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldUrl}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <TextBox x:Name="UrlBox" Text="{Binding Url, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Fadenstack.Space.Tight}"
                                             AutomationProperties.Name="{local:Text ToolsFieldUrl}" />
                                    <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsFieldUrlHelp}" Margin="{StaticResource Fadenstack.Space.Block}" />
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldHeaders}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <ItemsControl x:Name="HeaderRowsList" ItemsSource="{Binding HeaderRows}" Focusable="False" />
                                    <Button x:Name="AddHeaderButton" Style="{StaticResource Form.Quiet}" HorizontalAlignment="Left" Command="{Binding AddHeaderCommand}"
                                            Margin="{StaticResource Fadenstack.Space.Block}" Content="{local:Text ToolsAddRow}" AutomationProperties.Name="{local:Text ToolsAddRow}" />
                                </StackPanel>

                                <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsFieldTimeout}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                <TextBox x:Name="TimeoutBox" Text="{Binding TimeoutText, UpdateSourceTrigger=PropertyChanged}" MaxLength="3" Width="96" HorizontalAlignment="Left"
                                         Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.Name="{local:Text ToolsFieldTimeout}" />
                                <DockPanel Margin="{StaticResource Fadenstack.Space.Block}" LastChildFill="True">
                                    <ToggleButton x:Name="EnabledSwitch" DockPanel.Dock="Right" Style="{StaticResource Tools.Switch}" IsChecked="{Binding Enabled}"
                                                  AutomationProperties.Name="{local:Text ToolsFieldEnabled}" />
                                    <TextBlock Text="{local:Text ToolsFieldEnabled}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsSecretsNote}" Margin="{StaticResource Fadenstack.Space.Block}" />
                                <TextBlock x:Name="SheetError" Style="{StaticResource Tools.Error}" Text="{Binding ErrorText}" Margin="{StaticResource Fadenstack.Space.Block}"
                                           Visibility="{Binding HasError, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive" />
                                <TextBlock x:Name="SheetTestResult" Text="{Binding TestText}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}"
                                           Visibility="{Binding HasTest, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- ===== Web search: a modal sheet (the template is WebSearchSettingsView's, Themes/WebSearch.xaml) ===== -->
            <DataTemplate DataType="{x:Type t:WebSearchSettingsViewModel}">
                <Border x:Name="WebSearchSheet" Style="{StaticResource Tools.Sheet}" b:DrawerFocus.IsEnabled="True" AutomationProperties.Name="{Binding Title}">
                    <ContentControl ContentTemplate="{StaticResource WebSearch.Body}" Content="{Binding}" Focusable="False" />
                </Border>
            </DataTemplate>

            <!-- ===== Import from another program's file: a modal sheet ===== -->
            <DataTemplate DataType="{x:Type t:ImportSheetViewModel}">
                <Border x:Name="ImportSheet" Style="{StaticResource Tools.Sheet}" b:DrawerFocus.IsEnabled="True" AutomationProperties.Name="{local:Text ToolsImportTitle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,12,8,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Tools.SubtitleWrap}" Text="{local:Text ToolsImportTitle}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Style="{StaticResource Form.IconButton}" Command="{Binding CancelCommand}"
                                    ToolTip="{local:Text ToolsCloseSheet}" AutomationProperties.Name="{local:Text ToolsCloseSheet}">
                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Close}" />
                            </Button>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Tools.Rule}" Padding="16,12">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="ImportCloseButton" Style="{StaticResource Form.Secondary}" Command="{Binding CancelCommand}" Margin="{StaticResource Fadenstack.Space.Beside}"
                                        Content="{local:Text ToolsCloseSheet}" AutomationProperties.Name="{local:Text ToolsCloseSheet}" />
                                <Button x:Name="ImportButton" Style="{StaticResource Form.Primary}" Command="{Binding ImportCommand}"
                                        Content="{local:Text ToolsImportButton}" AutomationProperties.Name="{local:Text ToolsImportButton}" />
                            </StackPanel>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="16,0,16,12">
                                <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsImportIntro}" Margin="{StaticResource Fadenstack.Space.Item}" />
                                <WrapPanel Margin="{StaticResource Fadenstack.Space.WrapBlock}">
                                    <Button x:Name="ReadClaudeButton" Style="{StaticResource Form.Secondary}" Command="{Binding ReadClaudeCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Content="{local:Text ToolsSourceClaude}" AutomationProperties.Name="{local:Text ToolsSourceClaude}" />
                                    <Button x:Name="ReadVsCodeButton" Style="{StaticResource Form.Secondary}" Command="{Binding ReadVsCodeCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Content="{local:Text ToolsSourceVsCode}" AutomationProperties.Name="{local:Text ToolsSourceVsCode}" />
                                    <Button x:Name="ReadCursorButton" Style="{StaticResource Form.Secondary}" Command="{Binding ReadCursorCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Content="{local:Text ToolsSourceCursor}" AutomationProperties.Name="{local:Text ToolsSourceCursor}" />
                                    <Button x:Name="ReadFileButton" Style="{StaticResource Form.Secondary}" Command="{Binding ReadFileCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Content="{local:Text ToolsSourceFile}" AutomationProperties.Name="{local:Text ToolsSourceFile}" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding StatusText}" Margin="{StaticResource Fadenstack.Space.Item}"
                                           Visibility="{Binding HasStatus, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                <ItemsControl ItemsSource="{Binding Candidates}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Style="{StaticResource Tools.Note}" Margin="{StaticResource Fadenstack.Space.Item}">
                                                <StackPanel>
                                                    <CheckBox IsChecked="{Binding IsTicked}" AutomationProperties.Name="{Binding TickName}">
                                                        <StackPanel>
                                                            <TextBlock Style="{StaticResource Form.Strong}" Text="{Binding Label}" />
                                                            <TextBlock Style="{StaticResource Fadenstack.Mono}" Text="{Binding Where}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </CheckBox>
                                                    <ItemsControl ItemsSource="{Binding Notes}" Margin="28,4,0,0" Focusable="False">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding}" />
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <StackPanel Margin="{StaticResource Fadenstack.Space.Item}" Visibility="{Binding HasSkipped, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsSkippedTitle}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                    <ItemsControl ItemsSource="{Binding Skipped}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,4">
                                                    <TextBlock Text="{Binding Name}" />
                                                    <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Reason}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                                <TextBlock Text="{Binding ResultText}" TextWrapping="Wrap" Visibility="{Binding HasResult, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                           AutomationProperties.LiveSetting="Polite" />
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DataTemplate>

            <!-- ===== Scan this computer: a modal sheet ===== -->
            <DataTemplate DataType="{x:Type t:ScanSheetViewModel}">
                <Border x:Name="ScanSheet" Style="{StaticResource Tools.Sheet}" b:DrawerFocus.IsEnabled="True" AutomationProperties.Name="{local:Text ToolsScanTitle}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="16,12,8,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Tools.Tile}" Background="{DynamicResource Fadenstack.InfoBackground}">
                                <Path Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.Tools.Radar}" />
                            </Border>
                            <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Tools.SubtitleWrap}" Text="{local:Text ToolsScanTitle}" />
                                <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsScanIntro}" />
                            </StackPanel>
                            <Button x:Name="ScanCloseButton" Grid.Column="2" Style="{StaticResource Form.IconButton}" Command="{Binding CancelCommand}" VerticalAlignment="Top"
                                    ToolTip="{local:Text ToolsScanClose}" AutomationProperties.Name="{local:Text ToolsScanClose}">
                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Close}" />
                            </Button>
                        </Grid>
                        <Border DockPanel.Dock="Bottom" Style="{StaticResource Tools.Rule}" Padding="16,12">
                            <StackPanel>
                                <Grid Margin="{StaticResource Fadenstack.Space.Item}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.Lock}" Fill="{DynamicResource Fadenstack.ForegroundMuted}"
                                          VerticalAlignment="Top" Margin="0,0,8,0" />
                                    <TextBlock Grid.Column="1" Style="{StaticResource Form.Caption}" Text="{local:Text ToolsScanFooter}" />
                                </Grid>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button x:Name="ScanCancelButton" Style="{StaticResource Form.Secondary}" Command="{Binding CancelCommand}" Margin="{StaticResource Fadenstack.Space.Beside}"
                                            Content="{local:Text ToolsCancel}" AutomationProperties.Name="{local:Text ToolsCancel}" />
                                    <Button x:Name="ScanAddButton" Style="{StaticResource Form.Primary}" Command="{Binding AddCommand}"
                                            Content="{Binding AddText}" AutomationProperties.Name="{Binding AddText}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                            <StackPanel Margin="16,0,16,12">
                                <!-- Where it looks and how far it got. -->
                                <Border Style="{StaticResource Tools.Note}" Margin="{StaticResource Fadenstack.Space.Block}">
                                    <StackPanel AutomationProperties.Name="{local:Text ToolsScanOptionsName}">
                                        <CheckBox x:Name="ScanOtherAppsBox" IsChecked="{Binding OtherApps}" IsEnabled="{Binding CanScanAgain}" Margin="{StaticResource Fadenstack.Space.Item}"
                                                  AutomationProperties.Name="{local:Text ToolsScanOtherApps}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsScanOtherApps}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                                <ItemsControl ItemsSource="{Binding Apps}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Style="{StaticResource Tools.Says}" Background="{DynamicResource Fadenstack.Surface}">
                                                                <TextBlock Text="{Binding Text}" FontSize="12" />
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding NotInstalledText}"
                                                           Visibility="{Binding HasNotInstalled, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="ScanThisComputerBox" IsChecked="{Binding ThisComputer}" IsEnabled="{Binding CanScanAgain}" Margin="{StaticResource Fadenstack.Space.Item}"
                                                  AutomationProperties.Name="{local:Text ToolsScanThisComputerOption}">
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsScanThisComputerOption}" />
                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding PortsText}" />
                                            </StackPanel>
                                        </CheckBox>
                                        <!-- Progress while it looks. -->
                                        <StackPanel x:Name="ScanProgressPanel" Visibility="{Binding IsScanning, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <ProgressBar x:Name="ScanProgress" Minimum="0" Maximum="{Binding ProgressTotal}" Value="{Binding ProgressDone}" Margin="{StaticResource Fadenstack.Space.Tight}"
                                                         AutomationProperties.Name="{local:Text ToolsScanProgressName}" />
                                            <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding ProgressText}" AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                        <!-- Done: the good line, Scan again beside it. -->
                                        <DockPanel x:Name="ScanDoneRow" LastChildFill="True" Visibility="{Binding IsDone, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Form.Quiet}" Command="{Binding StartCommand}" MinHeight="28" Padding="8,0"
                                                    Content="{local:Text ToolsScanAgain}" AutomationProperties.Name="{local:Text ToolsScanAgain}" />
                                            <Path DockPanel.Dock="Left" Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.Tools.CheckCircle}"
                                                  Fill="{DynamicResource Fadenstack.Success}" Margin="0,0,8,0" />
                                            <TextBlock FontWeight="SemiBold" Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                        </DockPanel>
                                        <!-- Stopped, failed or nothing ticked. -->
                                        <DockPanel x:Name="ScanProblemRow" LastChildFill="True" Visibility="{Binding IsProblem, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <Button DockPanel.Dock="Right" Style="{StaticResource Form.Quiet}" Command="{Binding StartCommand}" MinHeight="28" Padding="8,0"
                                                    Content="{local:Text ToolsScanAgain}" AutomationProperties.Name="{local:Text ToolsScanAgain}" />
                                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding EmptyText}" Margin="{StaticResource Fadenstack.Space.Block}"
                                           Visibility="{Binding HasEmptyText, Converter={StaticResource Fadenstack.BoolToVisibility}}" />

                                <!-- The findings, grouped by where they were found. -->
                                <ItemsControl ItemsSource="{Binding Groups}" Focusable="False" Visibility="{Binding HasFindings, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="{StaticResource Fadenstack.Space.Block}">
                                                <TextBlock Style="{StaticResource Form.Caption}" FontWeight="SemiBold" Text="{Binding Title}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                                <Border Style="{StaticResource Tools.ListCard}">
                                                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False" AutomationProperties.Name="{Binding Title}">
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Style="{StaticResource Tools.Rule}" x:Name="Row">
                                                                    <Grid Margin="12,8">
                                                                        <Grid.ColumnDefinitions>
                                                                            <ColumnDefinition Width="Auto" />
                                                                            <ColumnDefinition Width="*" />
                                                                            <ColumnDefinition Width="Auto" />
                                                                        </Grid.ColumnDefinitions>
                                                                        <CheckBox IsChecked="{Binding IsTicked}" IsEnabled="{Binding CanTick}" VerticalAlignment="Top" Margin="0,0,8,0"
                                                                                  AutomationProperties.Name="{Binding TickName}" />
                                                                        <StackPanel Grid.Column="1">
                                                                            <TextBlock Style="{StaticResource Form.Strong}" Text="{Binding Label}" />
                                                                            <TextBlock Style="{StaticResource Fadenstack.Mono}" Text="{Binding Where}" TextTrimming="CharacterEllipsis" />
                                                                            <ItemsControl ItemsSource="{Binding Notes}" Focusable="False">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                                                                                            <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.Lock}" VerticalAlignment="Top" Margin="0,0,6,0"
                                                                                                  Fill="{DynamicResource Fadenstack.ForegroundMuted}"
                                                                                                  Visibility="{Binding IsSecret, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                                                            <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Text}" MaxWidth="220" />
                                                                                        </StackPanel>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                        <TextBlock Grid.Column="2" Style="{StaticResource Form.Caption}" FontWeight="SemiBold" Text="{Binding SideText}" VerticalAlignment="Top"
                                                                                   MaxWidth="110" TextAlignment="Right" />
                                                                    </Grid>
                                                                </Border>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </DockPanel>
                </Border>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid x:Name="ToolsRoot">
        <!-- ===== The page ===== -->
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False" AutomationProperties.Name="{local:Text ToolsTitle}">
            <StackPanel Margin="12" MaxWidth="1400">
                <!-- Header: the title with its line, then Scan this computer and Add server. -->
                <TextBlock Style="{StaticResource Form.Title}" Text="{local:Text ToolsTitle}" Margin="0,0,0,2" />
                <TextBlock Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsIntro}" Margin="{StaticResource Fadenstack.Space.Item}" />
                <WrapPanel Margin="{StaticResource Fadenstack.Space.WrapBlock}" Visibility="{Binding ShowsLists, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <Button x:Name="ScanButton" Style="{StaticResource Form.Secondary}" Command="{Binding ScanCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                            Visibility="{Binding ShowsScanButton, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.Name="{local:Text ToolsScanThisComputer}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Tools.Radar}" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Text ToolsScanThisComputer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AddServerButton" Style="{StaticResource Form.Primary}" Command="{Binding AddServerCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                            Visibility="{Binding ShowsAddButton, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.Name="{local:Text ToolsAddServer}">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Add}" Margin="0,0,8,0" />
                            <TextBlock Text="{local:Text ToolsAddServer}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>

                <TextBlock x:Name="SignInNeeded" Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsSignInNeeded}"
                           Margin="{StaticResource Fadenstack.Space.Block}" Visibility="{Binding NeedsSignIn, Converter={StaticResource Fadenstack.BoolToVisibility}}" />

                <StackPanel Visibility="{Binding ShowsLists, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <!-- The bar: where tools run, the policy, the filter. -->
                    <WrapPanel Margin="{StaticResource Fadenstack.Space.WrapBlock}">
                        <!-- The tabs wrap: three do not fit beside each other in a narrow pane (Office's), and none may be cut. -->
                        <WrapPanel x:Name="ToolsTabs" Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{local:Text ToolsTitle}">
                            <RadioButton x:Name="AppTab" Style="{StaticResource Tools.Segment}" Margin="0,0,8,8" IsChecked="{Binding ShowsApp}" Content="{Binding AppTabText}"
                                         AutomationProperties.Name="{Binding AppTabText}" />
                            <RadioButton x:Name="LocalTab" Style="{StaticResource Tools.Segment}" Margin="0,0,8,8" IsChecked="{Binding ShowsLocal}" Content="{Binding LocalTabText}"
                                         AutomationProperties.Name="{Binding LocalTabText}" />
                            <RadioButton x:Name="ServerTab" Style="{StaticResource Tools.Segment}" Margin="0,0,8,8" IsChecked="{Binding ShowsServer}" Content="{Binding ServerTabText}"
                                         AutomationProperties.Name="{Binding ServerTabText}"
                                         Visibility="{Binding ShowsServerTab, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                        </WrapPanel>
                        <Border x:Name="PolicyChip" Style="{StaticResource Tools.Policy}" ToolTip="{Binding PolicyTip}" AutomationProperties.Name="{Binding PolicyTip}"
                                Visibility="{Binding ShowsLocalChip, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.VerifiedUser}" Margin="0,0,6,0"
                                      Visibility="{Binding PolicyIsWarning, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}" />
                                <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.WarningAmber}" Margin="0,0,6,0"
                                      Visibility="{Binding PolicyIsWarning, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                <TextBlock Text="{Binding PolicyText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                        <Grid Width="200" Margin="0,0,0,8" VerticalAlignment="Center">
                            <TextBox x:Name="FilterBox" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6"
                                     AutomationProperties.Name="{local:Text ToolsFilterPlaceholder}" />
                            <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.Search}" HorizontalAlignment="Left" Margin="9,0,0,0"
                                  Fill="{DynamicResource Fadenstack.ForegroundMuted}" />
                        </Grid>
                    </WrapPanel>

                    <!-- The policy does not allow local servers: a banner in the flow. -->
                    <Border x:Name="PolicyBanner" Style="{StaticResource Form.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Block}"
                            Visibility="{Binding ShowsBanner, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <DockPanel>
                            <Path DockPanel.Dock="Left" Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.WarningAmber}" VerticalAlignment="Top" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding BannerText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                    </Border>

                    <!-- ===== In this app: the tools the app itself gives the assistant, read only ===== -->
                    <StackPanel x:Name="AppSection" Visibility="{Binding ShowsApp, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <TextBlock x:Name="AppEmpty" Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsAppNone}"
                                   Margin="{StaticResource Fadenstack.Space.Block}" Visibility="{Binding ShowsAppEmpty, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                        <TextBlock x:Name="AppNoMatch" Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsNoToolsMatch}"
                                   Margin="{StaticResource Fadenstack.Space.Block}" Visibility="{Binding ShowsAppNoMatch, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                        <!-- Web search: only where the app gave the page the person's web search settings. -->
                        <Border x:Name="WebSearchRow" Style="{StaticResource Tools.ListCard}" Margin="{StaticResource Fadenstack.Space.Block}" Padding="12,8"
                                Visibility="{Binding ShowsWebSearch, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <DockPanel LastChildFill="True">
                                <Button x:Name="WebSearchButton" DockPanel.Dock="Right" Style="{StaticResource Form.Secondary}" Command="{Binding OpenWebSearchCommand}" Margin="8,0,0,0"
                                        VerticalAlignment="Center" Content="{Binding WebSearchButtonText}" AutomationProperties.Name="{Binding WebSearchButtonText}" />
                                <StackPanel>
                                    <DockPanel LastChildFill="False">
                                        <TextBlock Style="{StaticResource Form.Strong}" Text="{Binding WebSearchName}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Border Style="{StaticResource Tools.StateChip.Muted}" VerticalAlignment="Center">
                                            <TextBlock x:Name="WebSearchState" Style="{StaticResource Tools.MicroText}" Text="{Binding WebSearchState}" />
                                        </Border>
                                    </DockPanel>
                                    <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding WebSearchText}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <ItemsControl x:Name="AppTools" ItemsSource="{Binding AppTools}" Focusable="False" AutomationProperties.Name="{Binding AppTabText}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Tools.ListCard}" Margin="{StaticResource Fadenstack.Space.Block}" Padding="12,8">
                                            <StackPanel>
                                                <DockPanel LastChildFill="True">
                                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                        <Border Style="{StaticResource Tools.StateChip}" Visibility="{Binding IsRead, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Tools.MicroText}" Text="{Binding ClassLabel}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Tools.StateChip.Outlined}" Visibility="{Binding IsWrite, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Tools.Micro}" Text="{Binding ClassLabel}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Tools.StateChip.Warning}" Visibility="{Binding IsDestructive, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Tools.MicroText}" Text="{Binding ClassLabel}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Tools.StateChip.Muted}" Visibility="{Binding IsUnmarked, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Tools.MicroText}" Text="{Binding ClassLabel}" />
                                                        </Border>
                                                    </Grid>
                                                    <TextBlock Style="{StaticResource Tools.Mono}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center">
                                                        <TextBlock.Resources>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tools.Mono}" />
                                                        </TextBlock.Resources>
                                                    </TextBlock>
                                                </DockPanel>
                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Description}"
                                                           Visibility="{Binding HasDescription, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <!-- ===== On this computer ===== -->
                    <StackPanel Visibility="{Binding ShowsLocal, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <!-- Nothing yet: the dashed first-open card. -->
                        <Grid x:Name="EmptyState" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.Name="{local:Text ToolsSectionServers}"
                              Visibility="{Binding ShowsEmpty, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <Rectangle Stroke="{DynamicResource Fadenstack.ControlBorder}" StrokeThickness="1" StrokeDashArray="4 4" RadiusX="12" RadiusY="12" />
                            <StackPanel Margin="16,24" HorizontalAlignment="Center">
                                <Border Style="{StaticResource Tools.Tile.Hero}" Margin="{StaticResource Fadenstack.Space.Block}">
                                    <Path Style="{StaticResource Tools.Icon.Hero}" Data="{StaticResource Icon.Tools.Hub}" />
                                </Border>
                                <TextBlock Style="{StaticResource Tools.SubtitleWrap}" Text="{local:Text ToolsEmptyTitle}" TextAlignment="Center" Margin="{StaticResource Fadenstack.Space.Item}" />
                                <TextBlock Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsEmptyText}"
                                           TextAlignment="Center" MaxWidth="460" Margin="{StaticResource Fadenstack.Space.Block}" />
                                <WrapPanel HorizontalAlignment="Center">
                                    <Button x:Name="EmptyScanButton" Style="{StaticResource Form.Primary}" Command="{Binding ScanCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Visibility="{Binding ScanIsPrimary, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.Name="{local:Text ToolsScanThisComputer}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Tools.Radar}" Margin="0,0,8,0" />
                                            <TextBlock Text="{local:Text ToolsScanThisComputer}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="EmptyAddSecondaryButton" Style="{StaticResource Form.Secondary}" Command="{Binding AddServerCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Visibility="{Binding ScanIsPrimary, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                            Content="{local:Text ToolsAddServer}" AutomationProperties.Name="{local:Text ToolsAddServer}" />
                                    <Button x:Name="EmptyAddButton" Style="{StaticResource Form.Primary}" Command="{Binding AddServerCommand}" Margin="{StaticResource Fadenstack.Space.BesideItem}"
                                            Visibility="{Binding AddIsPrimary, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                            Content="{local:Text ToolsAddServer}" AutomationProperties.Name="{local:Text ToolsAddServer}" />
                                </WrapPanel>
                            </StackPanel>
                        </Grid>

                        <!-- ===== MCP servers: the cards ===== -->
                        <StackPanel Visibility="{Binding ShowsServerCards, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Tools.SubtitleWrap}" Text="{local:Text ToolsSectionServers}" Margin="0,0,0,2" />
                            <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsSectionServersHelp}" Margin="{StaticResource Fadenstack.Space.Item}" />
                            <Border x:Name="ListNote" Style="{StaticResource Form.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Item}"
                                    Visibility="{Binding HasListNote, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                <TextBlock Text="{Binding ListNote}" TextWrapping="Wrap" />
                            </Border>
                            <TextBlock x:Name="NoMatch" Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsNoToolsMatch}"
                                       Margin="{StaticResource Fadenstack.Space.Item}" Visibility="{Binding ShowsNoMatch, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                            <ItemsControl x:Name="ServerCards" ItemsSource="{Binding Servers}" Focusable="False" Margin="-6,0,-6,0" AutomationProperties.Name="{local:Text ToolsSectionServers}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="{Binding CardColumns, RelativeSource={RelativeSource AncestorType={x:Type local:ToolsView}}}" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="6,0,6,12">
                                            <Button Style="{StaticResource Tools.Card}" Command="{Binding OpenCommand}" AutomationProperties.Name="{Binding OpenName}">
                                                <StackPanel>
                                                    <Grid Margin="0,0,0,8">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Border>
                                                            <Border.Style>
                                                                <Style TargetType="Border" BasedOn="{StaticResource Tools.Tile}">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsOn}" Value="False">
                                                                            <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                            <Grid>
                                                                <Path Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.Tools.Terminal}"
                                                                      Visibility="{Binding IsProgram, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                                <Path Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.Tools.Cable}"
                                                                      Visibility="{Binding IsAddress, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                            </Grid>
                                                        </Border>
                                                        <!-- Room at the right for the switch, which sits over the card. -->
                                                        <StackPanel Grid.Column="1" Margin="12,0,56,0" VerticalAlignment="Center">
                                                            <TextBlock Style="{StaticResource Tools.Subtitle}" Text="{Binding Label}" />
                                                            <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="12" Text="{Binding OriginText}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Grid>
                                                    <!-- A refusal or a warning is on the warning tint; the other states are the dot and the words. -->
                                                    <Border Style="{StaticResource Tools.WarnLine}" Margin="0,0,0,8" ToolTip="{Binding StatusTip}"
                                                            Visibility="{Binding StatusIsWarning, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource Tools.Dot.Warn}" Margin="0,4,6,0" />
                                                            <TextBlock Style="{StaticResource Tools.Status.Warn}" FontSize="12" Text="{Binding StatusText}" MaxWidth="280" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Style="{StaticResource Tools.ProblemLine}" Margin="0,0,0,8"
                                                            Visibility="{Binding StatusIsProblem, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                        <StackPanel Orientation="Horizontal">
                                                            <Ellipse Style="{StaticResource Tools.Dot.Problem}" Margin="0,4,6,0" />
                                                            <TextBlock Style="{StaticResource Tools.Status.Warn}" FontSize="12" Text="{Binding StatusText}" MaxWidth="280" />
                                                        </StackPanel>
                                                    </Border>
                                                    <StackPanel Style="{StaticResource Tools.PlainLine}" Margin="0,0,0,8">
                                                        <Ellipse Style="{StaticResource Tools.Dot}" Margin="0,4,6,0" />
                                                        <TextBlock Style="{StaticResource Tools.Status}" FontSize="12" Text="{Binding StatusText}" MaxWidth="280" />
                                                    </StackPanel>
                                                    <ItemsControl ItemsSource="{Binding Chips}" Focusable="False" Visibility="{Binding HasChips, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                        <ItemsControl.ItemsPanel>
                                                            <ItemsPanelTemplate>
                                                                <WrapPanel />
                                                            </ItemsPanelTemplate>
                                                        </ItemsControl.ItemsPanel>
                                                        <ItemsControl.ItemTemplate>
                                                            <DataTemplate>
                                                                <Grid>
                                                                    <Border Style="{StaticResource Tools.ToolChip}" ToolTip="{Binding Tip}"
                                                                            Visibility="{Binding IsTool, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                                        <TextBlock Style="{StaticResource Fadenstack.Mono}" FontSize="12" Text="{Binding Name}" />
                                                                    </Border>
                                                                    <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="12" Text="{Binding Name}" Margin="4,0,6,6" VerticalAlignment="Center"
                                                                               Visibility="{Binding IsMore, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                                </Grid>
                                                            </DataTemplate>
                                                        </ItemsControl.ItemTemplate>
                                                    </ItemsControl>
                                                    <Border Height="28" Visibility="{Binding HasFix, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                </StackPanel>
                                            </Button>
                                            <ToggleButton Style="{StaticResource Tools.Switch}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,17,9,0"
                                                          IsChecked="{Binding IsOn}" AutomationProperties.Name="{Binding SwitchName}" />
                                            <!-- A failed card's fix, over the card (a button inside a button is not one). -->
                                            <Button Style="{StaticResource Form.Quiet}" Command="{Binding FixCommand}" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                                    MinHeight="28" Padding="8,0" Margin="8,0,0,6" Content="{Binding FixText}" AutomationProperties.Name="{Binding FixText}"
                                                    Visibility="{Binding HasFix, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </StackPanel>

                    <!-- ===== On your server ===== -->
                    <StackPanel x:Name="CloudSection" Visibility="{Binding ShowsServer, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsCloudIntro}" Margin="{StaticResource Fadenstack.Space.Block}" />
                        <TextBlock Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{local:Text ToolsLoading}" Margin="{StaticResource Fadenstack.Space.Block}"
                                   Visibility="{Binding IsLoadingCloud, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                        <DockPanel Margin="{StaticResource Fadenstack.Space.Block}" LastChildFill="True" Visibility="{Binding HasCloudMessage, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <Button x:Name="RetryButton" DockPanel.Dock="Right" Style="{StaticResource Form.Secondary}" Command="{Binding RetryCommand}" Margin="12,0,0,0"
                                    Visibility="{Binding CanRetry, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                    Content="{local:Text ToolsTryAgain}" AutomationProperties.Name="{local:Text ToolsTryAgain}" />
                            <TextBlock Style="{StaticResource Form.Caption}" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="{Binding CloudMessage}" VerticalAlignment="Center" />
                        </DockPanel>
                        <ItemsControl x:Name="CloudGroups" ItemsSource="{Binding CloudGroups}" Focusable="False" AutomationProperties.Name="{Binding ServerTabText}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Tools.ListCard}" Margin="{StaticResource Fadenstack.Space.Block}">
                                        <StackPanel>
                                            <Grid Margin="12,12,8,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Style="{StaticResource Tools.Tile}">
                                                    <Path Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.Tools.Cloud}" />
                                                </Border>
                                                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                                                    <TextBlock Style="{StaticResource Tools.Subtitle}" Text="{Binding Server}" />
                                                    <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Summary}" />
                                                </StackPanel>
                                                <Button Grid.Column="2" Style="{StaticResource Form.IconButton}" Command="{Binding ToggleCommand}" ToolTip="{Binding CollapseName}"
                                                        AutomationProperties.Name="{Binding CollapseName}" Visibility="{Binding IsExpanded, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                    <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.KeyboardArrowUp}" />
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource Form.IconButton}" Command="{Binding ToggleCommand}" ToolTip="{Binding ExpandName}"
                                                        AutomationProperties.Name="{Binding ExpandName}" Visibility="{Binding IsCollapsed, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                    <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.KeyboardArrowDown}" />
                                                </Button>
                                            </Grid>
                                            <ItemsControl ItemsSource="{Binding Tools}" Focusable="False" Visibility="{Binding IsExpanded, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Tools.Rule}" Padding="12,8">
                                                            <StackPanel>
                                                                <DockPanel LastChildFill="True">
                                                                    <Grid DockPanel.Dock="Right" VerticalAlignment="Center" Margin="8,0,0,0">
                                                                        <Border Style="{StaticResource Tools.StateChip}" Visibility="{Binding IsForThis, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                                            <TextBlock Style="{StaticResource Tools.MicroText}" Text="{Binding StateText}" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource Tools.StateChip.Outlined}" Visibility="{Binding IsNotFor, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                                            <TextBlock Style="{StaticResource Tools.Micro}" Text="{Binding StateText}" />
                                                                        </Border>
                                                                        <Border Style="{StaticResource Tools.StateChip.Muted}" Visibility="{Binding IsOff, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                                            <StackPanel Orientation="Horizontal">
                                                                                <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.Tools.PowerSettingsNew}" Margin="0,0,4,0" />
                                                                                <TextBlock Style="{StaticResource Tools.MicroText}" Text="{Binding StateText}" />
                                                                            </StackPanel>
                                                                        </Border>
                                                                    </Grid>
                                                                    <TextBlock Style="{StaticResource Tools.Mono}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" VerticalAlignment="Center">
                                                                        <TextBlock.Resources>
                                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource Tools.Mono}" />
                                                                        </TextBlock.Resources>
                                                                    </TextBlock>
                                                                </DockPanel>
                                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Description}"
                                                                           Visibility="{Binding HasDescription, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- ===== The details drawer: over the page, on a scrim; Esc closes it ===== -->
        <Grid x:Name="DrawerLayer" Visibility="{Binding IsDetailsOpen, Converter={StaticResource Fadenstack.BoolToVisibility}}">
            <Button x:Name="DrawerScrim" Style="{StaticResource Tools.Scrim}" Command="{Binding CloseDetailsCommand}" AutomationProperties.Name="{local:Text ToolsCloseDetails}" />
            <ContentControl Content="{Binding Details}" HorizontalAlignment="Right" VerticalAlignment="Stretch" Focusable="False"
                            Width="{Binding DrawerWidth, RelativeSource={RelativeSource AncestorType={x:Type local:ToolsView}}}">
                <ContentControl.ContentTemplate>
                    <DataTemplate>
                        <Border x:Name="DrawerPanel" Style="{StaticResource Tools.Drawer}" HorizontalAlignment="Stretch" b:DrawerFocus.IsEnabled="True"
                                AutomationProperties.Name="{Binding DrawerName}">
                            <DockPanel>
                                <!-- Header: the icon, the name and its status, the switch, close. -->
                                <Grid DockPanel.Dock="Top" Margin="12,12,8,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border>
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource Tools.Tile}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Server.IsOn}" Value="False">
                                                        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <Grid>
                                            <Path Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.Tools.Terminal}"
                                                  Visibility="{Binding Server.IsProgram, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                            <Path Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.Tools.Cable}"
                                                  Visibility="{Binding Server.IsAddress, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                        </Grid>
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Tools.Subtitle}" Text="{Binding Label}" />
                                        <Border Style="{StaticResource Tools.WarnLine}" Margin="0,2,0,0" Visibility="{Binding Server.StatusIsWarning, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Tools.Dot.Warn}" Margin="0,4,6,0" />
                                                <TextBlock Style="{StaticResource Tools.Status.Warn}" FontSize="12" Text="{Binding StatusText}" MaxWidth="200" />
                                            </StackPanel>
                                        </Border>
                                        <Border Style="{StaticResource Tools.ProblemLine}" Margin="0,2,0,0" Visibility="{Binding Server.StatusIsProblem, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <StackPanel Orientation="Horizontal">
                                                <Ellipse Style="{StaticResource Tools.Dot.Problem}" Margin="0,4,6,0" />
                                                <TextBlock Style="{StaticResource Tools.Status.Warn}" FontSize="12" Text="{Binding StatusText}" MaxWidth="200" />
                                            </StackPanel>
                                        </Border>
                                        <StackPanel Style="{StaticResource Tools.DrawerPlainLine}" Margin="0,2,0,0">
                                            <Ellipse Style="{StaticResource Tools.DrawerDot}" Margin="0,4,6,0" />
                                            <TextBlock Style="{StaticResource Tools.DrawerStatus}" FontSize="12" Text="{Binding StatusText}" MaxWidth="200" />
                                        </StackPanel>
                                    </StackPanel>
                                    <ToggleButton x:Name="DrawerSwitch" Grid.Column="2" Style="{StaticResource Tools.Switch}" IsChecked="{Binding Server.IsOn}"
                                                  AutomationProperties.Name="{Binding Server.SwitchName}" />
                                    <Button x:Name="DrawerCloseButton" Grid.Column="3" Style="{StaticResource Form.IconButton}" Command="{Binding CloseCommand}" VerticalAlignment="Center"
                                            ToolTip="{local:Text ToolsCloseDetails}" AutomationProperties.Name="{local:Text ToolsCloseDetails}">
                                        <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Close}" />
                                    </Button>
                                </Grid>

                                <!-- Footer: Test, Restart and Edit as icon buttons; Remove at the right asks first. -->
                                <Border DockPanel.Dock="Bottom" Style="{StaticResource Tools.Rule}" Padding="12,8">
                                    <StackPanel>
                                        <DockPanel x:Name="RemoveConfirm" LastChildFill="True" Margin="{StaticResource Fadenstack.Space.Item}"
                                                   Visibility="{Binding IsConfirmingRemove, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <Button x:Name="KeepButton" DockPanel.Dock="Right" Style="{StaticResource Form.Quiet}" Command="{Binding KeepCommand}" Margin="4,0,0,0"
                                                    Content="{local:Text ToolsRemoveKeep}" AutomationProperties.Name="{local:Text ToolsRemoveKeep}" />
                                            <Button x:Name="ConfirmRemoveButton" DockPanel.Dock="Right" Style="{StaticResource Form.Secondary}" Command="{Binding ConfirmRemoveCommand}" Margin="8,0,0,0"
                                                    Content="{local:Text ToolsRemoveYes}" AutomationProperties.Name="{Binding RemoveName}" />
                                            <TextBlock Text="{Binding RemoveConfirmText}" TextWrapping="Wrap" VerticalAlignment="Center" AutomationProperties.LiveSetting="Assertive" />
                                        </DockPanel>
                                        <DockPanel LastChildFill="False">
                                            <Button x:Name="TestButton" DockPanel.Dock="Left" Style="{StaticResource Form.IconButton}" Command="{Binding TestCommand}" Margin="0,0,4,0"
                                                    ToolTip="{local:Text ToolsTestTooltip}" AutomationProperties.Name="{local:Text ToolsTestTooltip}">
                                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Tools.PlayArrow}" />
                                            </Button>
                                            <Button x:Name="RestartButton" DockPanel.Dock="Left" Style="{StaticResource Form.IconButton}" Command="{Binding RestartCommand}" Margin="0,0,4,0"
                                                    ToolTip="{local:Text ToolsRestartTooltip}" AutomationProperties.Name="{local:Text ToolsRestartTooltip}">
                                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Tools.RestartAlt}" />
                                            </Button>
                                            <Button x:Name="EditButton" DockPanel.Dock="Left" Style="{StaticResource Form.IconButton}" Command="{Binding EditCommand}"
                                                    ToolTip="{local:Text ToolsEditTooltip}" AutomationProperties.Name="{local:Text ToolsEditTooltip}">
                                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Tools.EditOutlined}" />
                                            </Button>
                                            <Button x:Name="RemoveButton" DockPanel.Dock="Right" Style="{StaticResource Form.IconButton}" Command="{Binding RemoveCommand}"
                                                    ToolTip="{local:Text ToolsRemoveTooltip}" AutomationProperties.Name="{Binding RemoveName}">
                                                <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.DeleteOutline}" Fill="{DynamicResource Fadenstack.Danger}" />
                                            </Button>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                                    <StackPanel Margin="12,0,12,12">
                                        <!-- Facts. -->
                                        <ItemsControl ItemsSource="{Binding Facts}" Focusable="False" Margin="{StaticResource Fadenstack.Space.Block}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,0,0,6">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="100" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Label}" Margin="0,0,8,0" />
                                                        <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="12" TextWrapping="Wrap">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Form.Caption}">
                                                                    <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMono}" Value="True">
                                                                            <Setter Property="FontFamily" Value="{DynamicResource Fadenstack.CodeFont}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                        <!-- Trusted: only a trusted server's "reads only" hints count. -->
                                        <DockPanel Margin="{StaticResource Fadenstack.Space.Block}" LastChildFill="True">
                                            <ToggleButton x:Name="TrustedSwitch" DockPanel.Dock="Right" Style="{StaticResource Tools.Switch}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                          IsChecked="{Binding IsTrusted}" IsEnabled="{Binding CanChangeMarks}" AutomationProperties.Name="{Binding TrustedName}" />
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsTrusted}" />
                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding TrustedNote}" />
                                            </StackPanel>
                                        </DockPanel>

                                        <!-- The server's tools are its own words. -->
                                        <Border Style="{StaticResource Tools.Note}" Margin="{StaticResource Fadenstack.Space.Block}">
                                            <DockPanel>
                                                <Path DockPanel.Dock="Left" Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.InfoOutlined}" VerticalAlignment="Top" Margin="0,1,8,0"
                                                      Fill="{DynamicResource Fadenstack.ForegroundMuted}" />
                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsDrawerNote}" />
                                            </DockPanel>
                                        </Border>

                                        <TextBlock x:Name="DrawerTestResult" Text="{Binding TestText}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}"
                                                   Visibility="{Binding HasTest, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />

                                        <!-- Advanced: plain http on the local network, only where it applies and is permitted here. -->
                                        <StackPanel x:Name="AdvancedSection" Margin="{StaticResource Fadenstack.Space.Block}"
                                                    Visibility="{Binding ShowsAdvanced, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text ToolsAdvanced}" Margin="{StaticResource Fadenstack.Space.Item}" />
                                            <DockPanel Margin="{StaticResource Fadenstack.Space.Item}" LastChildFill="True">
                                                <ToggleButton x:Name="PlainHttpSwitch" DockPanel.Dock="Right" Style="{StaticResource Tools.Switch}" VerticalAlignment="Top" Margin="12,0,0,0"
                                                              IsChecked="{Binding PlainHttpOn, Mode=TwoWay}" AutomationProperties.Name="{local:Text McpPlainHttpSwitch}" />
                                                <StackPanel>
                                                    <TextBlock Text="{local:Text McpPlainHttpSwitch}" TextWrapping="Wrap" />
                                                    <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text McpPlainHttpSwitchHelp}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <!-- The warning: nothing changes until the person confirms; Confirm has the focus when it opens, Esc says no. -->
                                            <Border x:Name="PlainHttpWarning" Style="{StaticResource Form.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Item}"
                                                    b:WizardFocus.Step="{Binding IsPlainHttpWarningOpen}" AutomationProperties.Name="{local:Text McpPlainHttpWarningTitle}"
                                                    Visibility="{Binding IsPlainHttpWarningOpen, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                <DockPanel>
                                                    <Path DockPanel.Dock="Left" Style="{StaticResource Tools.Icon.Large}" Data="{StaticResource Icon.WarningAmber}" VerticalAlignment="Top" Margin="0,0,12,0" />
                                                    <StackPanel>
                                                        <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text McpPlainHttpWarningTitle}" Margin="{StaticResource Fadenstack.Space.Tight}"
                                                                   AutomationProperties.LiveSetting="Assertive" />
                                                        <TextBlock Text="{Binding PlainHttpWarningText}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Item}" />
                                                        <WrapPanel Margin="{StaticResource Fadenstack.Space.WrapEnd}">
                                                            <Button x:Name="PlainHttpConfirmButton" Style="{StaticResource Form.Primary}" b:WizardFocus.IsFirst="True" Command="{Binding ConfirmPlainHttpCommand}"
                                                                    Margin="{StaticResource Fadenstack.Space.BesideItem}" Content="{local:Text McpPlainHttpConfirm}"
                                                                    AutomationProperties.Name="{local:Text McpPlainHttpConfirm}" />
                                                            <Button x:Name="PlainHttpCancelButton" Style="{StaticResource Form.Secondary}" Command="{Binding CancelPlainHttpCommand}"
                                                                    Margin="{StaticResource Fadenstack.Space.BesideItem}" Content="{local:Text McpPlainHttpCancel}"
                                                                    AutomationProperties.Name="{local:Text McpPlainHttpCancel}" />
                                                        </WrapPanel>
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <TextBlock x:Name="PlainHttpError" Style="{StaticResource Tools.Error}" Text="{Binding PlainHttpError}"
                                                       Visibility="{Binding HasPlainHttpError, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.LiveSetting="Assertive" />
                                        </StackPanel>

                                        <!-- Tools with a filter. -->
                                        <DockPanel Margin="{StaticResource Fadenstack.Space.Item}" LastChildFill="True">
                                            <Grid DockPanel.Dock="Right" Width="150" Margin="8,0,0,0">
                                                <TextBox x:Name="ToolFilterBox" Text="{Binding ToolFilter, UpdateSourceTrigger=PropertyChanged}" Padding="30,6,8,6"
                                                         AutomationProperties.Name="{local:Text ToolsDrawerFilterName}" />
                                                <Path Style="{StaticResource Tools.Icon.Small}" Data="{StaticResource Icon.Search}" HorizontalAlignment="Left" Margin="9,0,0,0"
                                                      Fill="{DynamicResource Fadenstack.ForegroundMuted}" />
                                            </Grid>
                                            <TextBlock Style="{StaticResource Form.Strong}" Text="{Binding ToolsTitle}" VerticalAlignment="Center" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding NoToolsText}" Margin="{StaticResource Fadenstack.Space.Item}"
                                                   Visibility="{Binding HasNoToolsText, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                        <Border x:Name="ToolList" Style="{StaticResource Tools.ListCard}" Visibility="{Binding HasNoToolsText, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}">
                                            <ItemsControl ItemsSource="{Binding Tools}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource Tools.Rule}" Padding="12,8">
                                                            <StackPanel>
                                                                <TextBlock Style="{StaticResource Tools.Mono}" Text="{Binding Name}" />
                                                                <ItemsControl ItemsSource="{Binding Hints}" Focusable="False" Margin="0,4,0,0"
                                                                              Visibility="{Binding HasHints, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                                    <ItemsControl.ItemsPanel>
                                                                        <ItemsPanelTemplate>
                                                                            <WrapPanel />
                                                                        </ItemsPanelTemplate>
                                                                    </ItemsControl.ItemsPanel>
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate>
                                                                            <Border Style="{StaticResource Tools.Says}">
                                                                                <TextBlock Style="{StaticResource Tools.Micro}" Text="{Binding}" />
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>
                                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding Description}" Margin="0,2,0,0"
                                                                           Visibility="{Binding HasDescription, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                                <!-- The class it has now; a picker to raise it, none for a destructive tool (a floor nothing lowers). -->
                                                                <WrapPanel Margin="0,6,0,0">
                                                                    <Border Style="{StaticResource Tools.Badge}" Margin="0,0,8,4">
                                                                        <TextBlock Style="{StaticResource Tools.MicroText}" Text="{Binding ClassText}" />
                                                                    </Border>
                                                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4" Visibility="{Binding CanRaise, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                                                        <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text ToolsRaiseLabel}" VerticalAlignment="Center" Margin="0,0,8,0" />
                                                                        <ComboBox MinWidth="150" ItemsSource="{Binding RaiseOptions}" SelectedItem="{Binding SelectedRaise}" DisplayMemberPath="Text"
                                                                                  AutomationProperties.Name="{Binding RaiseName}" />
                                                                    </StackPanel>
                                                                </WrapPanel>
                                                                <TextBlock Style="{StaticResource Form.Caption}" Text="{Binding DestructiveHelp}"
                                                                           Visibility="{Binding IsDestructive, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ContentControl.ContentTemplate>
            </ContentControl>
        </Grid>

        <!-- ===== A modal sheet (add or edit, import, scan) over its own scrim ===== -->
        <Grid x:Name="SheetLayer" Visibility="{Binding HasSheet, Converter={StaticResource Fadenstack.BoolToVisibility}}">
            <Button x:Name="SheetScrim" Style="{StaticResource Tools.Scrim}" Command="{Binding CloseSheetCommand}" AutomationProperties.Name="{local:Text ToolsCloseSheet}" />
            <ContentControl Content="{Binding Sheet}" HorizontalAlignment="Stretch" VerticalAlignment="Center" Margin="12" Focusable="False" />
        </Grid>
    </Grid>
</UserControl>
