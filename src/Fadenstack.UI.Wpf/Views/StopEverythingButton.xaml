<UserControl x:Class="Fadenstack.UI.Wpf.Views.StopEverythingButton"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:st="clr-namespace:Fadenstack.UI.Settings;assembly=Fadenstack.UI"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=st:StopEverythingViewModel}"
             d:DesignWidth="260" d:DesignHeight="36"
             Foreground="{DynamicResource Fadenstack.Foreground}" FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13"
             UseLayoutRounding="True" TextOptions.TextFormattingMode="Display" Focusable="False">
    <!--
        "Stop everything", the emergency stop for an app's tray menu or title bar: a StopEverythingViewModel. An icon button with its name and
        tooltip, and the line that says what it did. No confirmation. Every text is the view model's; the view holds no logic.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Chat.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal">
        <Button x:Name="StopButton" Style="{StaticResource Fadenstack.SecondaryButton}" Padding="8,5" Command="{Binding StopCommand}"
                ToolTip="{Binding ToolTip}" AutomationProperties.Name="{Binding Name}" AutomationProperties.HelpText="{Binding ToolTip}">
            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="13" Text="&#xE71A;" Foreground="{DynamicResource Fadenstack.Danger}" />
        </Button>
        <TextBlock x:Name="ResultLabel" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" MaxWidth="320"
                   Text="{Binding ResultText}" AutomationProperties.LiveSetting="Polite"
                   Visibility="{Binding HasResult, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
    </StackPanel>
</UserControl>
