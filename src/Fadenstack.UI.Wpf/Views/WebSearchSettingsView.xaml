<UserControl x:Class="Fadenstack.UI.Wpf.Views.WebSearchSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:t="clr-namespace:Fadenstack.UI.Tools;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=t:WebSearchSettingsViewModel}"
             d:DesignWidth="420" d:DesignHeight="520"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" Focusable="True">
    <!--
        The web search settings (sdk/51 F06) as a view of its own, for an app with a Tools page of its own (the desktop): the same
        sheet as the Tools view's, from one template (Themes/WebSearch.xaml), for a WebSearchSettingsViewModel (set it as the DataContext).
        The host listens to the view model's Closed (Save and Cancel) to leave the page. The texts are UiStrings from the view model's
        Strings. It works on .NET Framework 4.7.2 and on .NET 8.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/WebSearch.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border x:Name="WebSearchRoot" Style="{StaticResource Tools.Sheet}" Margin="{StaticResource Fadenstack.Space.Page}" HorizontalAlignment="Stretch" VerticalAlignment="Top"
            AutomationProperties.Name="{Binding Title}">
        <ContentControl ContentTemplate="{StaticResource WebSearch.Body}" Content="{Binding}" Focusable="False" />
    </Border>
</UserControl>
