<UserControl x:Class="Fadenstack.UI.Wpf.Views.WizardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Fadenstack.UI.Wizard;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:ConnectionWizardViewModel}"
             d:DesignWidth="380" d:DesignHeight="640"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" Focusable="True"
             b:WizardFocus.Step="{Binding Step}">
    <!--
        The connection wizard (sdk/51 F15, I15): one view for a ConnectionWizardViewModel, one panel for each group of its
        steps. The panels show and hide with the view model's Step; the buttons run its commands; the texts are the view
        model's (UiStrings, five languages). It is a narrow column that stays centred whatever the width (an Office task
        pane, the desktop's window). A password or a key never goes through a binding: the button that sends it names its
        box (b:WizardSecret) and the box is empty right after. It works on .NET Framework 4.7.2 and on .NET 8.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The forms' styles (Controls.xaml) under the wizard's names; a button that disappears while its command cannot run. -->
            <Style x:Key="Wizard.Primary" TargetType="Button" BasedOn="{StaticResource Form.Primary}" />
            <Style x:Key="Wizard.PrimaryHide" TargetType="Button" BasedOn="{StaticResource Form.PrimaryHide}" />
            <Style x:Key="Wizard.SecondaryHide" TargetType="Button" BasedOn="{StaticResource Form.SecondaryHide}" />
            <Style x:Key="Wizard.Choice" TargetType="Button" BasedOn="{StaticResource Form.Choice}" />
            <Style x:Key="Wizard.Quiet" TargetType="Button" BasedOn="{StaticResource Form.Quiet}" />
            <Style x:Key="Wizard.QuietHide" TargetType="Button" BasedOn="{StaticResource Form.QuietHide}" />

            <!-- Text -->
            <Style x:Key="Wizard.Title" TargetType="TextBlock" BasedOn="{StaticResource Form.Title}" />
            <Style x:Key="Wizard.Strong" TargetType="TextBlock" BasedOn="{StaticResource Form.Strong}" />
            <Style x:Key="Wizard.Caption" TargetType="TextBlock" BasedOn="{StaticResource Form.Caption}" />
            <!-- The pairing code: large, in a read-only field with the card's own colour. -->
            <Style x:Key="Wizard.Code" TargetType="TextBox" BasedOn="{StaticResource Form.TextBox}">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FontFamily" Value="{DynamicResource Fadenstack.CodeFont}" />
                <Setter Property="FontSize" Value="28" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="Padding" Value="12,4" />
            </Style>

            <!-- The banner: a rounded container with a status bar at its start; the card. -->
            <Style x:Key="Wizard.Banner" TargetType="Border" BasedOn="{StaticResource Form.Banner}" />
            <Style x:Key="Wizard.Banner.Error" TargetType="Border" BasedOn="{StaticResource Form.Banner.Error}" />
            <Style x:Key="Wizard.Banner.Warning" TargetType="Border" BasedOn="{StaticResource Form.Banner.Warning}" />
            <Style x:Key="Wizard.Banner.Success" TargetType="Border" BasedOn="{StaticResource Form.Banner.Success}" />
            <Style x:Key="Wizard.Card" TargetType="Border" BasedOn="{StaticResource Form.Card}" />
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Column" MaxWidth="480" HorizontalAlignment="Stretch" Margin="{StaticResource Fadenstack.Space.Page}">

            <!-- The app could not keep what the wizard handed it (any step that saves). -->
            <Border Style="{StaticResource Wizard.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}" Visibility="{Binding StoreFailed, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Text="{local:Text WizardStoreFailed}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </DockPanel>
            </Border>

            <!-- ===== The app's own steps and every step that is running: progress, its line, Cancel ================ -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='BeforeChoice,AppPrecondition,Checking,ServerAccepted,PairStarting,Approved,Redeeming,OwnSearching,BeforeCheck,OwnChecking,OwnDone,AfterConnect'}">
                <ContentControl Content="{Binding AppStep}" Margin="{StaticResource Fadenstack.Space.Block}" IsTabStop="False"
                                Visibility="{Binding AppStep, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                <StackPanel Visibility="{Binding AppStep, Converter={StaticResource Fadenstack.EmptyToCollapsed}, ConverterParameter=invert}">
                    <ProgressBar IsIndeterminate="True" Margin="{StaticResource Fadenstack.Space.Block}"
                                 Visibility="{Binding IsBusy, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                 AutomationProperties.Name="{local:Text WizardChecking}" />
                    <StackPanel Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.LiveSetting="Polite">
                        <TextBlock TextWrapping="Wrap" Text="{local:Text WizardChecking}"
                                   Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='AppPrecondition,Checking,ServerAccepted'}" />
                        <TextBlock TextWrapping="Wrap" Text="{local:Text WizardStarting}"
                                   Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='PairStarting'}" />
                        <TextBlock TextWrapping="Wrap" Text="{local:Text WizardRedeeming}"
                                   Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Approved,Redeeming,AfterConnect'}" />
                        <TextBlock TextWrapping="Wrap" Text="{local:Text WizardOwnSearching}"
                                   Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnSearching'}" />
                        <TextBlock TextWrapping="Wrap" Text="{local:Text WizardOwnChecking}"
                                   Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='BeforeCheck,OwnChecking'}" />
                        <TextBlock TextWrapping="Wrap" Text="{local:Text WizardOwnDone}"
                                   Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnDone'}" />
                    </StackPanel>
                </StackPanel>
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding CancelCommand}" Content="{local:Text WizardCancel}"
                        AutomationProperties.Name="{local:Text WizardCancel}" />
            </StackPanel>

            <!-- ===== Choose ====================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Choose'}">
                <TextBlock x:Name="ChooseTitle" Style="{StaticResource Wizard.Title}" />
                <Button Style="{StaticResource Wizard.Choice}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ChooseServerCommand}"
                        Visibility="{Binding CanChooseServer, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                        AutomationProperties.Name="{local:Text WizardChooseServer}" AutomationProperties.HelpText="{local:Text WizardChooseServerHelp}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardChooseServer}" />
                        <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardChooseServerHelp}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Wizard.Choice}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ChooseOwnAiCommand}"
                        Visibility="{Binding CanChooseOwnAi, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                        AutomationProperties.Name="{local:Text WizardChooseOwnAi}" AutomationProperties.HelpText="{local:Text WizardChooseOwnAiHelp}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardChooseOwnAi}" />
                        <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardChooseOwnAiHelp}" />
                    </StackPanel>
                </Button>
                <Button Style="{StaticResource Wizard.Choice}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ChooseDemoCommand}"
                        Visibility="{Binding CanChooseDemo, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                        AutomationProperties.Name="{local:Text WizardChooseDemo}">
                    <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardChooseDemo}" />
                </Button>
                <Border Style="{StaticResource Wizard.Banner.Warning}">
                    <Border.Visibility>
                        <MultiBinding Converter="{x:Static b:WizardNone.Instance}">
                            <Binding Path="CanChooseServer" />
                            <Binding Path="CanChooseOwnAi" />
                            <Binding Path="CanChooseDemo" />
                        </MultiBinding>
                    </Border.Visibility>
                    <DockPanel>
                        <TextBlock Text="{local:Text WizardNothingAllowed}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- ===== ServerAddress =============================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='ServerAddress'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardServerTitle}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardServerLabel}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <TextBox x:Name="ServerBox" Style="{StaticResource Form.TextBox}" Margin="{StaticResource Fadenstack.Space.Item}"
                         Text="{Binding ServerAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsReadOnly="{Binding ServerLocked, Mode=OneWay}"
                         AutomationProperties.Name="{local:Text WizardServerLabel}" />
                <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardServerLocked}" Margin="{StaticResource Fadenstack.Space.Tight}"
                           Visibility="{Binding ServerLocked, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardServerHelp}" Margin="{StaticResource Fadenstack.Space.Block}" />
                <Border Style="{StaticResource Wizard.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding AddressErrorText, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                    <DockPanel>
                        <TextBlock Text="{Binding AddressErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Wizard.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding AppStepRefused, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="{local:Text WizardAppStepRefused}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding SubmitServerCommand}"
                        Content="{local:Text WizardContinue}" AutomationProperties.Name="{local:Text WizardContinue}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== A step that went wrong: the banner, then what can be done ========================================= -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Unreachable,CertificateNotTrusted,NotFadenstack,StartFailed,ServerTooOld,Denied,Expired,PairFailed,NoAccess,PasswordError,OwnFailed'}">
                <Border Style="{StaticResource Wizard.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}">
                    <DockPanel>
                        <StackPanel AutomationProperties.LiveSetting="Assertive">
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardUnreachable}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Unreachable'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardCertificateNotTrusted}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='CertificateNotTrusted'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardNotFadenstack}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='NotFadenstack'}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding StartFailureText}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='StartFailed'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardTooOld}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='ServerTooOld'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardTooOldPassword}" Margin="{StaticResource Fadenstack.Space.Bar}">
                                <TextBlock.Visibility>
                                    <MultiBinding Converter="{x:Static b:WizardAll.Instance}">
                                        <Binding Path="PasswordFallback" />
                                        <Binding Path="Step" Converter="{x:Static b:WizardIn.Is}" ConverterParameter="ServerTooOld" />
                                    </MultiBinding>
                                </TextBlock.Visibility>
                            </TextBlock>
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardDenied}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Denied'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardExpired}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Expired'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardPairFailed}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='PairFailed'}" />
                            <TextBlock TextWrapping="Wrap" Text="{local:Text WizardNoAccess}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='NoAccess'}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding PasswordFailureText}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='PasswordError'}" />
                            <TextBlock TextWrapping="Wrap" Text="{Binding ProblemText}"
                                       Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnFailed'}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource Wizard.PrimaryHide}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding RetryCommand}"
                        Content="{local:Text WizardTryAgain}" AutomationProperties.Name="{local:Text WizardTryAgain}" />
                <Button Style="{StaticResource Wizard.PrimaryHide}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding NewCodeCommand}"
                        Content="{local:Text WizardNewCode}" AutomationProperties.Name="{local:Text WizardNewCode}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding EnterKeyCommand}"
                        Content="{local:Text WizardEnterKey}" AutomationProperties.Name="{local:Text WizardEnterKey}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ShowHelpCommand}"
                        Content="{local:Text WizardShowHelp}" AutomationProperties.Name="{local:Text WizardShowHelp}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding UsePasswordCommand}"
                        Content="{local:Text WizardUsePassword}" AutomationProperties.Name="{local:Text WizardUsePassword}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding BackToCodeCommand}"
                        Content="{local:Text WizardBackToCode}" AutomationProperties.Name="{local:Text WizardBackToCode}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ChangeServerCommand}"
                        Content="{local:Text WizardChangeServer}" AutomationProperties.Name="{local:Text WizardChangeServer}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
                <Button Style="{StaticResource Wizard.Quiet}" Command="{Binding CloseCommand}" Content="{local:Text WizardClose}"
                        AutomationProperties.Name="{local:Text WizardClose}" />
            </StackPanel>

            <!-- ===== PairCode ==================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='PairCode'}">
                <Border Style="{StaticResource Wizard.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding SignInEnded, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="{local:Text WizardSignInEnded}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
                <TextBlock x:Name="CodeTitle" Style="{StaticResource Wizard.Title}" />
                <TextBlock Text="{local:Text WizardCodeIntro}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}" />
                <Border Style="{StaticResource Wizard.Card}" Margin="{StaticResource Fadenstack.Space.Block}">
                    <StackPanel HorizontalAlignment="Center">
                        <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardCodeName}" HorizontalAlignment="Center" />
                        <TextBox x:Name="CodeText" Style="{StaticResource Wizard.Code}" Text="{Binding UserCode, Mode=OneWay}"
                                 AutomationProperties.Name="{local:Text WizardCodeName}" />
                    </StackPanel>
                </Border>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding OpenPairingPageCommand}"
                        Content="{local:Text WizardOpenPage}" AutomationProperties.Name="{local:Text WizardOpenPage}" />
                <Button Style="{StaticResource Form.Secondary}" Margin="{StaticResource Fadenstack.Space.Block}" Command="{Binding CopyCodeCommand}"
                        Content="{local:Text WizardCopyCode}" AutomationProperties.Name="{local:Text WizardCopyCode}" />
                <TextBlock Style="{StaticResource Wizard.Caption}" Text="{Binding WaitingText}" Margin="{StaticResource Fadenstack.Space.Block}" />
                <TextBlock x:Name="ServerAtText" Style="{StaticResource Wizard.Caption}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <Button Style="{StaticResource Wizard.QuietHide}" HorizontalAlignment="Left" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ChangeServerCommand}"
                        Content="{local:Text WizardChangeServer}" AutomationProperties.Name="{local:Text WizardChangeServer}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding UsePasswordCommand}" Content="{local:Text WizardUsePassword}"
                        AutomationProperties.Name="{local:Text WizardUsePassword}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding CancelCommand}" Content="{local:Text WizardCancel}"
                        AutomationProperties.Name="{local:Text WizardCancel}" />
            </StackPanel>

            <!-- ===== Password ==================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Password'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardSignIn}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardEmail}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <TextBox x:Name="EmailBox" Style="{StaticResource Form.TextBox}" Margin="{StaticResource Fadenstack.Space.Item}"
                         Text="{Binding Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding IsBusy, Converter={StaticResource Fadenstack.InverseBool}}" AutomationProperties.Name="{local:Text WizardEmail}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardPassword}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <!-- The password is never bound: the Sign in button reads it when it is pressed and empties the box. -->
                <PasswordBox x:Name="PasswordBox" Style="{StaticResource Form.PasswordBox}" Margin="{StaticResource Fadenstack.Space.Block}"
                             IsEnabled="{Binding IsBusy, Converter={StaticResource Fadenstack.InverseBool}}" AutomationProperties.Name="{local:Text WizardPassword}" />
                <ProgressBar IsIndeterminate="True" Margin="{StaticResource Fadenstack.Space.Block}"
                             Visibility="{Binding IsBusy, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                             AutomationProperties.Name="{local:Text WizardRedeeming}" />
                <Button x:Name="SignInButton" Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}"
                        Content="{local:Text WizardSignIn}" AutomationProperties.Name="{local:Text WizardSignIn}"
                        b:WizardSecret.Box="{Binding ElementName=PasswordBox}" b:WizardSecret.EnterFrom="{Binding ElementName=EmailBox}"
                        b:WizardSecret.Command="{Binding SignInWithPasswordCommand}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackToCodeCommand}" Content="{local:Text WizardBackToCode}"
                        AutomationProperties.Name="{local:Text WizardBackToCode}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding CancelCommand}" Content="{local:Text WizardCancel}"
                        AutomationProperties.Name="{local:Text WizardCancel}" />
            </StackPanel>

            <!-- ===== SignedIn ==================================================================================== -->
            <Border Style="{StaticResource Wizard.Banner.Success}"
                    Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='SignedIn'}">
                <DockPanel>
                    <TextBlock Text="{Binding SignedInText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </DockPanel>
            </Border>

            <!-- ===== OwnAccept =================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnAccept'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardOwnTitle}" />
                <TextBlock Text="{local:Text WizardOwnDataFlow}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Item}" />
                <TextBlock Text="{local:Text WizardOwnProviderTerms}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}" />
                <Border Style="{StaticResource Wizard.Card}" Margin="{StaticResource Fadenstack.Space.Item}">
                    <!-- Readable, and scrolls with the keyboard once it has the focus. -->
                    <ScrollViewer x:Name="NoticeScroller" MaxHeight="240" Focusable="True" IsTabStop="True" b:WizardFocus.IsFirst="True"
                                  HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{local:Text WizardOwnTitle}">
                        <StackPanel>
                            <TextBlock Text="{local:Text WizardOwnNotice}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Item}" />
                            <TextBlock Text="{local:Text WizardOwnLiability}" TextWrapping="Wrap" />
                            <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardOwnBindingVersion}" Margin="{StaticResource Fadenstack.Space.Bar}"
                                       Visibility="{Binding Strings.Language, Converter={x:Static b:WizardIn.ShownUnless}, ConverterParameter='de'}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
                <Button x:Name="FullTermsButton" Style="{StaticResource Wizard.Quiet}" HorizontalAlignment="Left" Margin="{StaticResource Fadenstack.Space.Item}"
                        Content="{local:Text WizardOwnFullTerms}" AutomationProperties.Name="{local:Text WizardOwnFullTerms}" />
                <CheckBox IsChecked="{Binding Accepted, Mode=TwoWay}" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.Name="{local:Text WizardOwnConsent}">
                    <TextBlock Text="{local:Text WizardOwnConsent}" TextWrapping="Wrap" />
                </CheckBox>
                <CheckBox IsChecked="{Binding SearchConsent, Mode=TwoWay}" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.Name="{local:Text WizardOwnSearchConsent}"
                          Visibility="{Binding CanSearchThisComputer, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <TextBlock Text="{local:Text WizardOwnSearchConsent}" TextWrapping="Wrap" />
                </CheckBox>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding AcceptCommand}"
                        Content="{local:Text WizardOwnAccept}" AutomationProperties.Name="{local:Text WizardOwnAccept}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ServerModeInsteadCommand}"
                        Content="{local:Text WizardOwnServerInstead}" AutomationProperties.Name="{local:Text WizardOwnServerInstead}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== OwnPick ===================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnPick'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardOwnPickTitle}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardOwnFound}" Margin="{StaticResource Fadenstack.Space.Tight}"
                           Visibility="{Binding Found.Count, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding Found}" Margin="{StaticResource Fadenstack.Space.Item}" Focusable="False"
                              Visibility="{Binding Found.Count, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Wizard.Choice}" Margin="{StaticResource Fadenstack.Space.Item}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectFoundCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WizardView}}}"
                                    AutomationProperties.Name="{Binding Preset.Name}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource Wizard.Strong}" Text="{Binding Preset.Name}" />
                                    <TextBlock Style="{StaticResource Wizard.Caption}" Text="{Binding BaseUrl}" />
                                </StackPanel>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardOwnNothingFound}" Margin="{StaticResource Fadenstack.Space.Block}"
                           Visibility="{Binding Found.Count, Converter={StaticResource Fadenstack.EmptyToCollapsed}, ConverterParameter=invert}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardOwnPresets}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <ItemsControl ItemsSource="{Binding Presets}" Margin="{StaticResource Fadenstack.Space.WrapBlock}" Focusable="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Form.Chip}" Margin="{StaticResource Fadenstack.Space.BesideItem}" CommandParameter="{Binding}"
                                    Command="{Binding DataContext.SelectPresetCommand, RelativeSource={RelativeSource AncestorType={x:Type local:WizardView}}}"
                                    AutomationProperties.Name="{Binding Name}" Content="{Binding Name}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardOwnAddress}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <TextBox x:Name="EndpointBox" Style="{StaticResource Form.TextBox}" b:WizardFocus.IsFirst="True" Margin="{StaticResource Fadenstack.Space.Item}"
                         Text="{Binding EndpointAddressText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.Name="{local:Text WizardOwnAddress}" />
                <CheckBox IsChecked="{Binding NeedsKey, Mode=TwoWay}" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.Name="{local:Text WizardOwnNeedsKey}">
                    <TextBlock Text="{local:Text WizardOwnNeedsKey}" TextWrapping="Wrap" />
                </CheckBox>
                <Border Style="{StaticResource Wizard.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding AddressErrorText, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                    <DockPanel>
                        <TextBlock Text="{Binding AddressErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
                <Border Style="{StaticResource Wizard.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding AppStepRefused, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <DockPanel>
                        <TextBlock Text="{local:Text WizardAppStepRefused}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding UseEndpointCommand}"
                        Content="{local:Text WizardOwnUse}" AutomationProperties.Name="{local:Text WizardOwnUse}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== OwnPlainHttp ================================================================================ -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnPlainHttp'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardPlainHttpTitle}" />
                <Border Style="{StaticResource Wizard.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Block}">
                    <DockPanel>
                        <TextBlock Text="{local:Text WizardPlainHttpWarning}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ConfirmPlainHttpCommand}"
                        Content="{local:Text WizardPlainHttpConfirm}" AutomationProperties.Name="{local:Text WizardPlainHttpConfirm}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== OwnKey ====================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnKey'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardKeyTitle}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardKeyLabel}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <!-- The key is never bound: the Continue button reads it when it is pressed and empties the box. -->
                <PasswordBox x:Name="KeyBox" Style="{StaticResource Form.PasswordBox}" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.Name="{local:Text WizardKeyLabel}" />
                <TextBlock Style="{StaticResource Wizard.Caption}" Text="{local:Text WizardKeyHelp}" Margin="{StaticResource Fadenstack.Space.Block}" />
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Content="{local:Text WizardContinue}"
                        AutomationProperties.Name="{local:Text WizardContinue}"
                        b:WizardSecret.Box="{Binding ElementName=KeyBox}" b:WizardSecret.Command="{Binding SubmitKeyCommand}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== OwnHelp ===================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnHelp'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardOwnHelpTitle}" />
                <TextBlock Text="{local:Text WizardOwnHelp}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}" />
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding RetryCommand}"
                        Content="{local:Text WizardTryAgain}" AutomationProperties.Name="{local:Text WizardTryAgain}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== OwnResult =================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnResult'}">
                <Border Style="{StaticResource Wizard.Banner.Success}" Margin="{StaticResource Fadenstack.Space.Block}">
                    <DockPanel>
                        <ItemsControl ItemsSource="{Binding ResultLines}" Focusable="False" AutomationProperties.LiveSetting="Polite">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Tight}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                </Border>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ContinueCommand}"
                        Content="{local:Text WizardContinue}" AutomationProperties.Name="{local:Text WizardContinue}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== OwnModel ==================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='OwnModel'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardModelTitle}" />
                <TextBlock Style="{StaticResource Wizard.Strong}" Text="{local:Text WizardModelLabel}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                <ComboBox ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel, Mode=TwoWay}" Margin="{StaticResource Fadenstack.Space.Block}"
                          AutomationProperties.Name="{local:Text WizardModelLabel}" />
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ContinueCommand}"
                        Content="{local:Text WizardContinue}" AutomationProperties.Name="{local:Text WizardContinue}" />
                <Button Style="{StaticResource Wizard.QuietHide}" Command="{Binding BackCommand}" Content="{local:Text WizardBack}"
                        AutomationProperties.Name="{local:Text WizardBack}" />
            </StackPanel>

            <!-- ===== Settings ==================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Settings'}">
                <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardSettingsTitle}" />
                <TextBlock Text="{Binding ConnectedText}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}"
                           Visibility="{Binding ConnectedText, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ConnectOrganisationCommand}"
                        Content="{local:Text WizardConnectOrganisation}" AutomationProperties.Name="{local:Text WizardConnectOrganisation}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ChangeEndpointCommand}"
                        Content="{local:Text WizardChangeEndpoint}" AutomationProperties.Name="{local:Text WizardChangeEndpoint}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding SignOutCommand}"
                        Content="{local:Text WizardSignOut}" AutomationProperties.Name="{local:Text WizardSignOut}"
                        Visibility="{Binding Current.Mode, Converter={x:Static b:WizardIn.ShownUnless}, ConverterParameter='Endpoint'}" />
                <Button Style="{StaticResource Wizard.SecondaryHide}" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding SignOutCommand}"
                        Content="{local:Text WizardRemoveEndpoint}" AutomationProperties.Name="{local:Text WizardRemoveEndpoint}"
                        Visibility="{Binding Current.Mode, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Endpoint'}" />
                <Button Style="{StaticResource Wizard.Quiet}" Command="{Binding CloseCommand}" Content="{local:Text WizardClose}"
                        AutomationProperties.Name="{local:Text WizardClose}" />
            </StackPanel>

            <!-- ===== SignOut ===================================================================================== -->
            <StackPanel Visibility="{Binding Step, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='SignOut'}">
                <StackPanel Visibility="{Binding Current.Mode, Converter={x:Static b:WizardIn.ShownUnless}, ConverterParameter='Endpoint'}">
                    <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardSignOutTitle}" />
                    <TextBlock Text="{local:Text WizardSignOutBody}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}" />
                </StackPanel>
                <StackPanel Visibility="{Binding Current.Mode, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Endpoint'}">
                    <TextBlock Style="{StaticResource Wizard.Title}" Text="{local:Text WizardRemoveTitle}" />
                    <TextBlock Text="{local:Text WizardRemoveBody}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}" />
                </StackPanel>
                <CheckBox IsChecked="{Binding DeleteLocalChats, Mode=TwoWay}" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.Name="{local:Text WizardDeleteChats}">
                    <TextBlock Text="{local:Text WizardDeleteChats}" TextWrapping="Wrap" />
                </CheckBox>
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ConfirmSignOutCommand}"
                        Content="{local:Text WizardSignOut}" AutomationProperties.Name="{local:Text WizardSignOut}"
                        Visibility="{Binding Current.Mode, Converter={x:Static b:WizardIn.ShownUnless}, ConverterParameter='Endpoint'}" />
                <Button Style="{StaticResource Wizard.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Item}" Command="{Binding ConfirmSignOutCommand}"
                        Content="{local:Text WizardRemoveEndpoint}" AutomationProperties.Name="{local:Text WizardRemoveEndpoint}"
                        Visibility="{Binding Current.Mode, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Endpoint'}" />
                <Button Style="{StaticResource Wizard.Quiet}" Command="{Binding CancelCommand}" Content="{local:Text WizardCancel}"
                        AutomationProperties.Name="{local:Text WizardCancel}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
