<UserControl x:Class="Fadenstack.UI.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Fadenstack.UI.ViewModels;assembly=Fadenstack.UI"
             xmlns:m="clr-namespace:Fadenstack.Models;assembly=Fadenstack.Client"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AgentChatViewModel}"
             d:DesignWidth="480" d:DesignHeight="720"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!--
        The chat panel: header (agent, tool mode, history, new chat), the conversation (virtualized turns),
        the composer. Binds to an AgentChatViewModel; it has no logic of its own.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Chat.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewChatCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="Header" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="ModeButton" Style="{StaticResource Fadenstack.GhostButton}" ToolTip="{Binding ToolModeHint}"
                                  IsChecked="{Binding IsModeMenuOpen, Mode=TwoWay}" IsEnabled="{Binding IsReady}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=ModeMenu, Converter={StaticResource Fadenstack.InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="12" Text="&#xE90F;" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedToolMode.Label}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="9" Text="&#xE70D;" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <!-- Under the button, its end edge under the button's, kept over the panel (ChatView.xaml.cs places it). -->
                    <Popup x:Name="ModeMenu" IsOpen="{Binding IsModeMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ModeButton}"
                           Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource Fadenstack.Surface}" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Fadenstack.Radius.Container}" Padding="6" Margin="8,4,8,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{local:Text ToolModeMenu}" Margin="8,4,8,4" />
                                <ItemsControl ItemsSource="{Binding ToolModes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Fadenstack.GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                                    Command="{Binding DataContext.SelectToolModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Content="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{Binding ToolModeHint}" TextWrapping="Wrap" MaxWidth="280"
                                           Margin="8,6,8,4" />
                                <Border BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="0,1,0,0" Margin="0,4,0,2" />
                                <Button Style="{StaticResource Fadenstack.GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                        Command="{Binding ResetApprovalsCommand}" Content="{local:Text ResetApprovals}"
                                        ToolTip="{local:Text ResetApprovalsHint}" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton x:Name="HistoryButton" Style="{StaticResource Fadenstack.GhostToggle}" ToolTip="{local:Text History}" Margin="4,0,0,0"
                                  AutomationProperties.Name="{local:Text History}" IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=HistoryMenu, Converter={StaticResource Fadenstack.InverseBool}}">
                        <TextBlock Style="{StaticResource Fadenstack.Icon}" Text="&#xE81C;" />
                    </ToggleButton>
                    <Button Style="{StaticResource Fadenstack.GhostButton}" ToolTip="{local:Text NewChatShortcut}" AutomationProperties.Name="{local:Text NewChat}"
                            Margin="4,0,0,0" Command="{Binding NewChatCommand}">
                        <TextBlock Style="{StaticResource Fadenstack.Icon}" Text="&#xE710;" />
                    </Button>
                    <!--
                        The settings: the language, the host's own items (SettingsContent), and About last. Always shown.
                        The gear looks pressed while its menu is open, and while About, which the menu opened, is.
                    -->
                    <ToggleButton x:Name="SettingsButton" ToolTip="{local:Text Settings}"
                                  AutomationProperties.Name="{local:Text Settings}" Margin="4,0,0,0"
                                  IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=SettingsMenu, Converter={StaticResource Fadenstack.InverseBool}}">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton" BasedOn="{StaticResource Fadenstack.GhostToggle}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboutOpen}" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource Fadenstack.Pressed}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                        <TextBlock Style="{StaticResource Fadenstack.Icon}" Text="&#xE713;" />
                    </ToggleButton>
                    <!-- Under the gear, its end edge under the gear's, kept over the panel (ChatView.xaml.cs places it). -->
                    <Popup x:Name="SettingsMenu" IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=SettingsButton}"
                           Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource Fadenstack.Surface}" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Fadenstack.Radius.Container}" Padding="6" Margin="8,4,8,12" MinWidth="220">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel>
                                <StackPanel Visibility="{Binding HasLanguageSettings, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{local:Text LanguageMenu}" Margin="8,4,8,4" />
                                    <ItemsControl ItemsSource="{Binding LanguageOptions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:LanguageOption}">
                                                <Button Style="{StaticResource Fadenstack.GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                                        Command="{Binding DataContext.SetLanguageCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding Id}" AutomationProperties.Name="{Binding Label}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Grid Width="20">
                                                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="12" Text="&#xE73E;" Foreground="{DynamicResource Fadenstack.Accent}"
                                                                       Visibility="{Binding IsSelected, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                                        </Grid>
                                                        <TextBlock Text="{Binding Label}" Language="{Binding Language, ConverterCulture=en-US}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{local:Text LanguageLocked}" Margin="8,4,8,4"
                                               Visibility="{Binding IsLanguageLocked, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                                </StackPanel>
                                <Border x:Name="SettingsSeparator" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="0,1,0,0" Margin="0,4,0,2" Visibility="Collapsed" />
                                <ContentPresenter x:Name="SettingsHost" />
                                <Border x:Name="AboutSeparator" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="0,1,0,0" Margin="0,4,0,2" Visibility="Collapsed" />
                                <Button Style="{StaticResource Fadenstack.GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                        Command="{Binding OpenAboutCommand}" AutomationProperties.Name="{local:Text About}">
                                    <StackPanel Orientation="Horizontal">
                                        <Grid Width="20">
                                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="12" Text="&#xE946;"
                                                       Foreground="{DynamicResource Fadenstack.ForegroundMuted}" />
                                        </Grid>
                                        <TextBlock Text="{local:Text About}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <local:AgentAvatar Small="True" Width="24" Height="24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Conversation -->
        <Grid Grid.Row="1">
            <!-- Empty chat: the agent's greeting and suggestions -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                <local:AgentAvatar Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding Greeting}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" />
                <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Fadenstack.GhostButton}" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,3"
                                    BorderBrush="{DynamicResource Fadenstack.Border}"
                                    Command="{Binding DataContext.SendSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The turns: virtualized and recycled, scrolled by pixel, kept at the bottom while the user is there -->
            <ItemsControl ItemsSource="{Binding Turns}" Focusable="False"
                          Visibility="{Binding IsEmpty, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Padding="0,0,0,12" b:StickToBottom.IsEnabled="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>

            <Button Style="{StaticResource Fadenstack.GhostButton.HideDisabled}" Command="{Binding LoadEarlierCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Background="{DynamicResource Fadenstack.Surface}"
                    BorderBrush="{DynamicResource Fadenstack.Border}" Padding="12,4">
                <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{local:Text ShowEarlier}" />
            </Button>

            <Border VerticalAlignment="Top" Margin="12" Padding="12,8" CornerRadius="{StaticResource Fadenstack.Radius.Control}" BorderThickness="3,0,0,0"
                    BorderBrush="{DynamicResource Fadenstack.Danger}" Background="{DynamicResource Fadenstack.BlockedBackground}"
                    Visibility="{Binding Error, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Fadenstack.SecondaryButton}" Content="{local:Text Retry}"
                            Command="{Binding InitializeCommand}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!--
            The skills $ lists: above the composer, as wide as it, over the conversation's end. In the tree, not a popup,
            so it moves with the panel and never floats over other windows. The active one is the list's selection.
        -->
        <Border x:Name="SkillPicker" Grid.Row="1" VerticalAlignment="Bottom" Margin="12,0,12,0" Padding="6"
                Background="{DynamicResource Fadenstack.Surface}" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="1"
                CornerRadius="{StaticResource Fadenstack.Radius.Container}"
                Visibility="{Binding SkillPicker.IsOpen, Converter={StaticResource Fadenstack.BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
            </Border.Effect>
            <StackPanel>
                <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{local:Text Skills}" Margin="8,4,8,4" />
                <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{Binding SkillPicker.Note}" TextWrapping="Wrap" Margin="8,2,8,6"
                           Visibility="{Binding SkillPicker.Note, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                <ListBox ItemsSource="{Binding SkillPicker.Options}" SelectedIndex="{Binding SkillPicker.ActiveIndex, Mode=OneWay}"
                         Focusable="False" MaxHeight="320" b:ScrollSelection.IntoView="True"
                         AutomationProperties.AutomationId="{Binding SkillPicker.Key}" AutomationProperties.Name="{local:Text Skills}"
                         Visibility="{Binding SkillPicker.HasOptions, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <ListBox.Template>
                        <ControlTemplate TargetType="ListBox">
                            <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <ItemsPresenter />
                            </ScrollViewer>
                        </ControlTemplate>
                    </ListBox.Template>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Focusable" Value="False" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Row" CornerRadius="{StaticResource Fadenstack.Radius.Control}" Background="Transparent" Margin="0,1">
                                            <ContentPresenter />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Row" Property="Background" Value="{DynamicResource Fadenstack.Hover}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="{x:Type m:SkillOption}">
                            <!-- Picked on press, without the focus leaving the composer (and the caret its place). -->
                            <Button Style="{StaticResource Fadenstack.GhostButton}" Focusable="False" ClickMode="Press"
                                    HorizontalContentAlignment="Stretch" Padding="8,6" AutomationProperties.Name="{Binding Name}"
                                    Command="{Binding DataContext.SkillPicker.PickCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <DockPanel>
                                    <TextBlock DockPanel.Dock="Left" Style="{StaticResource Fadenstack.Icon}" FontSize="13" Text="&#xE945;"
                                               Foreground="{DynamicResource Fadenstack.Accent}" VerticalAlignment="Top" Margin="0,2,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock x:Name="Description" Style="{StaticResource Fadenstack.Muted}" Text="{Binding Description}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                            </Button>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Description}" Value="">
                                    <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="11" Text="{local:Text SkillPickerHint}" Margin="8,4,8,2"
                           Visibility="{Binding SkillPicker.HasOptions, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
            </StackPanel>
        </Border>

        <!--
            About (the settings' last item): the agent, the app it runs in, the SDK, the server, and links. In the tree, not a
            popup, so it moves with the panel (an Office task pane) and keeps the keyboard there. Escape, Close, and a press
            anywhere outside it close it (ChatView.xaml.cs).
        -->
        <Border x:Name="AboutCard" Grid.Row="1" VerticalAlignment="Top" Margin="8,4,8,8" Padding="14,6,6,12"
                Background="{DynamicResource Fadenstack.Surface}" BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="1"
                CornerRadius="{StaticResource Fadenstack.Radius.Container}" KeyboardNavigation.TabNavigation="Cycle"
                AutomationProperties.Name="{local:Text About}"
                Visibility="{Binding IsAboutOpen, Converter={StaticResource Fadenstack.BoolToVisibility}}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
            </Border.Effect>
            <Border.InputBindings>
                <KeyBinding Key="Escape" Command="{Binding CloseAboutCommand}" />
            </Border.InputBindings>
            <!-- The title and Close stay outside the scrolled part, so nothing clips Close's focus ring. -->
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                    <Button x:Name="AboutClose" DockPanel.Dock="Right" Style="{StaticResource Fadenstack.GhostButton}"
                            Command="{Binding CloseAboutCommand}" ToolTip="{local:Text Close}" AutomationProperties.Name="{local:Text Close}">
                        <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="11" Text="&#xE711;" />
                    </Button>
                    <TextBlock Text="{local:Text About}" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                    <StackPanel Margin="0,0,8,0">
                        <!-- The agent: name, version or draft, model -->
                        <DockPanel Margin="0,0,0,10" Visibility="{Binding About.HasAgent, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <local:AgentAvatar DockPanel.Dock="Left" Small="True" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Top" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding About.AgentName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{Binding About.AgentDetail}" TextWrapping="Wrap"
                                           Visibility="{Binding About.AgentDetail, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                            </StackPanel>
                        </DockPanel>
                        <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{Binding About.AppText}" TextWrapping="Wrap" Margin="0,0,0,3"
                                   Visibility="{Binding About.AppText, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                        <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{Binding About.SdkText}" TextWrapping="Wrap" Margin="0,0,0,3" />
                        <TextBlock Style="{StaticResource Fadenstack.Muted}" Text="{Binding About.ServerText}" TextWrapping="Wrap"
                                   Visibility="{Binding About.ServerText, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
                        <Border BorderBrush="{DynamicResource Fadenstack.Border}" BorderThickness="0,1,0,0" Margin="0,10,0,6" />
                        <!--
                            Links: Help (the organisation's server), Fadenstack, Developer docs; each opens in the browser. One per
                            line, so nothing wraps unevenly, whatever the language makes of their names.
                        -->
                        <ItemsControl ItemsSource="{Binding About.Links}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:PanelLink}">
                                    <TextBlock Margin="0,2" TextWrapping="Wrap">
                                        <Hyperlink Command="{Binding DataContext.OpenLinkCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                   CommandParameter="{Binding}" ToolTip="{Binding Url.AbsoluteUri}" AutomationProperties.Name="{Binding Name}"
                                                   Foreground="{DynamicResource Fadenstack.Link}"><Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run
                                                FontFamily="{DynamicResource Fadenstack.IconFont}" FontSize="9" Text="&#xE8A7;" /></Hyperlink>
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Style="{StaticResource Fadenstack.SecondaryButton}" HorizontalAlignment="Left" Margin="0,8,0,0"
                                Command="{Binding CopyDetailsCommand}" Content="{local:Text CopyDetails}" />
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- Composer: a pasted picture, or picture files dropped on it, go with the next message -->
        <Border Grid.Row="2" Margin="12,4,12,12" Padding="12,8,6,6" CornerRadius="{StaticResource Fadenstack.Radius.Container}" BorderThickness="1"
                BorderBrush="{DynamicResource Fadenstack.Border}" Background="{DynamicResource Fadenstack.Surface}"
                b:PictureInput.Chat="{Binding}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <StackPanel>
                    <!-- The skills picked for the next message -->
                    <ItemsControl ItemsSource="{Binding PickedSkills}" Focusable="False" Margin="0,0,0,6"
                                  Visibility="{Binding PickedSkills.Count, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type m:SkillOption}">
                                <Border x:Name="Chip" CornerRadius="{StaticResource Fadenstack.Radius.Chip}" BorderThickness="1" BorderBrush="{DynamicResource Fadenstack.Border}"
                                        Background="{DynamicResource Fadenstack.SurfaceAlt}" Padding="6,2,2,2" Margin="0,0,6,4" ToolTip="{Binding Description}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="11" Text="&#xE945;" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource Fadenstack.Accent}" />
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" />
                                        <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="11" Text="{local:Text Skill}" Margin="6,0,0,0" />
                                        <Button Style="{StaticResource Fadenstack.GhostButton}" Padding="3" Margin="2,0,0,0" ToolTip="{local:Text RemoveAttachment}"
                                                AutomationProperties.Name="{local:Text RemoveAttachment}"
                                                Command="{Binding DataContext.RemoveSkillCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}">
                                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="9" Text="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Description}" Value="">
                                        <Setter TargetName="Chip" Property="ToolTip" Value="{x:Null}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <!-- Attached context: chips, a picture's small; an implicit one (the current selection) can be switched off -->
                    <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False" Margin="0,0,0,6"
                                  Visibility="{Binding Attachments.Count, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttachmentViewModel}">
                                <Border x:Name="Chip" CornerRadius="{StaticResource Fadenstack.Radius.Chip}" BorderThickness="1" BorderBrush="{DynamicResource Fadenstack.Border}"
                                        Background="{DynamicResource Fadenstack.SurfaceAlt}" Padding="6,2,2,2" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Fadenstack.GhostButton}" Padding="2" Command="{Binding ToggleCommand}"
                                                ToolTip="{local:Text IncludeAttachment}" Visibility="{Binding IsImplicit, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <TextBlock x:Name="Eye" Style="{StaticResource Fadenstack.Icon}" FontSize="11" Text="&#xE7B3;" />
                                        </Button>
                                        <Border x:Name="Thumbnail" Width="16" Height="16" CornerRadius="3" Margin="0,0,5,0" Visibility="Collapsed">
                                            <Border.Background>
                                                <ImageBrush ImageSource="{Binding Image, Converter={StaticResource Fadenstack.DataUrlToImage}}" Stretch="UniformToFill" />
                                            </Border.Background>
                                        </Border>
                                        <TextBlock x:Name="ChipIcon" Style="{StaticResource Fadenstack.Icon}" FontSize="11" Text="&#xE8A5;" Margin="0,0,4,0"
                                                   Foreground="{DynamicResource Fadenstack.ForegroundMuted}"
                                                   Visibility="{Binding IsImplicit, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}" />
                                        <TextBlock x:Name="ChipTitle" Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Subtitle}" FontSize="12" />
                                        <Button Style="{StaticResource Fadenstack.GhostButton}" Padding="3" Margin="2,0,0,0" ToolTip="{local:Text RemoveAttachment}"
                                                Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                CommandParameter="{Binding}" Visibility="{Binding IsImplicit, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="9" Text="&#xE711;" />
                                        </Button>
                                    </StackPanel>
                                </Border>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                        <Setter TargetName="ChipTitle" Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
                                        <Setter TargetName="Eye" Property="Text" Value="&#xED1A;" />
                                        <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding HasImage}" Value="True">
                                        <Setter TargetName="Thumbnail" Property="Visibility" Value="Visible" />
                                        <Setter TargetName="ChipIcon" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
                <TextBox x:Name="Composer" Grid.Row="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MaxHeight="200" MinHeight="40" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Fadenstack.Foreground}"
                         CaretBrush="{DynamicResource Fadenstack.Foreground}" Padding="0,2" IsEnabled="{Binding IsReady}"
                         b:ComposerFocus.Chat="{Binding}" b:SkillKeys.Picker="{Binding SkillPicker}" AutomationProperties.Name="{local:Text Message}">
                    <TextBox.InputBindings>
                        <!-- Enter sends; Shift+Enter is a new line (AcceptsReturn) -->
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <!-- The placeholder wraps (the composer grows with it), so no language's text is cut off in a narrow pane. -->
                <TextBlock Grid.Row="1" Text="{local:Text ComposerPlaceholder}" IsHitTestVisible="False" TextWrapping="Wrap"
                           Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Padding="2,2" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Composer}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <Grid DockPanel.Dock="Right">
                        <Button Style="{StaticResource Fadenstack.PrimaryButton}" Padding="8,5" ToolTip="{local:Text SendShortcut}" AutomationProperties.Name="{local:Text Send}"
                                Command="{Binding SendCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="13" Text="&#xE724;" Foreground="{DynamicResource Fadenstack.AccentForeground}" />
                        </Button>
                        <Button Style="{StaticResource Fadenstack.SecondaryButton}" Padding="8,5" ToolTip="{local:Text StopShortcut}" AutomationProperties.Name="{local:Text Stop}"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="13" Text="&#xE71A;" />
                        </Button>
                    </Grid>
                    <!-- A host's own buttons (e.g. "Add context") -->
                    <ContentPresenter DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Content="{Binding ComposerToolbar, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SelectedToolMode.Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedToolMode.Description, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>

        <!--
            Under the composer: answers come from an AI and can be wrong. Quiet, but always there; a host's empty text hides
            it. Below it, on a small line of its own and as muted, the "Fadenstack" link (unless the host turned Branding
            off). ChatView.xaml.cs fills them.
        -->
        <StackPanel x:Name="Footer" Grid.Row="3" Margin="12,-8,12,8">
            <TextBlock x:Name="AiNotice" FontSize="11" TextWrapping="Wrap" TextAlignment="Center"
                       Foreground="{DynamicResource Fadenstack.ForegroundMuted}" />
            <TextBlock x:Name="BrandingLine" FontSize="11" TextAlignment="Center" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" />
        </StackPanel>

        <!--
            The chats: a dropdown under the header, as wide as the panel, so the conversation stays in view and a
            narrow pane (an Office task pane) crops nothing. Its items sit 6 in from its 12 corners. Placed by
            ChatView.xaml.cs, 8 in from both edges ("Bottom" lined its border up with the panel's left edge and its
            shadow's margin hung outside).
        -->
        <Popup x:Name="HistoryMenu" IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Header}"
               Placement="Custom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Width="{Binding ActualWidth, ElementName=Header}">
            <Border Margin="8,4,8,16" Background="{DynamicResource Fadenstack.Surface}" BorderBrush="{DynamicResource Fadenstack.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Fadenstack.Radius.Container}" Padding="6" MaxHeight="440">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,2,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Fadenstack.GhostButton}" Command="{Binding NewChatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="11" Text="&#xE710;" Margin="0,0,6,0" />
                                <TextBlock Text="{local:Text NewChat}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{local:Text History}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Fadenstack.Muted}" Text="{local:Text NoHistory}" Margin="8,4,8,8"
                               Visibility="{Binding Sessions.Count, Converter={StaticResource Fadenstack.EmptyToCollapsed}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                                <Grid x:Name="Row" Margin="0,1">
                                    <Button x:Name="Open" Style="{StaticResource Fadenstack.GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,6,34,6"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Fadenstack.Muted}" FontSize="11" Text="{Binding WhenText}"
                                                       Margin="8,0,0,0" />
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="Delete" Style="{StaticResource Fadenstack.GhostButton}" HorizontalAlignment="Right" Margin="0,0,4,0"
                                            ToolTip="{local:Text DeleteSession}" AutomationProperties.Name="{local:Text DeleteSession}" Visibility="Hidden"
                                            Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Fadenstack.Icon}" FontSize="12" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" Text="&#xE74D;" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Open" Property="Background" Value="{DynamicResource Fadenstack.Hover}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
