<UserControl x:Class="Fadenstack.UI.Wpf.Views.MyDataSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:st="clr-namespace:Fadenstack.UI.Settings;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=st:MyDataSettingsViewModel}"
             d:DesignWidth="420" d:DesignHeight="360"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" Focusable="True">
    <!--
        "Your data on this device": a MyDataSettingsViewModel. The buttons export the person's data, remove this app's data or remove
        everything; a removal asks first, in a banner under the heading that says what goes and what stays (and names the apps), and the
        focus moves to its first button (Cancel: the safe one). Every text is a UiStrings text; the view holds no logic.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Skills.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Column" MaxWidth="480" HorizontalAlignment="Stretch" Margin="{StaticResource Fadenstack.Space.Page}"
                    b:WizardFocus.Step="{Binding State}">
            <TextBlock Style="{StaticResource Skill.Title}" Text="{local:Text MyDataTitle}" />
            <TextBlock Style="{StaticResource Skill.Caption}" Text="{local:Text MyDataIntro}" Margin="{StaticResource Fadenstack.Space.Block}" TextWrapping="Wrap" />

            <!-- The confirmation: what goes and what stays, the apps it affects, Remove and Cancel. -->
            <Border x:Name="ConfirmBanner" Style="{StaticResource Skill.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Block}"
                    Visibility="{Binding IsConfirming, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock x:Name="ConfirmLabel" Text="{Binding ConfirmText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    <ItemsControl x:Name="AppList" ItemsSource="{Binding AppLines}" Margin="12,8,0,0" IsTabStop="False"
                                  Visibility="{Binding HasAppLines, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="UndoLabel" Style="{StaticResource Skill.Strong}" Text="{Binding UndoText}" TextWrapping="Wrap" Margin="0,8,0,0" />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <Button x:Name="CancelButton" Style="{StaticResource Form.Secondary}" b:WizardFocus.IsFirst="True" Command="{Binding CancelCommand}"
                                Content="{local:Text MyDataCancel}" AutomationProperties.Name="{local:Text MyDataCancel}" />
                        <Button x:Name="ConfirmButton" Style="{StaticResource Form.Primary}" Margin="8,0,0,0" Command="{Binding ConfirmCommand}"
                                Content="{Binding ConfirmButtonText}" AutomationProperties.Name="{Binding ConfirmButtonText}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- A finished removal, or what went wrong. -->
            <Border x:Name="DoneBanner" Style="{StaticResource Skill.Banner.Success}" Margin="{StaticResource Fadenstack.Space.Block}"
                    Visibility="{Binding IsDone, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                <TextBlock x:Name="DoneText" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border x:Name="ErrorBanner" Style="{StaticResource Skill.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                    Visibility="{Binding IsError, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                <TextBlock x:Name="ErrorLabel" Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </Border>
            <Button x:Name="DismissButton" Style="{StaticResource Form.Secondary}" b:WizardFocus.IsFirst="True" HorizontalAlignment="Left"
                    Margin="{StaticResource Fadenstack.Space.Block}" Command="{Binding CancelCommand}"
                    Visibility="{Binding HasResult, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                    Content="{local:Text MyDataDismiss}" AutomationProperties.Name="{local:Text MyDataDismiss}" />

            <!-- The buttons. -->
            <StackPanel x:Name="Actions" Visibility="{Binding IsIdle, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                <WrapPanel Margin="{StaticResource Fadenstack.Space.Block}">
                    <Button x:Name="ExportButton" Style="{StaticResource Form.Secondary}" Margin="0,0,8,8" Command="{Binding ExportCommand}"
                            Content="{local:Text MyDataExport}" AutomationProperties.Name="{local:Text MyDataExportName}" />
                    <Button x:Name="ExportAllButton" Style="{StaticResource Form.Secondary}" Margin="0,0,8,8" Command="{Binding ExportAllCommand}"
                            Content="{local:Text MyDataExportAll}" AutomationProperties.Name="{local:Text MyDataExportAllName}" />
                </WrapPanel>
                <Button x:Name="RemoveButton" Style="{StaticResource Form.Secondary}" HorizontalAlignment="Left" Margin="{StaticResource Fadenstack.Space.Block}"
                        Command="{Binding RemoveCommand}"
                        Content="{local:Text MyDataRemove}" AutomationProperties.Name="{local:Text MyDataRemoveName}" />
                <!-- Visually the quieter of the two removals. -->
                <Button x:Name="RemoveAllButton" Style="{StaticResource Form.Quiet}" HorizontalAlignment="Left" Margin="{StaticResource Fadenstack.Space.Block}"
                        Command="{Binding RemoveAllCommand}"
                        Content="{local:Text MyDataRemoveAll}" AutomationProperties.Name="{local:Text MyDataRemoveAll}" />
            </StackPanel>
            <TextBlock x:Name="StatusLine" Style="{StaticResource Skill.Caption}" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding HasStatusLine, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
