<UserControl x:Class="Fadenstack.UI.Wpf.Views.SkillLibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sk="clr-namespace:Fadenstack.UI.Skills;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=sk:SkillLibraryViewModel}"
             d:DesignWidth="560" d:DesignHeight="640"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" Focusable="True">
    <!--
        The skill library (sdk/51 F04): one view for a SkillLibraryViewModel. The list of skills, each with where it comes from, "not
        reviewed" for the person's own and its switch where it may be switched; New and Import; Edit (View for a bundled skill),
        Duplicate, Delete (after the confirmation the view model asks for) and Export on each row. When the view model has an editor open
        the view shows it (SkillEditorView) in place of the list. The texts are UiStrings (five languages) from the view model's Strings.
        It works on .NET Framework 4.7.2 and on .NET 8.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Skills.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                      Visibility="{Binding Editor, Converter={StaticResource Fadenstack.EmptyToCollapsed}, ConverterParameter=invert}">
            <StackPanel x:Name="Column" MaxWidth="720" HorizontalAlignment="Stretch" Margin="{StaticResource Fadenstack.Space.Page}">
                <TextBlock Style="{StaticResource Skill.Title}" Text="{local:Text SkillLibraryTitle}" />

                <!-- What the last action did: information is a status (polite), a warning too, an error is an alert (assertive). -->
                <Border x:Name="MessageInfo" Style="{StaticResource Skill.Banner.Success}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding MessageIsInformation, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Border x:Name="MessageWarning" Style="{StaticResource Skill.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding MessageIsWarning, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
                </Border>
                <Border x:Name="MessageError" Style="{StaticResource Skill.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                        Visibility="{Binding MessageIsError, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                </Border>

                <!-- Reading, could not read, none yet. -->
                <TextBlock Style="{StaticResource Skill.Caption}" Text="{Binding Note}" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.LiveSetting="Polite"
                           Visibility="{Binding Note, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />

                <WrapPanel Orientation="Horizontal" Margin="{StaticResource Fadenstack.Space.WrapBlock}">
                    <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Primary}" b:WizardFocus.IsFirst="True" Command="{Binding NewCommand}" Content="{local:Text SkillNew}"
                            AutomationProperties.Name="{local:Text SkillNew}" />
                    <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Secondary}" Command="{Binding ImportCommand}" Content="{local:Text SkillImport}"
                            AutomationProperties.Name="{local:Text SkillImport}" />
                    <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" x:Name="DraftButton" Style="{StaticResource Form.Secondary}" Command="{Binding DraftFromChatCommand}"
                            Visibility="{Binding HasDraft, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                            Content="{local:Text SkillDraftTitle}" AutomationProperties.Name="{local:Text SkillDraftTitle}" />
                </WrapPanel>

                <!-- "Draft from this chat": only when the app gave the library its conversation. -->
                <local:SkillDraftView x:Name="DraftHost" DataContext="{Binding Draft}" Margin="{StaticResource Fadenstack.Space.Block}"
                                      Visibility="{Binding DataContext.DraftOpen, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                      Theme="{Binding Theme, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}" />

                <!-- Delete: the question first. Cancel has the focus. -->
                <Border x:Name="DeleteCard" Style="{StaticResource Skill.Card}" Margin="{StaticResource Fadenstack.Space.Block}" b:WizardFocus.Step="{Binding PendingDelete}"
                        Visibility="{Binding PendingDelete, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Skill.Strong}" Text="{Binding DeleteTitle}" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="{Binding DeleteBody}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Item}" />
                        <WrapPanel Orientation="Horizontal" Margin="{StaticResource Fadenstack.Space.WrapEnd}">
                            <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Secondary}" b:WizardFocus.IsFirst="True" Command="{Binding CancelDeleteCommand}"
                                    Content="{local:Text SkillCancel}" AutomationProperties.Name="{local:Text SkillCancel}" />
                            <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Primary}" Command="{Binding ConfirmDeleteCommand}" Content="{local:Text SkillDelete}"
                                    AutomationProperties.Name="{local:Text SkillDelete}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- Import: what the checks found, nothing written yet. Enter presses Import when every check passed. -->
                <Border x:Name="ImportCard" Style="{StaticResource Skill.Card}" Margin="{StaticResource Fadenstack.Space.Block}" b:WizardFocus.Step="{Binding PendingImport}"
                        Visibility="{Binding PendingImport, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Skill.Strong}" Text="{Binding ImportTitle}" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.LiveSetting="Assertive" />
                        <TextBlock Text="{Binding ImportBody}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Item}" />
                        <ItemsControl ItemsSource="{Binding ImportIssues}" Focusable="False" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.LiveSetting="Polite">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Skill.Banner.Issue}" Margin="{StaticResource Fadenstack.Space.Tight}">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <WrapPanel Orientation="Horizontal" Margin="{StaticResource Fadenstack.Space.WrapEnd}">
                            <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Secondary}" b:WizardFocus.IsFirst="True" Command="{Binding CancelImportCommand}"
                                    Content="{local:Text SkillCancel}" AutomationProperties.Name="{local:Text SkillCancel}" />
                            <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Primary}" b:WizardFocus.IsPrimary="True" Command="{Binding ConfirmImportCommand}"
                                    Visibility="{Binding ImportReplaces, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}"
                                    Content="{local:Text SkillImport}" AutomationProperties.Name="{local:Text SkillImport}" />
                            <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Primary}" b:WizardFocus.IsPrimary="True" Command="{Binding ConfirmImportCommand}"
                                    Visibility="{Binding ImportReplaces, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                    Content="{local:Text SkillReplace}" AutomationProperties.Name="{local:Text SkillReplace}" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- The skills. -->
                <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource Skill.Card}" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.Name="{Binding Name}">
                                <StackPanel>
                                    <DockPanel Margin="{StaticResource Fadenstack.Space.Item}">
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Top" Margin="8,0,0,0" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Visibility="{Binding CanSwitch, Converter={StaticResource Fadenstack.BoolToVisibility}}" CommandParameter="{Binding}"
                                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                                                  AutomationProperties.Name="{Binding Name}">
                                            <TextBlock Style="{StaticResource Skill.Caption}" Text="{Binding SwitchLabel}" />
                                        </CheckBox>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Skill.Strong}" Text="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Skill.Caption}" Text="{Binding Description}" />
                                        </StackPanel>
                                    </DockPanel>
                                    <!-- A skill that cannot be read: why, and that it can be opened or deleted. -->
                                    <Border Style="{StaticResource Skill.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Item}"
                                            Visibility="{Binding IsBroken, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                        <TextBlock x:Name="BrokenText" Text="{Binding BrokenText}" TextWrapping="Wrap" />
                                    </Border>
                                    <WrapPanel Orientation="Horizontal" Margin="{StaticResource Fadenstack.Space.Item}">
                                        <Border Style="{StaticResource Fadenstack.Badge}" Margin="{StaticResource Fadenstack.Space.BesideItem}">
                                            <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="11" Text="{Binding OriginLabel}" />
                                        </Border>
                                        <Border Style="{StaticResource Fadenstack.Badge}" Margin="0"
                                                Visibility="{Binding IsNotReviewed, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Fadenstack.Muted}" FontSize="11" Text="{Binding StatusLabel}" />
                                        </Border>
                                    </WrapPanel>
                                    <WrapPanel Orientation="Horizontal" Margin="{StaticResource Fadenstack.Space.WrapEnd}">
                                        <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Secondary}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsReadOnly, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                                                Content="{local:Text SkillEdit}" AutomationProperties.Name="{Binding EditLabel}" />
                                        <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Secondary}" CommandParameter="{Binding}"
                                                Visibility="{Binding IsReadOnly, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                                Command="{Binding DataContext.EditCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                                                Content="{local:Text SkillView}" AutomationProperties.Name="{Binding ViewLabel}" />
                                        <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Quiet}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanDuplicate, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                                Command="{Binding DataContext.DuplicateCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                                                Content="{local:Text SkillDuplicate}" AutomationProperties.Name="{Binding DuplicateLabel}" />
                                        <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Quiet}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanExport, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                                Command="{Binding DataContext.ExportCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                                                Content="{local:Text SkillExport}" AutomationProperties.Name="{Binding ExportLabel}" />
                                        <Button Margin="{StaticResource Fadenstack.Space.BesideItem}" Style="{StaticResource Form.Quiet}" CommandParameter="{Binding}"
                                                Visibility="{Binding CanDelete, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                                Command="{Binding DataContext.AskDeleteCommand, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                                                Content="{local:Text SkillDelete}" AutomationProperties.Name="{Binding DeleteLabel}" />
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>

        <!-- The open editor (new, edit, duplicate, a bundled skill to read, or a draft's proposal). -->
        <local:SkillEditorView x:Name="EditorHost" DataContext="{Binding Editor}"
                               Theme="{Binding Theme, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}}"
                               Visibility="{Binding DataContext.Editor, RelativeSource={RelativeSource AncestorType={x:Type local:SkillLibraryView}}, Converter={StaticResource Fadenstack.EmptyToCollapsed}}" />
    </Grid>
</UserControl>
