<UserControl x:Class="Fadenstack.UI.Wpf.Views.SkillDraftView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:sk="clr-namespace:Fadenstack.UI.Skills;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=sk:SkillDraftViewModel}"
             d:DesignWidth="420" d:DesignHeight="420"
             Background="{DynamicResource Fadenstack.Background}" Foreground="{DynamicResource Fadenstack.Foreground}"
             FontFamily="{DynamicResource Fadenstack.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display" Focusable="True">
    <!--
        "Draft from this chat" (sdk/51 F04): one view for a SkillDraftViewModel. What the skill should be for (optional), the button that
        asks the model once, the draft's state in words (asking, the proposal, why it failed) and the statement that nothing is saved until
        the person presses Save in the editor. The proposal opens in the editor (the library shows it itself; Edit asks the host to).
        The texts are UiStrings from the view model's Strings. It works on .NET Framework 4.7.2 and on .NET 8.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Skills.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
        <StackPanel x:Name="Column" MaxWidth="480" HorizontalAlignment="Stretch" Margin="{StaticResource Fadenstack.Space.Page}">
            <TextBlock Style="{StaticResource Skill.Title}" Text="{local:Text SkillDraftTitle}" />

            <TextBlock Style="{StaticResource Skill.Strong}" Text="{local:Text SkillDraftGuidance}" Margin="{StaticResource Fadenstack.Space.Tight}" />
            <TextBox x:Name="GuidanceBox" Style="{StaticResource Form.TextBox}" b:WizardFocus.IsFirst="True" Margin="{StaticResource Fadenstack.Space.Block}" TextWrapping="Wrap"
                     Text="{Binding Guidance, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsWorking, Converter={StaticResource Fadenstack.InverseBool}}"
                     AutomationProperties.Name="{local:Text SkillDraftGuidance}" />

            <!-- In every state: nothing is saved until Save. -->
            <TextBlock x:Name="StandingNote" Style="{StaticResource Skill.Caption}" Text="{Binding StandingNote}" Margin="{StaticResource Fadenstack.Space.Block}" />

            <Button x:Name="StartButton" Style="{StaticResource Form.Primary}" b:WizardFocus.IsPrimary="True" Margin="{StaticResource Fadenstack.Space.Block}" Command="{Binding DraftCommand}"
                    Content="{local:Text SkillDraftStart}" AutomationProperties.Name="{local:Text SkillDraftStart}" />

            <ProgressBar IsIndeterminate="True" Margin="{StaticResource Fadenstack.Space.Block}"
                         Visibility="{Binding IsWorking, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                         AutomationProperties.Name="{local:Text SkillDraftWorking}" />

            <!-- The state in words, in the colour of what it means. -->
            <Border Style="{StaticResource Skill.Banner.Success}" Margin="{StaticResource Fadenstack.Space.Block}"
                    Visibility="{Binding State, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Ready'}">
                <TextBlock x:Name="ReadyText" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border Style="{StaticResource Skill.Banner.Warning}" Margin="{StaticResource Fadenstack.Space.Block}"
                    Visibility="{Binding State, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='ReadyWithProblems,NoChat,NoModel'}">
                <TextBlock x:Name="WarningText" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
            <Border Style="{StaticResource Skill.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                    Visibility="{Binding State, Converter={x:Static b:WizardIn.Shown}, ConverterParameter='Failed,Unreadable'}">
                <TextBlock x:Name="ErrorText" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
            </Border>
            <TextBlock x:Name="WorkingText" Style="{StaticResource Skill.Caption}" Text="{Binding StatusText}" Margin="{StaticResource Fadenstack.Space.Block}" AutomationProperties.LiveSetting="Polite"
                       Visibility="{Binding IsWorking, Converter={StaticResource Fadenstack.BoolToVisibility}}" />

            <!-- The proposal: where it is, and that it is not saved. -->
            <Border x:Name="ProposalCard" Style="{StaticResource Skill.Card}"
                    Visibility="{Binding Proposal, Converter={StaticResource Fadenstack.EmptyToCollapsed}}">
                <StackPanel>
                    <TextBlock x:Name="ProposalText" Text="{Binding Proposal.ProposalNote}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Item}" />
                    <Button x:Name="OpenButton" Style="{StaticResource Form.Secondary}" HorizontalAlignment="Left" Command="{Binding OpenProposalCommand}"
                            Content="{local:Text SkillDraftOpen}" AutomationProperties.Name="{local:Text SkillDraftOpen}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
