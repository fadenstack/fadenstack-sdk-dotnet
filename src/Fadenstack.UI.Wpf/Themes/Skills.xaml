<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        What the skill views (library, editor, draft) share: the forms' styles and shape (Controls.xaml, which brings the chat's styles and the
        Markdown blocks the preview uses), under the skill views' names. The colours come from Colors.*.xaml, which the view merges first.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="Skill.Title" TargetType="TextBlock" BasedOn="{StaticResource Form.Title}" />
    <Style x:Key="Skill.Strong" TargetType="TextBlock" BasedOn="{StaticResource Form.Strong}" />
    <Style x:Key="Skill.Caption" TargetType="TextBlock" BasedOn="{StaticResource Form.Caption}" />

    <!-- Buttons: the forms' own; the one that disappears while its command cannot run. -->
    <Style x:Key="Skill.Primary" TargetType="Button" BasedOn="{StaticResource Form.Primary}" />
    <Style x:Key="Skill.Secondary" TargetType="Button" BasedOn="{StaticResource Form.Secondary}" />
    <Style x:Key="Skill.Quiet" TargetType="Button" BasedOn="{StaticResource Form.Quiet}" />
    <Style x:Key="Skill.SecondaryHide" TargetType="Button" BasedOn="{StaticResource Form.SecondaryHide}" />

    <Style x:Key="Skill.Banner" TargetType="Border" BasedOn="{StaticResource Form.Banner}" />
    <Style x:Key="Skill.Banner.Error" TargetType="Border" BasedOn="{StaticResource Form.Banner.Error}" />
    <Style x:Key="Skill.Banner.Warning" TargetType="Border" BasedOn="{StaticResource Form.Banner.Warning}" />
    <Style x:Key="Skill.Banner.Success" TargetType="Border" BasedOn="{StaticResource Form.Banner.Success}" />
    <!-- One finding of the checks: an error stops the save, a warning only says. -->
    <Style x:Key="Skill.Banner.Issue" TargetType="Border" BasedOn="{StaticResource Form.Banner.Warning}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsError}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Danger}" />
                <Setter Property="Background" Value="{DynamicResource Fadenstack.BlockedBackground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Skill.Card" TargetType="Border" BasedOn="{StaticResource Form.Card}" />
</ResourceDictionary>
