<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:t="clr-namespace:Fadenstack.UI.Tools;assembly=Fadenstack.UI"
                    xmlns:b="clr-namespace:Fadenstack.UI.Wpf.Behaviors"
                    xmlns:local="clr-namespace:Fadenstack.UI.Wpf.Views">
    <!--
        The web search settings (sdk/51 F06) for a WebSearchSettingsViewModel: a title with its close button, the three choices (Off, Brave,
        SearXNG), the key box (a password box that carries the typed key to the view model, never filled from the store; a kept key shows
        as a line with Replace key and Remove key), the address box, the lines on where the key is kept and on what leaves the
        organisation, the problem and Save and Cancel. One template for the Tools view's sheet and for WebSearchSettingsView, so the
        two cannot differ. Binding and commands only; every text is a UiStrings name; every control has an automation name. The
        colours come from Colors.*.xaml, which the view that uses this merges first; the shape is the forms' (containers 12, controls 6).
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Fadenstack.UI.Wpf;component/Themes/Tools.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style x:Key="WebSearch.Subtitle" TargetType="TextBlock" BasedOn="{StaticResource Form.Strong}">
        <Setter Property="FontSize" Value="15" />
    </Style>

    <DataTemplate x:Key="WebSearch.Body" DataType="{x:Type t:WebSearchSettingsViewModel}">
        <DockPanel>
            <Grid DockPanel.Dock="Top" Margin="16,12,8,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource WebSearch.Subtitle}" Text="{local:Text WebSearchTitle}" VerticalAlignment="Center" />
                <Button x:Name="WebSearchCloseButton" Grid.Column="1" Style="{StaticResource Form.IconButton}" Command="{Binding CancelCommand}"
                        ToolTip="{local:Text ToolsCloseSheet}" AutomationProperties.Name="{local:Text ToolsCloseSheet}">
                    <Path Style="{StaticResource Tools.Icon}" Data="{StaticResource Icon.Close}" />
                </Button>
            </Grid>
            <Border DockPanel.Dock="Bottom" Style="{StaticResource Tools.Rule}" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="WebSearchCancelButton" Style="{StaticResource Form.Secondary}" Command="{Binding CancelCommand}" Margin="{StaticResource Fadenstack.Space.Beside}"
                            Content="{local:Text WebSearchCancel}" AutomationProperties.Name="{local:Text WebSearchCancel}" />
                    <Button x:Name="WebSearchSaveButton" Style="{StaticResource Form.Primary}" Command="{Binding SaveCommand}"
                            Content="{local:Text WebSearchSave}" AutomationProperties.Name="{local:Text WebSearchSave}" />
                </StackPanel>
            </Border>
            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,0,16,12">
                    <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text WebSearchIntro}" Margin="{StaticResource Fadenstack.Space.Item}" />

                    <!-- The choice: three segments. -->
                    <WrapPanel x:Name="WebSearchChoices" Margin="{StaticResource Fadenstack.Space.Item}" AutomationProperties.Name="{local:Text WebSearchChoiceName}">
                        <RadioButton x:Name="WebSearchOffButton" Style="{StaticResource Tools.Segment}" Margin="0,0,8,8" IsChecked="{Binding IsOff}"
                                     Content="{local:Text WebSearchChoiceOff}" AutomationProperties.Name="{local:Text WebSearchChoiceOff}" />
                        <RadioButton x:Name="WebSearchBraveButton" Style="{StaticResource Tools.Segment}" Margin="0,0,8,8" IsChecked="{Binding IsBrave}"
                                     Content="{local:Text WebSearchChoiceBrave}" AutomationProperties.Name="{local:Text WebSearchChoiceBrave}" />
                        <RadioButton x:Name="WebSearchSearxngButton" Style="{StaticResource Tools.Segment}" Margin="0,0,8,8" IsChecked="{Binding IsSearXng}"
                                     Content="{local:Text WebSearchChoiceSearxng}" AutomationProperties.Name="{local:Text WebSearchChoiceSearxng}" />
                    </WrapPanel>

                    <!-- Off. -->
                    <TextBlock x:Name="WebSearchOffHelp" Style="{StaticResource Form.Caption}" Text="{local:Text WebSearchOffHelp}" Margin="{StaticResource Fadenstack.Space.Block}"
                               Visibility="{Binding IsOff, Converter={StaticResource Fadenstack.BoolToVisibility}}" />

                    <!-- Brave: the person's own key. -->
                    <StackPanel x:Name="WebSearchBraveSection" Visibility="{Binding IsBrave, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text WebSearchKeyLabel}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                        <PasswordBox x:Name="WebSearchKeyBox" b:SecretBox.Value="{Binding Key}" Margin="{StaticResource Fadenstack.Space.Tight}"
                                     Visibility="{Binding ShowsKeyInput, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                     AutomationProperties.Name="{local:Text WebSearchKeyLabel}" />
                        <DockPanel x:Name="WebSearchKeyState" Margin="{StaticResource Fadenstack.Space.Tight}" LastChildFill="False"
                                   Visibility="{Binding ShowsReplaceKey, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                            <Button x:Name="WebSearchRemoveKeyButton" DockPanel.Dock="Right" Style="{StaticResource Form.Quiet}" Command="{Binding RemoveKeyCommand}" MinHeight="28" Padding="8,0"
                                    Visibility="{Binding ShowsKeptKey, Converter={StaticResource Fadenstack.BoolToVisibility}}"
                                    Content="{local:Text WebSearchKeyRemove}" AutomationProperties.Name="{local:Text WebSearchKeyRemove}" />
                            <Button x:Name="WebSearchReplaceKeyButton" DockPanel.Dock="Right" Style="{StaticResource Form.Quiet}" Command="{Binding ReplaceKeyCommand}" MinHeight="28" Padding="8,0"
                                    Content="{local:Text WebSearchKeyReplace}" AutomationProperties.Name="{local:Text WebSearchKeyReplace}" />
                            <TextBlock x:Name="WebSearchKeyKept" DockPanel.Dock="Left" Text="{local:Text WebSearchKeyKept}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsKeptKey, Converter={StaticResource Fadenstack.BoolToVisibility}}" />
                            <TextBlock x:Name="WebSearchKeyRemoved" DockPanel.Dock="Left" Text="{local:Text WebSearchKeyRemoved}" VerticalAlignment="Center" TextWrapping="Wrap"
                                       Visibility="{Binding ShowsRemovedKey, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text WebSearchKeyHelp}" Margin="{StaticResource Fadenstack.Space.Block}" />
                        <TextBlock x:Name="WebSearchKeptWhere" Style="{StaticResource Form.Caption}" Text="{Binding KeptWhereText}" Margin="{StaticResource Fadenstack.Space.Block}" />
                    </StackPanel>

                    <!-- SearXNG: the person's own address. -->
                    <StackPanel x:Name="WebSearchSearxngSection" Visibility="{Binding IsSearXng, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Form.Strong}" Text="{local:Text WebSearchUrlLabel}" Margin="{StaticResource Fadenstack.Space.Tight}" />
                        <TextBox x:Name="WebSearchAddressBox" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="{StaticResource Fadenstack.Space.Tight}"
                                 AutomationProperties.Name="{local:Text WebSearchUrlLabel}" />
                        <TextBlock Style="{StaticResource Form.Caption}" Text="{local:Text WebSearchUrlHelp}" Margin="{StaticResource Fadenstack.Space.Block}" />
                    </StackPanel>

                    <TextBlock x:Name="WebSearchPrivacy" Style="{StaticResource Form.Caption}" Text="{Binding PrivacyText}" Margin="{StaticResource Fadenstack.Space.Block}"
                               Visibility="{Binding IsOff, Converter={StaticResource Fadenstack.InverseBoolToVisibility}}" />
                    <!-- The problem in the error banner (the palette's own text on the blocked tint), so it reads in every palette. -->
                    <Border x:Name="WebSearchErrorBanner" Style="{StaticResource Form.Banner.Error}" Margin="{StaticResource Fadenstack.Space.Block}"
                            Visibility="{Binding HasError, Converter={StaticResource Fadenstack.BoolToVisibility}}">
                        <TextBlock x:Name="WebSearchError" Text="{Binding ErrorText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Assertive" />
                    </Border>
                    <TextBlock x:Name="WebSearchSaved" Text="{Binding SavedText}" TextWrapping="Wrap" Margin="{StaticResource Fadenstack.Space.Block}"
                               Visibility="{Binding HasSaved, Converter={StaticResource Fadenstack.BoolToVisibility}}" AutomationProperties.LiveSetting="Polite" />
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </DataTemplate>
</ResourceDictionary>
