<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!--
        Light colours: neutral greys, as Office's and Windows' light themes use; blue only for what acts.
        Every template uses these keys through DynamicResource.
    -->
    <SolidColorBrush x:Key="Fadenstack.Background" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Surface" Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.SurfaceAlt" Color="#EFEFEF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Border" Color="#D4D4D4" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Foreground" Color="#1F1F1F" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ForegroundMuted" Color="#5E5E5E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Accent" Color="#0F6CBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentHover" Color="#115EA3" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentForeground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Hover" Color="#F0F0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Pressed" Color="#E3E3E3" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Link" Color="#0F6CBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Danger" Color="#C42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Warning" Color="#9D5D00" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Success" Color="#0F7B0F" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.CodeBackground" Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.CodeInlineBackground" Color="#EEEEEE" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.UserBubble" Color="#EBF3FC" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.InfoBackground" Color="#EBF3FC" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.WarningBackground" Color="#FFF4CE" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.BlockedBackground" Color="#FDE7E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AddedBackground" Color="#DFF6DD" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.RemovedBackground" Color="#FDE7E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Focus" Color="#0F6CBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Scrim" Color="#33000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ScrollThumb" Color="#C2C2C2" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ScrollThumbHover" Color="#9E9E9E" po:Freeze="True" />
    <!-- The agent avatar (AgentAvatar): navy plates, the rose thread plate, the hollow under the lid. -->
    <SolidColorBrush x:Key="Fadenstack.Avatar.PlateTop" Color="#1C2436" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.PlateSide" Color="#0A0E1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.Thread" Color="#E2325A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.ThreadSide" Color="#A8143E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.Hollow" Color="#610A0E1A" po:Freeze="True" />
    <FontFamily x:Key="Fadenstack.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fadenstack.CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Fadenstack.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
