    <!-- An icon is its 24 x 24 box scaled to 18 (so every icon sits where the others do) and filled with the text colour it inherits. -->
    <Style x:Key="Tools.Icon" TargetType="Path">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Stretch" Value="None" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Fill" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.75" ScaleY="0.75" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tools.Icon.Small" TargetType="Path" BasedOn="{StaticResource Tools.Icon}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.6666667" ScaleY="0.6666667" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tools.Icon.Large" TargetType="Path" BasedOn="{StaticResource Tools.Icon}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="0.8333333" ScaleY="0.8333333" />
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Tools.Icon.Hero" TargetType="Path" BasedOn="{StaticResource Tools.Icon}">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.3333333" ScaleY="1.3333333" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== The switch: a 36 x 20 track (a pill), a 14 knob; on is the accent ======================================== -->
    <Style x:Key="Tools.Switch" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid SnapsToDevicePixels="True" Width="36" Height="20" Margin="3" Background="Transparent">
                        <Border x:Name="Boundary" CornerRadius="10" Background="{DynamicResource Fadenstack.ControlBorder}" />
                        <Ellipse x:Name="Knob" Width="14" Height="14" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="3,0,0,0"
                                 Fill="{DynamicResource Fadenstack.Background}" />
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Fadenstack.Focus}" IsHitTestVisible="False" Visibility="Collapsed"
                                CornerRadius="12" Margin="-3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Boundary" Property="Background" Value="{DynamicResource Fadenstack.AccentIcon}" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Fadenstack.AccentForeground}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== A segment: one of two or three choices (a control, 6) ==================================================== -->
    <Style x:Key="Tools.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.ControlBorder}" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="{StaticResource Fadenstack.Size.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Boundary" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                                CornerRadius="{StaticResource Fadenstack.Radius.Control}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Fadenstack.Focus}" IsHitTestVisible="False" Visibility="Collapsed"
                                CornerRadius="{StaticResource Fadenstack.Radius.Control}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Boundary" Property="Background" Value="{DynamicResource Fadenstack.Hover}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Boundary" Property="Background" Value="{DynamicResource Fadenstack.InfoBackground}" />
                            <Setter TargetName="Boundary" Property="BorderBrush" Value="{DynamicResource Fadenstack.AccentBorder}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== A server's card is a button, so the whole card opens the drawer ========================================== -->
    <Style x:Key="Tools.Card" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Border x:Name="Boundary" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Fadenstack.Radius.Container}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border x:Name="FocusRing" BorderThickness="2" BorderBrush="{DynamicResource Fadenstack.Focus}" IsHitTestVisible="False" Visibility="Collapsed"
                                CornerRadius="{StaticResource Fadenstack.Radius.Container}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Boundary" Property="Background" Value="{DynamicResource Fadenstack.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Boundary" Property="Background" Value="{DynamicResource Fadenstack.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Its drawer is open: the edge is the accent, 2 px (the padding gives the pixel back). -->
            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.AccentBorder}" />
                <Setter Property="BorderThickness" Value="2" />
                <Setter Property="Padding" Value="11" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- The scrim of a drawer or a sheet: a click on it closes; it is not a stop of the keyboard (Esc does the same). -->
    <Style x:Key="Tools.Scrim" TargetType="Button">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Scrim}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Tiles, chips, badges, lines =============================================================================== -->
    <Style x:Key="Tools.Tile" TargetType="Border">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.AccentIcon}" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>
    <Style x:Key="Tools.Tile.Off" TargetType="Border" BasedOn="{StaticResource Tools.Tile}">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
    </Style>
    <Style x:Key="Tools.Tile.Hero" TargetType="Border" BasedOn="{StaticResource Tools.Tile}">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Container}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.InfoBackground}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <!-- A line that says a warning or a refusal: the warning tint, the palette's text on it. -->
    <Style x:Key="Tools.WarnLine" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.WarningBackground}" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style x:Key="Tools.ProblemLine" TargetType="Border" BasedOn="{StaticResource Tools.WarnLine}">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.BlockedBackground}" />
    </Style>
    <!-- The plain status line (the dot and the words) goes where a warning or a problem has its own tinted line. -->
    <Style x:Key="Tools.PlainLine" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsWarning}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.DrawerPlainLine" TargetType="StackPanel">
        <Setter Property="Orientation" Value="Horizontal" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Server.StatusIsWarning}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Server.StatusIsProblem}" Value="True">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.Dot.Base" TargetType="Ellipse">
        <Setter Property="Width" Value="8" />
        <Setter Property="Height" Value="8" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="Fill" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
    </Style>
    <Style x:Key="Tools.Dot" TargetType="Ellipse" BasedOn="{StaticResource Tools.Dot.Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsGood}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Fadenstack.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding StatusIsProblem}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Fadenstack.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.Dot.Warn" TargetType="Ellipse" BasedOn="{StaticResource Tools.Dot.Base}">
        <Setter Property="Fill" Value="{DynamicResource Fadenstack.Warning}" />
    </Style>
    <Style x:Key="Tools.Dot.Problem" TargetType="Ellipse" BasedOn="{StaticResource Tools.Dot.Base}">
        <Setter Property="Fill" Value="{DynamicResource Fadenstack.Danger}" />
    </Style>
    <Style x:Key="Tools.DrawerDot" TargetType="Ellipse" BasedOn="{StaticResource Tools.Dot.Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Server.StatusIsGood}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Fadenstack.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Server.StatusIsProblem}" Value="True">
                <Setter Property="Fill" Value="{DynamicResource Fadenstack.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.Status.Base" TargetType="TextBlock" BasedOn="{StaticResource Fadenstack.Muted}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tools.Status" TargetType="TextBlock" BasedOn="{StaticResource Tools.Status.Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding StatusIsGood}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.Status.Warn" TargetType="TextBlock" BasedOn="{StaticResource Tools.Status.Base}">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
    <Style x:Key="Tools.DrawerStatus" TargetType="TextBlock" BasedOn="{StaticResource Tools.Status.Base}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Server.StatusIsGood}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Success}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <!-- A tool's name as a mono chip; the warning one for a tool whose server says it may delete. -->
    <Style x:Key="Tools.ToolChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding MayDelete}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fadenstack.WarningBackground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.Mono" TargetType="TextBlock" BasedOn="{StaticResource Fadenstack.Mono}">
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A chip of the bar: the policy (success, or a warning), a state of a cloud tool, the server's own word (outlined). -->
    <Style x:Key="Tools.Policy" TargetType="Border">
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.AddedBackground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding PolicyIsWarning}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fadenstack.WarningBackground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.Badge" TargetType="Border">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.InfoBackground}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Class}" Value="Write">
                <Setter Property="Background" Value="{DynamicResource Fadenstack.WarningBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Fadenstack.BlockedBackground}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Tools.StateChip" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.AddedBackground}" />
    </Style>
    <Style x:Key="Tools.StateChip.Outlined" TargetType="Border" BasedOn="{StaticResource Tools.StateChip}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,1" />
    </Style>
    <Style x:Key="Tools.StateChip.Muted" TargetType="Border" BasedOn="{StaticResource Tools.StateChip}">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
    </Style>
    <Style x:Key="Tools.StateChip.Warning" TargetType="Border" BasedOn="{StaticResource Tools.StateChip}">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.WarningBackground}" />
    </Style>
    <Style x:Key="Tools.Says" TargetType="Border">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.ControlBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="7,0" />
        <Setter Property="Margin" Value="0,0,4,4" />
    </Style>
    <Style x:Key="Tools.Micro" TargetType="TextBlock" BasedOn="{StaticResource Fadenstack.Muted}">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Tools.MicroText" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- A card of a list: a container (12), its rows cut by thin rules; a note: the muted surface. -->
    <Style x:Key="Tools.ListCard" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Container}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Surface}" />
    </Style>
    <Style x:Key="Tools.Note" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Container}" />
        <Setter Property="Padding" Value="{StaticResource Fadenstack.Padding.Container}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
    </Style>
    <Style x:Key="Tools.Rule" TargetType="Border">
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
    <Style x:Key="Tools.Error" TargetType="TextBlock" BasedOn="{StaticResource Form.Caption}">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Danger}" />
    </Style>

    <!-- The drawer (a panel at the right edge, an edge at its left) and a sheet (a container over the page). -->
    <Style x:Key="Tools.Drawer" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="BorderThickness" Value="1,0,0,0" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
    <Style x:Key="Tools.Sheet" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Container}" />
        <Setter Property="MaxWidth" Value="480" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
</ResourceDictionary>
