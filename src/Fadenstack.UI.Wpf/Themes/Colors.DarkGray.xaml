<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!--
        Dark gray colours: Office's Dark Gray theme draws its frame, pane headers and status bar in #525252 and the
        area around the page in #595A5A, where the black theme's #1F1F1F stood out as a hole. The panel sits a step
        darker than the frame, as Office's own panes do; text, links and states are lighter than in the dark
        colours so they keep their contrast on grey. Same keys as Colors.Dark.xaml.
    -->
    <SolidColorBrush x:Key="Fadenstack.Background" Color="#444444" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Surface" Color="#4E4E4E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.SurfaceAlt" Color="#585858" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Border" Color="#6A6A6A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Foreground" Color="#F5F5F5" po:Freeze="True" />
    <!-- Muted text keeps 4.5:1 on every grey it sits on: the surfaces, code, hover and pressed. -->
    <SolidColorBrush x:Key="Fadenstack.ForegroundMuted" Color="#D2D2D2" po:Freeze="True" />
    <!--
        The accent fills buttons under white text (4.5:1 or more, hover too), as in the dark colours; on grey no blue
        that dark reaches 3:1 as an icon, so icons, marks and lines take a light tint of it (AccentIcon). Same hue.
    -->
    <SolidColorBrush x:Key="Fadenstack.Accent" Color="#2976C9" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentHover" Color="#256CB8" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentForeground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentIcon" Color="#87B5E6" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Hover" Color="#555555" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Pressed" Color="#5A5A5A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Link" Color="#94C4F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Danger" Color="#FF9AA1" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Warning" Color="#F4C860" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Success" Color="#8EDC82" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.CodeBackground" Color="#3A3A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.CodeInlineBackground" Color="#575757" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.UserBubble" Color="#3E4D61" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.InfoBackground" Color="#3A4B63" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.WarningBackground" Color="#54492F" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.BlockedBackground" Color="#583A3E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AddedBackground" Color="#34513A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.RemovedBackground" Color="#583A3E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Focus" Color="#94C4F7" po:Freeze="True" />
    <!--
        The keyboard-focus ring on a link (About's, the line under the composer, an answer's), in the focus colour: the
        system's black dashes vanish on dark colours. The brush is taken when the colours load (StaticResource): a
        focus ring is drawn over the window, where the panel's resources cannot be looked up.
    -->
    <Style x:Key="Fadenstack.LinkFocusVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="-3,-1" Stroke="{StaticResource Fadenstack.Focus}" StrokeThickness="2" RadiusX="3" RadiusY="3"
                               SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <SolidColorBrush x:Key="Fadenstack.Scrim" Color="#66000000" po:Freeze="True" />
    <!-- The scroll thumb shows where the conversation is: 3:1 or more on the background and the surfaces. -->
    <SolidColorBrush x:Key="Fadenstack.ScrollThumb" Color="#9E9E9E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ScrollThumbHover" Color="#B4B4B4" po:Freeze="True" />
    <!-- The agent avatar (AgentAvatar): as in the dark colours. -->
    <SolidColorBrush x:Key="Fadenstack.Avatar.PlateTop" Color="#F3F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.PlateSide" Color="#AEB7C6" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.Thread" Color="#FF4D6D" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.ThreadSide" Color="#C21E48" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.Hollow" Color="#8C0A0E1A" po:Freeze="True" />
    <FontFamily x:Key="Fadenstack.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fadenstack.CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Fadenstack.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
