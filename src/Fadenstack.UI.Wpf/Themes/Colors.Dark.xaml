<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!--
        Dark colours: neutral greys, as Office's and Windows' dark themes use, so the panel sits in a host
        without a tint of its own; blue only for what acts. Every template uses these keys through DynamicResource.
    -->
    <SolidColorBrush x:Key="Fadenstack.Background" Color="#1F1F1F" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Surface" Color="#292929" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.SurfaceAlt" Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Border" Color="#454545" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Foreground" Color="#F2F2F2" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ForegroundMuted" Color="#ABABAB" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Accent" Color="#2B7CD3" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentHover" Color="#3B8DE0" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AccentForeground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Hover" Color="#333333" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Pressed" Color="#3D3D3D" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Link" Color="#6AA8F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Danger" Color="#F1707B" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Warning" Color="#E8B341" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Success" Color="#6CCB5F" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.CodeBackground" Color="#262626" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.CodeInlineBackground" Color="#383838" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.UserBubble" Color="#2D3B4E" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.InfoBackground" Color="#22324A" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.WarningBackground" Color="#3B3220" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.BlockedBackground" Color="#3E2427" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.AddedBackground" Color="#213A26" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.RemovedBackground" Color="#3E2427" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Focus" Color="#6AA8F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Scrim" Color="#66000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ScrollThumb" Color="#5C5C5C" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.ScrollThumbHover" Color="#808080" po:Freeze="True" />
    <!-- The agent avatar (AgentAvatar): paper plates, the rose thread plate, the hollow under the lid. -->
    <SolidColorBrush x:Key="Fadenstack.Avatar.PlateTop" Color="#F3F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.PlateSide" Color="#AEB7C6" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.Thread" Color="#FF4D6D" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.ThreadSide" Color="#C21E48" po:Freeze="True" />
    <SolidColorBrush x:Key="Fadenstack.Avatar.Hollow" Color="#8C0A0E1A" po:Freeze="True" />
    <FontFamily x:Key="Fadenstack.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Fadenstack.CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Fadenstack.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
