<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Fadenstack.UI.ViewModels;assembly=Fadenstack.UI"
             xmlns:parts="clr-namespace:Fadenstack.UI.Parts;assembly=Fadenstack.UI"
             xmlns:m="clr-namespace:Fadenstack.Models;assembly=Fadenstack.Client"
             xmlns:b="clr-namespace:Fadenstack.UI.Avalonia.Behaviors"
             xmlns:v="clr-namespace:Fadenstack.UI.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="480" d:DesignHeight="720"
             x:Class="Fadenstack.UI.Avalonia.Views.ChatView"
             x:DataType="vm:AgentChatViewModel"
             FontSize="13">
    <!--
        The chat panel: header (agent, tool mode, history, new chat), the conversation (virtualized turns), the
        composer. Binds to an AgentChatViewModel; it has no logic of its own. The turns are the virtualization unit
        (one page of cache each way); StickToBottom, LoadEarlier and FarContent on the scroll viewer keep a session of
        thousands of turns light. Every part of a turn is a plain element with a class: Chat.axaml styles it.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Fadenstack.UI.Avalonia/Themes/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.Styles>
        <StyleInclude Source="avares://Fadenstack.UI.Avalonia/Themes/Chat.axaml" />
        <StyleInclude Source="avares://Fadenstack.UI.Avalonia/Themes/Parts.axaml" />
    </UserControl.Styles>
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewChatCommand}" />
    </UserControl.KeyBindings>

    <UserControl.DataTemplates>
        <!-- ===== Answer parts ============================================================================== -->

        <DataTemplate DataType="parts:MarkdownPart">
            <v:MarkdownView Blocks="{Binding Blocks}" CopyCommand="{Binding CopyCodeCommand}" />
        </DataTemplate>

        <DataTemplate DataType="parts:ReasoningPart">
            <StackPanel Margin="0,0,0,8">
                <Button Classes="ghost" Command="{Binding ToggleCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="spinner" Classes.running="{Binding IsStreaming}" IsVisible="{Binding IsStreaming}" />
                        <TextBlock Classes="muted" Text="{Binding Title}" />
                        <Path Classes="icon small muted chevron" Classes.open="{Binding IsExpanded}" />
                    </StackPanel>
                </Button>
                <Border Classes="reasoning" IsVisible="{Binding IsExpanded}">
                    <SelectableTextBlock Text="{Binding Text}" TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="parts:ToolCallPart">
            <StackPanel Margin="0,1,0,3">
                <!-- The line: the title wraps in a narrow pane, so the class, the duration and the chevron stay in view. -->
                <Button Classes="ghost" Command="{Binding ToggleCommand}" HorizontalAlignment="Left" ToolTip.Tip="{Binding SourceLabel}">
                    <DockPanel>
                        <Panel DockPanel.Dock="Left" Width="16" Height="16" VerticalAlignment="Center">
                            <Path Classes="spinner" Classes.running="{Binding IsRunning}" IsVisible="{Binding IsRunning}" />
                            <Path Classes="icon mark" IsVisible="{Binding !IsRunning}"
                                  Classes.failed="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:ToolCallState.Failed}}"
                                  Classes.denied="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:ToolCallState.Denied}}"
                                  Classes.cancelled="{Binding State, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:ToolCallState.Cancelled}}" />
                        </Panel>
                        <Path DockPanel.Dock="Right" Classes="icon small muted chevron" Classes.open="{Binding IsExpanded}" Margin="8,0,0,0"
                              IsVisible="{Binding HasDetails}" />
                        <TextBlock DockPanel.Dock="Right" Classes="muted" Margin="8,0,0,0" Text="{Binding DurationText}" />
                        <Border DockPanel.Dock="Right" Classes="badge">
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding ClassLabel}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                </Button>
                <!-- What the tool showed the agent (a rendered slide): small, under its line, decoded at that size. -->
                <Border Classes="picture" IsVisible="{Binding HasPicture}">
                    <Image b:PictureSource.Data="{Binding Picture}" b:PictureSource.Width="240" Stretch="Uniform" />
                </Border>
                <Border Classes="card details" IsVisible="{Binding IsExpanded}">
                    <StackPanel>
                        <StackPanel IsVisible="{Binding ArgumentsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="muted" Text="{v:Text Arguments}" Margin="0,0,0,2" />
                            <SelectableTextBlock Classes="mono" Text="{Binding ArgumentsText}" Margin="0,0,0,8" />
                        </StackPanel>
                        <StackPanel IsVisible="{Binding ResultText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <TextBlock Classes="muted" Text="{v:Text Result}" Margin="0,0,0,2" />
                            <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                                <SelectableTextBlock Classes="mono" Text="{Binding ResultText}" />
                            </ScrollViewer>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- The approval card: answered in place, like Copilot's "Allow" / "Deny". -->
        <DataTemplate DataType="parts:ApprovalPart">
            <Border Classes="card approval" Classes.destructive="{Binding IsDestructive}" Classes.answered="{Binding !IsPending}">
                <StackPanel>
                    <DockPanel>
                        <Path DockPanel.Dock="Left" Classes="icon glyph" Margin="0,0,10,0" />
                        <Border DockPanel.Dock="Right" Classes="badge">
                            <TextBlock Classes="muted" FontSize="11" Text="{Binding ClassLabel}" />
                        </Border>
                        <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" TextWrapping="Wrap" />
                    </DockPanel>
                    <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Fadenstack.ForegroundMuted}"
                               IsVisible="{Binding Reason, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <!-- What the call acts on, as the tool says it: button "Send" on mail.example.com -->
                    <TextBlock Text="{Binding Target}" TextWrapping="Wrap" Margin="0,8,0,0" FontWeight="SemiBold"
                               IsVisible="{Binding Target, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <Border Classes="arguments" IsVisible="{Binding ArgumentsText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                        <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                            <SelectableTextBlock Classes="mono" Text="{Binding ArgumentsText}" />
                        </ScrollViewer>
                    </Border>
                    <WrapPanel Margin="0,12,0,0" IsVisible="{Binding IsPending}">
                        <!-- One split button: the main part allows once; the drop-down lists only the choices the request offers. -->
                        <SplitButton Classes="allow" Margin="0,0,8,6" Content="{v:Text Allow}" Command="{Binding AllowCommand}"
                                     AutomationProperties.Name="{v:Text Allow}" IsVisible="{Binding HasAllowChoices}">
                            <SplitButton.Flyout>
                                <MenuFlyout Placement="BottomEdgeAlignedLeft">
                                    <MenuItem Header="{v:Text AllowForChat}" Command="{Binding AllowForSessionCommand}" IsVisible="{Binding CanAllowForSession}" />
                                    <MenuItem Header="{v:Text AllowForTime}" Command="{Binding AllowForTimeCommand}" IsVisible="{Binding CanAllowForTime}" />
                                    <MenuItem Header="{v:Text AllowAlways}" Command="{Binding AllowAlwaysCommand}" IsVisible="{Binding CanAllowAlways}" />
                                </MenuFlyout>
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button Classes="primary" Margin="0,0,8,6" Content="{v:Text Allow}" Command="{Binding AllowCommand}"
                                IsVisible="{Binding !HasAllowChoices}" />
                        <Button Classes="secondary" Margin="0,0,8,6" Content="{v:Text Deny}" Command="{Binding DenyCommand}" />
                    </WrapPanel>
                    <TextBlock Classes="muted" Margin="0,8,0,0" Text="{Binding StateText}" IsVisible="{Binding !IsPending}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="parts:NoticePart">
            <Border Classes="notice"
                    Classes.warning="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:NoticeSeverity.Warning}}"
                    Classes.blocked="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:NoticeSeverity.Blocked}}"
                    Classes.error="{Binding Severity, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:NoticeSeverity.Error}}">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                    <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0"
                               IsVisible="{Binding Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="parts:CitationsPart">
            <StackPanel Margin="0,0,0,6">
                <Button Classes="ghost" Command="{Binding ToggleCommand}" HorizontalAlignment="Left">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon muted" Data="{StaticResource Fadenstack.Icon.Document}" />
                        <TextBlock Classes="muted" Text="{Binding Title}" />
                        <Path Classes="icon small muted chevron" Classes.open="{Binding IsExpanded}" />
                    </StackPanel>
                </Button>
                <ItemsControl ItemsSource="{Binding Citations}" Focusable="False" Margin="30,2,0,4" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="parts:Citation">
                            <StackPanel Orientation="Horizontal" Margin="0,1" Spacing="8">
                                <TextBlock Text="{Binding Title}" />
                                <TextBlock Classes="muted" Text="{Binding Detail}" />
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="parts:CardPart">
            <Border Classes="card" HorizontalAlignment="Left" MinWidth="280">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                    <TextBlock Classes="muted" Text="{Binding Subtitle}" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="parts:CardField">
                                <Grid Margin="0,2" ColumnDefinitions="Auto,*">
                                    <TextBlock Classes="muted" Text="{Binding Label}" Margin="0,0,16,0" />
                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate DataType="parts:TablePart">
            <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4"
                           IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Border Classes="table">
                    <StackPanel>
                        <Border Classes="table-head">
                            <ItemsControl ItemsSource="{Binding Headers}" Focusable="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <TextBlock Text="{Binding}" FontWeight="SemiBold" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:Object">
                                    <Border Classes="table-cell">
                                        <ItemsControl ItemsSource="{ReflectionBinding}" Focusable="False">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Rows="1" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="x:String">
                                                    <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="parts:ProgressPart">
            <StackPanel Margin="0,4,0,8" MaxWidth="360" HorizontalAlignment="Left">
                <TextBlock Classes="muted" Text="{Binding Label}" Margin="0,0,0,4" />
                <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Value, Mode=OneWay, TargetNullValue=0}"
                             IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate DataType="parts:DiffPart">
            <StackPanel Margin="0,4,0,8">
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
                <Border Classes="table" Padding="0,4">
                    <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="parts:DiffLine">
                                <Border Classes="diff" Padding="10,0"
                                        Classes.added="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:DiffLineKind.Added}}"
                                        Classes.removed="{Binding Kind, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static parts:DiffLineKind.Removed}}">
                                    <TextBlock Classes="mono" Text="{Binding Text}" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- ===== A turn: the user's message, then the answer =============================================== -->

        <DataTemplate DataType="vm:TurnViewModel">
            <StackPanel Margin="20,14,20,6">
                <Border Classes="bubble" Classes.blocked="{Binding IsPromptBlocked}">
                    <SelectableTextBlock Text="{Binding UserText}" TextWrapping="Wrap" LineHeight="20" />
                </Border>
                <!-- What went with the message: a skill (marked), a picture (small), context -->
                <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False" HorizontalAlignment="Right" Margin="0,4,0,0"
                              IsVisible="{Binding HasAttachments}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AttachmentChip">
                            <Border Classes="chip" Padding="6,1" Margin="4,0,0,0" ToolTip.Tip="{Binding Subtitle}">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <Border Classes="thumb" IsVisible="{Binding HasImage}">
                                        <Image b:PictureSource.Data="{Binding Image}" b:PictureSource.Width="14" Stretch="UniformToFill" />
                                    </Border>
                                    <Path Classes="icon small accent" Data="{StaticResource Fadenstack.Icon.Skill}" IsVisible="{Binding IsSkill}" />
                                    <TextBlock Classes="muted" FontSize="11" Text="{Binding Title}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0" Spacing="6" IsVisible="{Binding IsPromptBlocked}">
                    <TextBlock Classes="muted" Text="{v:Text NotSent}" Foreground="{DynamicResource Fadenstack.Danger}" />
                    <Button Classes="link" Command="{Binding EditCommand}" Content="{v:Text EditAndResend}" />
                </StackPanel>

                <TextBlock Classes="agent" Text="{Binding $parent[v:ChatView].((vm:AgentChatViewModel)DataContext).Title}" />

                <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" Margin="30,0,0,0" />

                <StackPanel Orientation="Horizontal" Margin="30,2,0,0" Spacing="8"
                            IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Path Classes="spinner" Classes.running="{Binding IsRunning}" IsVisible="{Binding IsRunning}" />
                    <TextBlock Classes="muted" Text="{Binding StatusText}" />
                </StackPanel>

                <TextBlock Margin="30,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Fadenstack.Danger}" Text="{Binding ErrorMessage}"
                           IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

                <StackPanel Orientation="Horizontal" Margin="26,2,0,0" IsVisible="{Binding !IsRunning}">
                    <Button Classes="ghost hidedisabled" Command="{Binding CopyCommand}" ToolTip.Tip="{v:Text Copy}">
                        <Path Classes="icon muted" Data="{StaticResource Fadenstack.Icon.Copy}" />
                    </Button>
                    <Button Classes="ghost hidedisabled" Command="{Binding RetryCommand}" ToolTip.Tip="{v:Text Retry}">
                        <Path Classes="icon muted" Data="{StaticResource Fadenstack.Icon.Retry}" />
                    </Button>
                    <TextBlock Classes="muted" FontSize="11" Margin="8,0,0,0" Text="{Binding DurationText}" />
                    <TextBlock Classes="muted" FontSize="11" Margin="8,0,0,0" Text="{Binding UsageText}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>

        <!-- A mode in the mode menu: label and what it means. -->
        <DataTemplate DataType="vm:ToolModeOption">
            <StackPanel Margin="2,2,12,2">
                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="260" />
            </StackPanel>
        </DataTemplate>
    </UserControl.DataTemplates>

    <ThemeVariantScope Name="Scope">
    <Grid RowDefinitions="Auto,*,Auto,Auto" Background="{DynamicResource Fadenstack.Background}" TextElement.Foreground="{DynamicResource Fadenstack.Foreground}">
        <!-- Header -->
        <Border Classes="header">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="4">
                    <ToggleButton Name="ModeButton" Classes="ghost" ToolTip.Tip="{Binding ToolModeHint}"
                                  IsChecked="{Binding IsModeMenuOpen, Mode=TwoWay}" IsEnabled="{Binding IsReady}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Path Classes="icon" Data="{StaticResource Fadenstack.Icon.Shield}" />
                            <TextBlock Text="{Binding SelectedToolMode.Label}" VerticalAlignment="Center" />
                            <Path Classes="icon small" Data="{StaticResource Fadenstack.Icon.ChevronDown}" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup IsOpen="{Binding IsModeMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding #ModeButton}"
                           Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #ModeButton}">
                        <Border Classes="menu">
                            <StackPanel>
                                <TextBlock Classes="muted" Text="{v:Text ToolModeMenu}" Margin="8,4,8,4" />
                                <ItemsControl ItemsSource="{Binding ToolModes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="vm:ToolModeOption">
                                            <Button Classes="ghost" HorizontalContentAlignment="Left" Padding="8,6" Content="{Binding}"
                                                    Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).SelectToolModeCommand}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Classes="muted" Text="{Binding ToolModeHint}" TextWrapping="Wrap" MaxWidth="280" Margin="8,6,8,4" />
                                <Border Classes="separator" />
                                <Button Classes="ghost" HorizontalContentAlignment="Left" Padding="8,6"
                                        Command="{Binding ResetApprovalsCommand}" Content="{v:Text ResetApprovals}" ToolTip.Tip="{v:Text ResetApprovalsHint}" />
                            </StackPanel>
                        </Border>
                    </Popup>

                    <ToggleButton Name="HistoryButton" Classes="ghost" ToolTip.Tip="{v:Text History}" AutomationProperties.Name="{v:Text History}"
                                  IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}">
                        <Path Classes="icon" Data="{StaticResource Fadenstack.Icon.History}" />
                    </ToggleButton>
                    <Button Classes="ghost" ToolTip.Tip="{v:Text NewChatShortcut}" AutomationProperties.Name="{v:Text NewChat}" Command="{Binding NewChatCommand}">
                        <Path Classes="icon" Data="{StaticResource Fadenstack.Icon.Plus}" />
                    </Button>
                    <ToggleButton Name="SettingsButton" Classes="ghost" ToolTip.Tip="{v:Text Settings}" AutomationProperties.Name="{v:Text Settings}"
                                  IsChecked="{Binding IsSettingsOpen, Mode=TwoWay}">
                        <Path Classes="icon" Data="{StaticResource Fadenstack.Icon.Menu}" />
                    </ToggleButton>
                    <!-- The settings: the language, the host's own items (SettingsContent), and About last. Always shown. -->
                    <Popup IsOpen="{Binding IsSettingsOpen, Mode=TwoWay}" PlacementTarget="{Binding #SettingsButton}"
                           Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="True" OverlayInputPassThroughElement="{Binding #SettingsButton}">
                        <Border Classes="menu" MinWidth="220">
                            <StackPanel>
                                <StackPanel IsVisible="{Binding HasLanguageSettings}">
                                    <TextBlock Classes="muted" Text="{v:Text LanguageMenu}" Margin="8,4,8,4" />
                                    <ItemsControl ItemsSource="{Binding LanguageOptions}" Focusable="False">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:LanguageOption">
                                                <Button Classes="ghost" HorizontalContentAlignment="Left" Padding="8,6" AutomationProperties.Name="{Binding Label}"
                                                        Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).SetLanguageCommand}"
                                                        CommandParameter="{Binding Id}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Panel Width="20">
                                                            <Path Classes="icon accent" Data="{StaticResource Fadenstack.Icon.Check}" IsVisible="{Binding IsSelected}" />
                                                        </Panel>
                                                        <TextBlock Text="{Binding Label}" />
                                                    </StackPanel>
                                                </Button>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Classes="muted" Text="{v:Text LanguageLocked}" Margin="8,4,8,4" IsVisible="{Binding IsLanguageLocked}" />
                                    <Border Classes="separator" />
                                </StackPanel>
                                <ContentPresenter Content="{Binding $parent[v:ChatView].SettingsContent}" />
                                <Button Classes="ghost" HorizontalContentAlignment="Left" Padding="8,6" Command="{Binding OpenAboutCommand}"
                                        AutomationProperties.Name="{v:Text About}">
                                    <StackPanel Orientation="Horizontal">
                                        <Panel Width="20">
                                            <Path Classes="icon muted" Data="{StaticResource Fadenstack.Icon.Info}" />
                                        </Panel>
                                        <TextBlock Text="{v:Text About}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>
                    </Popup>
                </StackPanel>
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Conversation -->
        <Grid Grid.Row="1">
            <!-- Empty chat: the agent's greeting and suggestions -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24" IsVisible="{Binding IsEmpty}">
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding Greeting}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Fadenstack.ForegroundMuted}" />
                <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Button Classes="ghost suggestion" HorizontalContentAlignment="Left" HorizontalAlignment="Stretch" Padding="12,8" Margin="0,3"
                                    Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).SendSuggestionCommand}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The turns: virtualized and recycled, one page of cache each way, kept at the bottom while the user is there -->
            <ItemsControl Name="Turns" ItemsSource="{Binding Turns}" Focusable="False" IsVisible="{Binding !IsEmpty}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <v:TurnStackPanel CacheLength="0.5" EndPadding="12" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate>
                        <Grid x:DataType="vm:AgentChatViewModel">
                            <ScrollViewer Name="Scroller" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False"
                                          b:StickToBottom.IsEnabled="True" b:FarContent.Distance="100" b:LoadEarlier.Command="{Binding LoadEarlierCommand}">
                                <ItemsPresenter Name="PART_ItemsPresenter" ItemsPanel="{TemplateBinding ItemsPanel}" />
                            </ScrollViewer>
                            <Button Classes="ghost floating" VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Command="{Binding LoadEarlierCommand}" IsVisible="{Binding HasEarlierTurns}">
                                <TextBlock Classes="muted" Text="{v:Text ShowEarlier}" />
                            </Button>
                            <!-- Not at the end any more: one press goes back and follows it again. -->
                            <Button Classes="ghost floating" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,12"
                                    Command="{x:Static b:StickToBottom.ScrollToNewestCommand}" CommandParameter="{Binding #Scroller}"
                                    IsVisible="{Binding !#Scroller.(b:StickToBottom.IsFollowing)}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Path Classes="icon small" Data="{StaticResource Fadenstack.Icon.ArrowDown}" />
                                    <TextBlock Classes="muted" Text="{v:Text JumpToNewest}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>

            <Border Classes="notice blocked" VerticalAlignment="Top" Margin="12" IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Classes="secondary" Content="{v:Text Retry}" Command="{Binding InitializeCommand}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>

            <!-- About (the settings' last item): the agent, the app it runs in, the SDK, the server, and links. -->
            <Border Classes="menu about" VerticalAlignment="Top" Margin="8,4,8,8" Padding="11,6,6,12" IsVisible="{Binding IsAboutOpen}"
                    AutomationProperties.Name="{v:Text About}">
                <Border.KeyBindings>
                    <KeyBinding Gesture="Escape" Command="{Binding CloseAboutCommand}" />
                </Border.KeyBindings>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="3,0,0,6">
                        <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding CloseAboutCommand}" ToolTip.Tip="{v:Text Close}"
                                AutomationProperties.Name="{v:Text Close}">
                            <Path Classes="icon small" Data="{StaticResource Fadenstack.Icon.Close}" />
                        </Button>
                        <TextBlock Text="{v:Text About}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                        <StackPanel Margin="3,0,8,0">
                            <StackPanel Margin="0,0,0,10" IsVisible="{Binding About.HasAgent}">
                                <TextBlock Text="{Binding About.AgentName}" FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" />
                                <TextBlock Classes="muted" Text="{Binding About.AgentDetail}" TextWrapping="Wrap"
                                           IsVisible="{Binding About.AgentDetail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <TextBlock Classes="muted" Text="{Binding About.AppText}" TextWrapping="Wrap" Margin="0,0,0,3"
                                       IsVisible="{Binding About.AppText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock Classes="muted" Text="{Binding About.SdkText}" TextWrapping="Wrap" Margin="0,0,0,3" />
                            <TextBlock Classes="muted" Text="{Binding About.ServerText}" TextWrapping="Wrap"
                                       IsVisible="{Binding About.ServerText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <Border Classes="separator" Margin="0,10,0,6" />
                            <ItemsControl ItemsSource="{Binding About.Links}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="vm:PanelLink">
                                        <Button Classes="link" Margin="0,2" HorizontalAlignment="Left" ToolTip.Tip="{Binding Url.AbsoluteUri}"
                                                AutomationProperties.Name="{Binding Name}" Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).OpenLinkCommand}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Classes="secondary" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding CopyDetailsCommand}"
                                    Content="{v:Text CopyDetails}" />
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- The chats: a dropdown under the header, as wide as the panel -->
            <Border Classes="menu history" VerticalAlignment="Top" Margin="8,4,8,8" MaxHeight="440" IsVisible="{Binding IsHistoryOpen}">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,2,0,4">
                        <Button DockPanel.Dock="Right" Classes="ghost" Command="{Binding NewChatCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Path Classes="icon small" Data="{StaticResource Fadenstack.Icon.Plus}" />
                                <TextBlock Text="{v:Text NewChat}" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="{v:Text History}" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Classes="muted" Text="{v:Text NoHistory}" Margin="8,4,8,8" IsVisible="{Binding Sessions.Count, Converter={x:Static v:Counts.None}}" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate>
                                <ScrollViewer Focusable="False" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter ItemsPanel="{TemplateBinding ItemsPanel}" />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:SessionItemViewModel">
                                <Panel Margin="0,1">
                                    <Button Classes="ghost" Classes.current="{Binding IsCurrent}" HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"
                                            Padding="10,6,34,6" AutomationProperties.Name="{Binding Title}"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).OpenSessionCommand}"
                                            CommandParameter="{Binding}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Classes="muted" FontSize="11" Text="{Binding WhenText}" Margin="8,0,0,0" />
                                            <TextBlock Classes.title="{Binding IsCurrent}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Button Classes="ghost" HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip.Tip="{v:Text DeleteSession}"
                                            AutomationProperties.Name="{v:Text DeleteSession}"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).DeleteSessionCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Classes="icon small muted" Data="{StaticResource Fadenstack.Icon.Close}" />
                                    </Button>
                                </Panel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Composer -->
        <Border Name="ComposerBox" Grid.Row="2" Classes="composer">
            <StackPanel>
                <!-- The skills picked for the next message -->
                <ItemsControl ItemsSource="{Binding PickedSkills}" Focusable="False" Margin="0,0,0,6" IsVisible="{Binding PickedSkills.Count, Converter={x:Static v:Counts.Any}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="m:SkillOption">
                            <Border Classes="chip filled" ToolTip.Tip="{Binding Description}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Path Classes="icon small accent" Data="{StaticResource Fadenstack.Icon.Skill}" />
                                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis" FontSize="12" />
                                    <TextBlock Classes="muted" FontSize="11" Text="{v:Text Skill}" Margin="2,0,0,0" />
                                    <Button Classes="ghost" Padding="3" ToolTip.Tip="{v:Text RemoveAttachment}" AutomationProperties.Name="{v:Text RemoveAttachment}"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).RemoveSkillCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Classes="icon small" Data="{StaticResource Fadenstack.Icon.Close}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <!-- Attached context: chips, a picture's small; an implicit one (the current selection) can be switched off -->
                <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False" Margin="0,0,0,6" IsVisible="{Binding Attachments.Count, Converter={x:Static v:Counts.Any}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="vm:AttachmentViewModel">
                            <Border Classes="chip filled" Classes.excluded="{Binding !IsIncluded}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <Button Classes="ghost" Padding="2" Command="{Binding ToggleCommand}" ToolTip.Tip="{v:Text IncludeAttachment}"
                                            IsVisible="{Binding IsImplicit}">
                                        <Path Classes="icon small muted" Data="{StaticResource Fadenstack.Icon.Check}" />
                                    </Button>
                                    <Border Classes="thumb" IsVisible="{Binding HasImage}">
                                        <Image b:PictureSource.Data="{Binding Image}" b:PictureSource.Width="16" Stretch="UniformToFill" />
                                    </Border>
                                    <Path Classes="icon small muted" Data="{StaticResource Fadenstack.Icon.Document}" IsVisible="{Binding !IsImplicit}" />
                                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                               ToolTip.Tip="{Binding Subtitle}" FontSize="12" />
                                    <Button Classes="ghost" Padding="3" ToolTip.Tip="{v:Text RemoveAttachment}" IsVisible="{Binding !IsImplicit}"
                                            Command="{Binding $parent[ItemsControl].((vm:AgentChatViewModel)DataContext).RemoveAttachmentCommand}"
                                            CommandParameter="{Binding}">
                                        <Path Classes="icon small" Data="{StaticResource Fadenstack.Icon.Close}" />
                                    </Button>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox Name="Composer" Classes="composer" Text="{Binding Input, Mode=TwoWay}" IsEnabled="{Binding IsReady}"
                         PlaceholderText="{v:Text ComposerPlaceholder}" AutomationProperties.Name="{v:Text Message}" />
                <DockPanel Margin="0,6,0,0">
                    <Panel DockPanel.Dock="Right">
                        <Button Classes="primary" Padding="8,5" ToolTip.Tip="{v:Text SendShortcut}" AutomationProperties.Name="{v:Text Send}"
                                Command="{Binding SendCommand}" IsVisible="{Binding !IsBusy}">
                            <Path Classes="icon onaccent" Data="{StaticResource Fadenstack.Icon.Send}" />
                        </Button>
                        <Button Classes="secondary" Padding="8,5" ToolTip.Tip="{v:Text StopShortcut}" AutomationProperties.Name="{v:Text Stop}"
                                Command="{Binding StopCommand}" IsVisible="{Binding IsBusy}">
                            <Path Classes="icon" Data="{StaticResource Fadenstack.Icon.Stop}" />
                        </Button>
                    </Panel>
                    <!-- A host's own buttons (e.g. "Add context") -->
                    <ContentPresenter DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Content="{Binding $parent[v:ChatView].ComposerToolbar}" />
                    <TextBlock Classes="muted" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SelectedToolMode.Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedToolMode.Description, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Under the composer: answers come from an AI and can be wrong. Quiet, but always there; a host's empty text hides it. -->
        <StackPanel Grid.Row="3" Margin="12,-8,12,8">
            <TextBlock Classes="muted" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Text="{Binding Strings.AiNotice}"
                       AutomationProperties.Name="{Binding Strings.AiNotice}"
                       IsVisible="{Binding Strings.AiNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            <Button Classes="link muted" HorizontalAlignment="Center" IsVisible="{Binding BrandingLink, Converter={x:Static ObjectConverters.IsNotNull}}"
                    Command="{Binding OpenLinkCommand}" CommandParameter="{Binding BrandingLink}" Content="{Binding BrandingLink.Label}"
                    ToolTip.Tip="{Binding BrandingLink.Url.AbsoluteUri}" AutomationProperties.Name="{Binding BrandingLink.Name}" />
        </StackPanel>
    </Grid>
    </ThemeVariantScope>
</UserControl>
