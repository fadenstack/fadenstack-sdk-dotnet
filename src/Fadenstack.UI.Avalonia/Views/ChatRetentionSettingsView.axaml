<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:st="clr-namespace:Fadenstack.UI.Settings;assembly=Fadenstack.UI"
             xmlns:b="clr-namespace:Fadenstack.UI.Avalonia.Behaviors"
             xmlns:v="clr-namespace:Fadenstack.UI.Avalonia.Views"
             mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="360"
             x:Class="Fadenstack.UI.Avalonia.Views.ChatRetentionSettingsView"
             x:DataType="st:ChatRetentionSettingsViewModel"
             Focusable="True"
             FontSize="{DynamicResource Fadenstack.FontSize.Body}"
             Foreground="{DynamicResource Fadenstack.Foreground}">
    <!--
        The setting for old chats: a ChatRetentionSettingsViewModel. In standalone the person switches automatic deletion on or off, types the
        two limits (days, chats) and presses Save; where the organisation decides (governed) or the machine policy fixes it, the values are
        shown (or one sentence) and cannot be changed. Every text is a UiStrings text; every look is a style class of the skin's.
    -->
    <UserControl.Styles>
        <StyleInclude Source="avares://Fadenstack.UI.Avalonia/Themes/Forms.axaml" />
    </UserControl.Styles>

    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel Name="Column" MaxWidth="480" HorizontalAlignment="Stretch" Margin="12" Spacing="8">
            <TextBlock Classes="title" Text="{v:Text ChatRetentionTitle}" TextWrapping="Wrap" />

            <!-- Who decides, when it is not the person. -->
            <Border Name="NoteBanner" Classes="banner" IsVisible="{Binding ShowNote}">
                <TextBlock Name="NoteText" Text="{Binding Note}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>

            <StackPanel Name="Controls" Spacing="8" IsVisible="{Binding ShowControls}">
                <CheckBox Name="AutoDeleteBox" b:WizardFocus.IsFirst="True" IsChecked="{Binding AutoDelete, Mode=TwoWay}" IsEnabled="{Binding CanEdit}"
                          Content="{v:Text ChatRetentionAutoDelete}" AutomationProperties.Name="{v:Text ChatRetentionAutoDelete}" />
                <TextBlock Classes="caption muted" Text="{v:Text ChatRetentionAutoDeleteHint}" TextWrapping="Wrap" />

                <StackPanel Spacing="4">
                    <TextBlock Classes="strong" Text="{v:Text ChatRetentionMaxAge}" TextWrapping="Wrap" />
                    <TextBox Name="DaysBox" Text="{Binding MaxAgeDaysText, Mode=TwoWay}" IsEnabled="{Binding LimitsEnabled}"
                             AutomationProperties.Name="{v:Text ChatRetentionMaxAgeName}" />
                    <TextBlock Name="DaysErrorText" Classes="caption muted" Text="{Binding DaysError}" TextWrapping="Wrap" IsVisible="{Binding HasDaysError}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="strong" Text="{v:Text ChatRetentionMaxSessions}" TextWrapping="Wrap" />
                    <TextBox Name="ChatsBox" Text="{Binding MaxSessionsText, Mode=TwoWay}" IsEnabled="{Binding LimitsEnabled}"
                             AutomationProperties.Name="{v:Text ChatRetentionMaxSessionsName}" />
                    <TextBlock Name="ChatsErrorText" Classes="caption muted" Text="{Binding ChatsError}" TextWrapping="Wrap" IsVisible="{Binding HasChatsError}"
                               AutomationProperties.LiveSetting="Assertive" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding CanEdit}">
                    <Button Name="SaveButton" Classes="primary" b:WizardFocus.IsPrimary="True" Command="{Binding SaveCommand}"
                            Content="{v:Text ChatRetentionSave}" AutomationProperties.Name="{v:Text ChatRetentionSaveName}" />
                    <Button Name="CancelButton" Classes="secondary" Command="{Binding CancelCommand}"
                            Content="{v:Text ChatRetentionCancel}" AutomationProperties.Name="{v:Text ChatRetentionCancelName}" />
                </StackPanel>
                <TextBlock Name="StatusLine" Classes="caption muted" Text="{Binding StatusText}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
