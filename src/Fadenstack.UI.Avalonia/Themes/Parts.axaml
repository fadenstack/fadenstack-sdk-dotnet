<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="using:Fadenstack.UI.Avalonia.Controls">
    <!--
        A turn and its parts (design 22, section 6.6), by class: ChatView.axaml puts the classes on plain elements. A state is
        a class the view model's property switches on (blocked, failed, destructive, answered ...), never a template of its own.
        No shadows or effects: a long chat draws hundreds of these. Only theme keys.
    -->

    <!-- ===== A turn: at most 760 wide for reading, centred when the chat is wide ======================== -->

    <Style Selector="StackPanel.turn">
        <Setter Property="Margin" Value="16,12,16,0" />
        <Setter Property="MaxWidth" Value="760" />
        <Setter Property="Spacing" Value="4" />
    </Style>

    <!-- The user's message: right, the accent with its text colour, corners 12 4 12 12, at most 75 % (85 % below 480 px). -->
    <Style Selector="Border.bubble">
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.bubble.user">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="MaxWidth" Value="{DynamicResource Fadenstack.Chat.UserBubble.MaxWidth}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Fadenstack.Radius.Bubble.User}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Accent}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Accent}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.AccentForeground}" />
    </Style>
    <Style Selector="SelectableTextBlock.user">
        <Setter Property="LineHeight" Value="{DynamicResource Fadenstack.LineHeight.Body}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Fadenstack.SplitDivider}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Fadenstack.AccentForeground}" />
    </Style>
    <!-- Not sent: the message stays, on the surface with the danger outline. -->
    <Style Selector="Border.bubble.user.blocked">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Danger}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
    <Style Selector="Border.bubble.user.blocked SelectableTextBlock.user">
        <Setter Property="SelectionBrush" Value="{DynamicResource Fadenstack.Accent}" />
    </Style>
    <Style Selector="StackPanel.blocked">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="4" />
    </Style>
    <Style Selector="TextBlock.danger">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.DangerText}" />
    </Style>
    <Style Selector="ItemsControl.sent">
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style Selector="ItemsControl.sent > ContentPresenter">
        <Setter Property="Margin" Value="6,0,0,0" />
    </Style>

    <!-- The agent's answer: left, AgentBubble with the 1 px line, corners 4 12 12 12. -->
    <Style Selector="Border.bubble.agent">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,8,0,0" />
        <Setter Property="CornerRadius" Value="{DynamicResource Fadenstack.Radius.Bubble.Agent}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.AgentBubble}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
    </Style>
    <Style Selector="StackPanel.answer">
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="ItemsControl.parts > ContentPresenter">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="ItemsControl.parts > ContentPresenter:nth-last-child(1)">
        <Setter Property="Margin" Value="0" />
    </Style>
    <Style Selector="StackPanel.status">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="8" />
    </Style>
    <Style Selector="Border.banner.turn-error">
        <Setter Property="Margin" Value="0,8,0,0" />
    </Style>
    <!-- Copy and Try again under the answer, small icon buttons; gone when they cannot run. -->
    <Style Selector="StackPanel.turn-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="Spacing" Value="4" />
        <Setter Property="Margin" Value="0,2,0,0" />
    </Style>
    <Style Selector="StackPanel.turn-actions > TextBlock">
        <Setter Property="Margin" Value="4,0,0,0" />
    </Style>
    <Style Selector="Button.hidedisabled:disabled">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <!-- ===== Icons in a turn ============================================================================= -->

    <Style Selector="Panel.mark">
        <Setter Property="Width" Value="{DynamicResource Fadenstack.Icon.Size.Small}" />
        <Setter Property="Height" Value="{DynamicResource Fadenstack.Icon.Size.Small}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Panel.mark c|FsIcon">
        <Setter Property="Size" Value="{DynamicResource Fadenstack.Icon.Size.Small}" />
    </Style>
    <Style Selector="c|FsIcon.muted">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
    </Style>
    <Style Selector="c|FsIcon.accent">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentText}" />
    </Style>
    <Style Selector="c|FsIcon.chevron">
        <Setter Property="Data" Value="{DynamicResource Icon.ChevronRight}" />
        <Setter Property="Size" Value="{DynamicResource Fadenstack.Icon.Size.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="c|FsIcon.chevron.open">
        <Setter Property="Data" Value="{DynamicResource Icon.KeyboardArrowDown}" />
    </Style>
    <!-- A tool line's state: done, failed, not run, stopped. -->
    <Style Selector="c|FsIcon.mark">
        <Setter Property="Data" Value="{DynamicResource Icon.Check}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Success}" />
    </Style>
    <Style Selector="c|FsIcon.mark.failed">
        <Setter Property="Data" Value="{DynamicResource Icon.ErrorOutline}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.DangerText}" />
    </Style>
    <Style Selector="c|FsIcon.mark.denied">
        <Setter Property="Data" Value="{DynamicResource Icon.Block}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.WarningText}" />
    </Style>
    <Style Selector="c|FsIcon.mark.cancelled">
        <Setter Property="Data" Value="{DynamicResource Icon.Stop}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
    </Style>
    <!-- A spinning arc; it turns only while its row says it runs. -->
    <Style Selector="Arc.spinner">
        <Setter Property="Width" Value="{DynamicResource Fadenstack.Icon.Size.Small}" />
        <Setter Property="Height" Value="{DynamicResource Fadenstack.Icon.Size.Small}" />
        <Setter Property="Stroke" Value="{DynamicResource Fadenstack.AccentText}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StartAngle" Value="0" />
        <Setter Property="SweepAngle" Value="270" />
        <Setter Property="Margin" Value="1" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="0" />
        </Setter>
    </Style>
    <Style Selector="Arc.spinner.running">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===== Lines that fold out: reasoning, a tool, the sources ======================================== -->

    <!-- The row's icon lines up with the text above and below it. -->
    <Style Selector="Button.row.fold">
        <Setter Property="Margin" Value="-8,0,0,0" />
    </Style>
    <Style Selector="Border.reasoning">
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="BorderThickness" Value="2,0,0,0" />
        <Setter Property="Padding" Value="12,2,0,2" />
        <Setter Property="Margin" Value="7,4,0,0" />
    </Style>
    <Style Selector="Border.details">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceSubtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Fadenstack.Radius}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="ScrollViewer.result">
        <Setter Property="MaxHeight" Value="240" />
    </Style>
    <Style Selector="Border.picture">
        <Setter Property="Margin" Value="0,4,0,0" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Width" Value="240" />
        <Setter Property="Height" Value="135" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Fadenstack.Radius}" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>
    <Style Selector="ItemsControl.citations">
        <Setter Property="Margin" Value="24,4,0,0" />
    </Style>
    <Style Selector="ItemsControl.citations > ContentPresenter">
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- ===== Cards: an approval, a module's card ======================================================== -->

    <Style Selector="Border.card.approval">
        <Setter Property="MaxWidth" Value="640" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.AccentText}" />
    </Style>
    <Style Selector="Border.card.approval.destructive">
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Warning}" />
    </Style>
    <!-- Answered: the plain line and the state say so. Not faded: muted text would fall under 4.5:1. -->
    <Style Selector="Border.card.approval.answered">
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
    </Style>
    <Style Selector="Border.approval c|FsIcon.glyph">
        <Setter Property="Data" Value="{DynamicResource Icon.Shield}" />
        <Setter Property="Size" Value="{DynamicResource Fadenstack.Icon.Size.Large}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentText}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.approval.destructive c|FsIcon.glyph">
        <Setter Property="Data" Value="{DynamicResource Icon.WarningAmber}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.WarningText}" />
    </Style>
    <Style Selector="WrapPanel.source">
        <Setter Property="ItemSpacing" Value="8" />
        <Setter Property="LineSpacing" Value="4" />
    </Style>
    <Style Selector="Border.approval c|FsIcon.source">
        <Setter Property="Data" Value="{DynamicResource Icon.Extension}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Border.arguments">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceSubtle}" />
        <Setter Property="CornerRadius" Value="{DynamicResource Fadenstack.Radius.Inner}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="ScrollViewer.arguments">
        <Setter Property="MaxHeight" Value="160" />
    </Style>
    <!-- Deny, then Allow; they wrap under each other in a narrow card. -->
    <Style Selector="WrapPanel.actions">
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>
    <Style Selector="WrapPanel.actions > Button, WrapPanel.actions > SplitButton">
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>
    <Style Selector="Border.card.part">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="240" />
    </Style>
    <Style Selector="ItemsControl.fields">
        <Setter Property="Margin" Value="0,6,0,0" />
    </Style>
    <Style Selector="Grid.field">
        <Setter Property="Margin" Value="0,2" />
    </Style>

    <!-- ===== Notices: banners in the flow; the icon says the kind ======================================= -->

    <Style Selector="Border.banner.notice c|FsIcon.status">
        <Setter Property="Data" Value="{DynamicResource Icon.InfoOutlined}" />
    </Style>
    <Style Selector="Border.banner.notice.warning c|FsIcon.status">
        <Setter Property="Data" Value="{DynamicResource Icon.WarningAmber}" />
    </Style>
    <Style Selector="Border.banner.notice.error c|FsIcon.status">
        <Setter Property="Data" Value="{DynamicResource Icon.ErrorOutline}" />
    </Style>
    <Style Selector="Border.banner.notice.blocked c|FsIcon.status">
        <Setter Property="Data" Value="{DynamicResource Icon.Block}" />
    </Style>

    <!-- ===== Progress, diffs ============================================================================ -->

    <Style Selector="StackPanel.progress">
        <Setter Property="MaxWidth" Value="360" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="Border.diff-frame">
        <Setter Property="Padding" Value="0,4" />
    </Style>
    <Style Selector="Border.diff">
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="Border.diff.added">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.AddedBackground}" />
    </Style>
    <Style Selector="Border.diff.removed">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.RemovedBackground}" />
    </Style>
</Styles>
