<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!--
        Styles for the chat, by class, so a template stays a plain element with a class and no styling of its own.
        They sit on the controls' Fluent templates (the parts named PART_*), so a host uses FluentTheme. Colours come
        from Colors.axaml. No shadows or effects here: a long chat draws hundreds of these.
    -->
    <Styles.Resources>
        <ResourceDictionary>
            <!-- Containers (composer, cards, bubbles, code, menus) use Fadenstack.Radius (12, in Colors.axaml); controls 6. -->
            <CornerRadius x:Key="Fadenstack.Radius.Control">6</CornerRadius>
            <CornerRadius x:Key="Fadenstack.Radius.Chip">8</CornerRadius>
            <FontFamily x:Key="Fadenstack.CodeFont">Cascadia Mono, Consolas, Menlo, DejaVu Sans Mono, monospace</FontFamily>

            <!-- Icons: strokes on a 16 x 16 grid (Path.icon draws them), so they need no icon font. -->
            <StreamGeometry x:Key="Fadenstack.Icon.Check">M3,8.5 L6.5,12 L13,4.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Close">M3.5,3.5 L12.5,12.5 M12.5,3.5 L3.5,12.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Plus">M8,3 L8,13 M3,8 L13,8</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.ChevronRight">M6,3.5 L10.5,8 L6,12.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.ChevronDown">M3.5,6 L8,10.5 L12.5,6</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Copy">M5.5,5.5 L13,5.5 L13,13 L5.5,13 Z M3,10.5 L3,3 L10.5,3</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Retry">M13,8 A5,5 0 1 1 11.5,4.5 M13,2.5 L13,5.5 L10,5.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Send">M8,13 L8,3 M3.5,7.5 L8,3 L12.5,7.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Stop">M4.5,4.5 L11.5,4.5 L11.5,11.5 L4.5,11.5 Z</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Menu">M2.5,4 L13.5,4 M2.5,8 L13.5,8 M2.5,12 L13.5,12</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.History">M8,2.5 A5.5,5.5 0 1 1 8,13.5 A5.5,5.5 0 1 1 8,2.5 M8,5 L8,8 L10,9.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Warning">M8,2.5 L14,13 L2,13 Z M8,6.5 L8,9.5 M8,11.2 L8,11.3</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Shield">M8,2 L13,4 L13,8 C13,11 10.5,13 8,14 C5.5,13 3,11 3,8 L3,4 Z</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Document">M4,2.5 L9,2.5 L12,5.5 L12,13.5 L4,13.5 Z M9,2.5 L9,5.5 L12,5.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Skill">M8,2 L9.2,6.8 L14,8 L9.2,9.2 L8,14 L6.8,9.2 L2,8 L6.8,6.8 Z</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Denied">M8,2.5 A5.5,5.5 0 1 1 8,13.5 A5.5,5.5 0 1 1 8,2.5 M4.1,4.1 L11.9,11.9</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Info">M8,2.5 A5.5,5.5 0 1 1 8,13.5 A5.5,5.5 0 1 1 8,2.5 M8,7 L8,11 M8,5 L8,5.1</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Arrow">M3,8 L13,8 M9,4 L13,8 L9,12</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.ArrowDown">M8,3 L8,13 M3.5,8.5 L8,13 L12.5,8.5</StreamGeometry>
            <StreamGeometry x:Key="Fadenstack.Icon.Spinner">M8,2 A6,6 0 1 1 2,8</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===== Primitives ================================================================================== -->

    <Style Selector="Path.icon">
        <Setter Property="Stroke" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="StrokeThickness" Value="1.4" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>
    <Style Selector="Path.icon.small">
        <Setter Property="Width" Value="10" />
        <Setter Property="Height" Value="10" />
    </Style>
    <Style Selector="Path.icon.muted">
        <Setter Property="Stroke" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
    </Style>
    <Style Selector="Path.icon.accent">
        <Setter Property="Stroke" Value="{DynamicResource Fadenstack.AccentIcon}" />
    </Style>
    <Style Selector="Path.icon.onaccent">
        <Setter Property="Stroke" Value="{DynamicResource Fadenstack.AccentForeground}" />
    </Style>

    <Style Selector="TextBlock.muted, SelectableTextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
        <Setter Property="FontSize" Value="{DynamicResource Fadenstack.FontSize.Small}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.mono, SelectableTextBlock.mono">
        <Setter Property="FontFamily" Value="{DynamicResource Fadenstack.CodeFont}" />
        <Setter Property="FontSize" Value="{DynamicResource Fadenstack.FontSize.Small}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- A flat button: transparent until hovered. -->
    <Style Selector="Button.ghost, ToggleButton.ghost">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Control}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Hover}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
    <Style Selector="Button.ghost:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.ghost:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
    <Style Selector="Button.ghost:disabled, ToggleButton.ghost:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.ghost:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Focus}" />
    </Style>
    <!-- A ghost button that disappears when its command cannot run (Retry, Copy). -->
    <Style Selector="Button.ghost.hidedisabled:disabled">
        <Setter Property="IsVisible" Value="False" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentForeground}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Accent}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Control}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter, Button.primary:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.AccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentForeground}" />
    </Style>
    <Style Selector="Button.primary:disabled">
        <Setter Property="Opacity" Value="0.45" />
    </Style>

    <!-- The approval card's split button ("Allow" with its drop-down): the primary look; the inner buttons read these resources. -->
    <Style Selector="SplitButton.allow">
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Control}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentForeground}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Accent}" />
    </Style>
    <Style Selector="SplitButton.allow /template/ Button">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentForeground}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Accent}" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Control}" />
    </Style>
    <Style Selector="SplitButton.allow /template/ Button:pointerover /template/ ContentPresenter#PART_ContentPresenter, SplitButton.allow /template/ Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.AccentHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.AccentForeground}" />
    </Style>

    <Style Selector="Button.secondary">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Control}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Pressed}" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>

    <!-- A link-looking button (Edit and resend). -->
    <Style Selector="Button.link">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Link}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource Fadenstack.FontSize.Small}" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Link}" />
        <Setter Property="TextBlock.TextDecorations" Value="Underline" />
    </Style>

    <Style Selector="Border.badge">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <Style Selector="Border.menu">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{DynamicResource Fadenstack.Radius}" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="0,4,0,0" />
    </Style>

    <Style Selector="Border.chip">
        <Setter Property="CornerRadius" Value="{StaticResource Fadenstack.Radius.Chip}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="Padding" Value="6,2,2,2" />
        <Setter Property="Margin" Value="0,0,6,4" />
    </Style>
    <Style Selector="Border.chip.filled">
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
    </Style>

    <!-- A spinning arc; it animates only while its row says it is running. -->
    <Style Selector="Path.spinner">
        <Setter Property="Stroke" Value="{DynamicResource Fadenstack.AccentIcon}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Data" Value="{StaticResource Fadenstack.Icon.Spinner}" />
        <Setter Property="RenderTransform">
            <RotateTransform Angle="0" />
        </Setter>
    </Style>
    <Style Selector="Path.spinner.running">
        <Style.Animations>
            <Animation Duration="0:0:0.9" IterationCount="INFINITE">
                <KeyFrame Cue="0%">
                    <Setter Property="RotateTransform.Angle" Value="0" />
                </KeyFrame>
                <KeyFrame Cue="100%">
                    <Setter Property="RotateTransform.Angle" Value="360" />
                </KeyFrame>
            </Animation>
        </Style.Animations>
    </Style>

    <!-- ===== The composer ================================================================================ -->

    <Style Selector="TextBox.composer">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0,2" />
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="MaxHeight" Value="200" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Foreground}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Fadenstack.Foreground}" />
    </Style>
    <Style Selector="TextBox.composer:pointerover /template/ Border#PART_BorderElement, TextBox.composer:focus /template/ Border#PART_BorderElement, TextBox.composer:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ===== Markdown ==================================================================================== -->

    <Style Selector="Path.icon.copy">
        <Setter Property="Data" Value="{StaticResource Fadenstack.Icon.Copy}" />
    </Style>
    <Style Selector="SelectableTextBlock.md-paragraph, TextBlock.md-paragraph">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style Selector="SelectableTextBlock.md-item, TextBlock.md-item">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
    </Style>
    <Style Selector="TextBlock.md-heading">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,6,0,8" />
    </Style>
    <Style Selector="SelectableTextBlock.md-quote">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.ForegroundMuted}" />
    </Style>
    <Style Selector="Run.code">
        <Setter Property="FontFamily" Value="{DynamicResource Fadenstack.CodeFont}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.CodeInlineBackground}" />
    </Style>
    <Style Selector="Run.link">
        <Setter Property="Foreground" Value="{DynamicResource Fadenstack.Link}" />
        <Setter Property="TextDecorations" Value="Underline" />
    </Style>
    <Style Selector="Border.table-head">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
        <Setter Property="Background" Value="{DynamicResource Fadenstack.SurfaceAlt}" />
    </Style>
    <Style Selector="Border.table-cell">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Fadenstack.Border}" />
    </Style>
</Styles>
