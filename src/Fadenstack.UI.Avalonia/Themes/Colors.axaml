            <SolidColorBrush x:Key="Fadenstack.Pressed" Color="#3381A1C1" />
            <SolidColorBrush x:Key="Fadenstack.SplitDivider" Color="#4D0A0E1A" />
            <SolidColorBrush x:Key="Fadenstack.Link" Color="#A9C0D8" />
            <SolidColorBrush x:Key="Fadenstack.Focus" Color="#A9C0D8" />
            <SolidColorBrush x:Key="Fadenstack.Danger" Color="#E53935" />
            <SolidColorBrush x:Key="Fadenstack.DangerText" Color="#EF5350" />
            <SolidColorBrush x:Key="Fadenstack.Warning" Color="#FB8C00" />
            <SolidColorBrush x:Key="Fadenstack.WarningText" Color="#FB8C00" />
            <SolidColorBrush x:Key="Fadenstack.Success" Color="#2E7D32" />
            <SolidColorBrush x:Key="Fadenstack.CodeBackground" Color="#262626" />
            <SolidColorBrush x:Key="Fadenstack.CodeInlineBackground" Color="#383838" />
            <SolidColorBrush x:Key="Fadenstack.UserBubble" Color="#1F81A1C1" />
            <SolidColorBrush x:Key="Fadenstack.AgentBubble" Color="#212121" />
            <SolidColorBrush x:Key="Fadenstack.InfoBackground" Color="#2929B6F6" />
            <SolidColorBrush x:Key="Fadenstack.WarningBackground" Color="#29FB8C00" />
            <SolidColorBrush x:Key="Fadenstack.BlockedBackground" Color="#29E53935" />
            <SolidColorBrush x:Key="Fadenstack.SuccessBackground" Color="#292E7D32" />
            <SolidColorBrush x:Key="Fadenstack.AddedBackground" Color="#292E7D32" />
            <SolidColorBrush x:Key="Fadenstack.RemovedBackground" Color="#29E53935" />
            <SolidColorBrush x:Key="Fadenstack.Scrim" Color="#80000000" />
            <SolidColorBrush x:Key="Fadenstack.ScrollThumb" Color="#669E9E9E" />
            <SolidColorBrush x:Key="Fadenstack.ScrollThumbHover" Color="#999E9E9E" />
            <SolidColorBrush x:Key="Fadenstack.BrandPlate" Color="#F3F4F6" />
            <SolidColorBrush x:Key="Fadenstack.BrandThread" Color="#FF4D6D" />
            <BoxShadows x:Key="Fadenstack.Elevation">0 8 24 0 #66000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="{x:Static svc:FadenstackTheme.HighContrastVariant}">
            <SolidColorBrush x:Key="Fadenstack.Background" Color="#000000" />
            <SolidColorBrush x:Key="Fadenstack.Surface" Color="#000000" />
            <SolidColorBrush x:Key="Fadenstack.SurfaceAlt" Color="#1A1A1A" />
            <SolidColorBrush x:Key="Fadenstack.SurfaceSubtle" Color="#1A1A1A" />
            <SolidColorBrush x:Key="Fadenstack.Border" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.BorderStrong" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.BorderHover" Color="#FFFF00" />
            <SolidColorBrush x:Key="Fadenstack.Inverse" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.InverseForeground" Color="#000000" />
            <SolidColorBrush x:Key="Fadenstack.SwitchKnob" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.Foreground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.ForegroundMuted" Color="#E6E6E6" />
            <SolidColorBrush x:Key="Fadenstack.Accent" Color="#FFFF00" />
            <SolidColorBrush x:Key="Fadenstack.AccentHover" Color="#FFD700" />
            <SolidColorBrush x:Key="Fadenstack.AccentLight" Color="#FFFF99" />
            <SolidColorBrush x:Key="Fadenstack.AccentForeground" Color="#000000" />
            <SolidColorBrush x:Key="Fadenstack.AccentText" Color="#FFFF00" />
            <SolidColorBrush x:Key="Fadenstack.AccentIcon" Color="#FFFF00" />
            <SolidColorBrush x:Key="Fadenstack.NavSelected" Color="#FFFF00" />
            <SolidColorBrush x:Key="Fadenstack.NavSelectedForeground" Color="#000000" />
            <SolidColorBrush x:Key="Fadenstack.Hover" Color="#262626" />
            <SolidColorBrush x:Key="Fadenstack.Tint" Color="#1A1A1A" />
            <SolidColorBrush x:Key="Fadenstack.Pressed" Color="#404040" />
            <SolidColorBrush x:Key="Fadenstack.SplitDivider" Color="#4D000000" />
            <SolidColorBrush x:Key="Fadenstack.Link" Color="#00FFFF" />
            <SolidColorBrush x:Key="Fadenstack.Focus" Color="#FFFF00" />
            <SolidColorBrush x:Key="Fadenstack.Danger" Color="#FF8080" />
            <SolidColorBrush x:Key="Fadenstack.DangerText" Color="#FF8080" />
            <SolidColorBrush x:Key="Fadenstack.Warning" Color="#FFB000" />
            <SolidColorBrush x:Key="Fadenstack.WarningText" Color="#FFB000" />
            <SolidColorBrush x:Key="Fadenstack.Success" Color="#4DFF88" />
            <SolidColorBrush x:Key="Fadenstack.CodeBackground" Color="#000000" />
            <SolidColorBrush x:Key="Fadenstack.CodeInlineBackground" Color="#262626" />
            <SolidColorBrush x:Key="Fadenstack.UserBubble" Color="#1A1A1A" />
            <SolidColorBrush x:Key="Fadenstack.AgentBubble" Color="#000000" />
