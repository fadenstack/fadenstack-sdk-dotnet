            <SolidColorBrush x:Key="Fadenstack.ForegroundMuted" Color="#9E9E9E" />
            <SolidColorBrush x:Key="Fadenstack.Accent" Color="#81A1C1" />
            <SolidColorBrush x:Key="Fadenstack.AccentHover" Color="#6F8FB0" />
            <SolidColorBrush x:Key="Fadenstack.AccentLight" Color="#A9C0D8" />
            <SolidColorBrush x:Key="Fadenstack.AccentForeground" Color="#0A0E1A" />
            <SolidColorBrush x:Key="Fadenstack.AccentText" Color="#A9C0D8" />
            <SolidColorBrush x:Key="Fadenstack.AccentIcon" Color="#81A1C1" />
            <SolidColorBrush x:Key="Fadenstack.NavSelected" Color="#4C6A92" />
            <SolidColorBrush x:Key="Fadenstack.NavSelectedForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.Hover" Color="#1F81A1C1" />
