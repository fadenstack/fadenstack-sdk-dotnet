            <SolidColorBrush x:Key="Fadenstack.WarningBackground" Color="#4D3B00" />
            <SolidColorBrush x:Key="Fadenstack.BlockedBackground" Color="#4D0000" />
            <SolidColorBrush x:Key="Fadenstack.SuccessBackground" Color="#004D1A" />
            <SolidColorBrush x:Key="Fadenstack.AddedBackground" Color="#004D1A" />
            <SolidColorBrush x:Key="Fadenstack.RemovedBackground" Color="#4D0000" />
            <SolidColorBrush x:Key="Fadenstack.Scrim" Color="#CC000000" />
            <SolidColorBrush x:Key="Fadenstack.ScrollThumb" Color="#BFBFBF" />
            <SolidColorBrush x:Key="Fadenstack.ScrollThumbHover" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.BrandPlate" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.BrandThread" Color="#FF4D6D" />
            <BoxShadows x:Key="Fadenstack.Elevation">0 0 0 1 #FFFFFF</BoxShadows>
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
