<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:svc="clr-namespace:Fadenstack.UI.Avalonia.Services">
    <!--
        The chat's colours, by the same names as the WPF skin's: neutral greys as Office's and Windows' themes use,
        blue only for what acts. Light and dark are theme variants, so the panel follows the system (or the host's
        RequestedThemeVariant). Every template reads them through DynamicResource.
        High contrast is a third variant, "HighContrast", that inherits from Dark (a key it does not define falls back to
        Dark's): see FadenstackTheme.HighContrastVariant. The sizes below are the defaults of the keys that
        FadenstackTheme.Apply changes at runtime; every view reads them through DynamicResource.
        Values: doc 22 (desktop agent UI design) sections 3.1, 3.2 (Frost, the default accent), 3.3 and 3.5, from the console's
        theme.ts. The accent-derived keys here are Frost's; Apply puts the chosen accent on top, per theme variant.
        Key names are published as constants in Fadenstack.UI.Avalonia.FadenstackKeys.
    -->
    <CornerRadius x:Key="Fadenstack.Radius">12</CornerRadius>
    <CornerRadius x:Key="Fadenstack.Radius.Pill">999</CornerRadius>
    <CornerRadius x:Key="Fadenstack.Radius.Bubble.User">12 4 12 12</CornerRadius>
    <CornerRadius x:Key="Fadenstack.Radius.Bubble.Agent">4 12 12 12</CornerRadius>
    <!-- Inside a 12 frame with 4 padding (menu items, segments) and the tooltip: 8. The checkbox: 4 (22 section 5.2). -->
    <CornerRadius x:Key="Fadenstack.Radius.Inner">8</CornerRadius>
    <CornerRadius x:Key="Fadenstack.Radius.Check">4</CornerRadius>
    <!-- Room around a popup's surface for its shadow, and the offsets that put the surface (not the room) at the anchor. -->
    <Thickness x:Key="Fadenstack.Popup.ShadowMargin">12,6,12,18</Thickness>
    <x:Double x:Key="Fadenstack.Popup.OffsetX">-12</x:Double>
    <x:Double x:Key="Fadenstack.Popup.OffsetY">-6</x:Double>
    <Thickness x:Key="Fadenstack.Space.Small">4</Thickness>
    <Thickness x:Key="Fadenstack.Space.Medium">8</Thickness>
    <Thickness x:Key="Fadenstack.Space.Large">16</Thickness>
    <Thickness x:Key="Fadenstack.Space.1">4</Thickness>
    <Thickness x:Key="Fadenstack.Space.2">8</Thickness>
    <Thickness x:Key="Fadenstack.Space.3">12</Thickness>
    <Thickness x:Key="Fadenstack.Space.4">16</Thickness>
    <Thickness x:Key="Fadenstack.Space.5">24</Thickness>
    <Thickness x:Key="Fadenstack.Space.6">32</Thickness>
    <x:Double x:Key="Fadenstack.Space.1.Value">4</x:Double>
    <x:Double x:Key="Fadenstack.Space.2.Value">8</x:Double>
    <x:Double x:Key="Fadenstack.Space.3.Value">12</x:Double>
    <x:Double x:Key="Fadenstack.Space.4.Value">16</x:Double>
    <x:Double x:Key="Fadenstack.Space.5.Value">24</x:Double>
    <x:Double x:Key="Fadenstack.Space.6.Value">32</x:Double>
    <x:Double x:Key="Fadenstack.ControlHeight">36</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Caption">12</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Small">12</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Body">14</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Subtitle">16</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Title">20</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Display">24</x:Double>
    <x:Double x:Key="Fadenstack.FontSize.Micro">11</x:Double>
    <!-- Chat Markdown h2 (22 section 3.3: h1 20, h2 18, h3 16, h4 to h6 14). -->
    <x:Double x:Key="Fadenstack.FontSize.Heading">18</x:Double>
    <!-- Body text's line height, 14 x 1.43; scaled with the text size like the font sizes. -->
    <x:Double x:Key="Fadenstack.LineHeight.Body">20</x:Double>
    <x:Double x:Key="Fadenstack.IconButton.Size.Large">36</x:Double>
    <x:Double x:Key="Fadenstack.IconButton.Size.Normal">32</x:Double>
    <x:Double x:Key="Fadenstack.IconButton.Size.Small">28</x:Double>
    <x:Double x:Key="Fadenstack.Icon.Size.Large">20</x:Double>
    <x:Double x:Key="Fadenstack.Icon.Size.Normal">18</x:Double>
    <x:Double x:Key="Fadenstack.Icon.Size.Small">16</x:Double>
    <x:Double x:Key="Fadenstack.Icon.Size.ActivityBar">22</x:Double>
    <x:Double x:Key="Fadenstack.TitleBar.Height">48</x:Double>
    <x:Double x:Key="Fadenstack.StatusBar.Height">28</x:Double>
    <x:Double x:Key="Fadenstack.ActivityBar.Width">56</x:Double>
    <x:Double x:Key="Fadenstack.ActivityBar.Width.Labels">84</x:Double>
    <x:Double x:Key="Fadenstack.SidePanel.Width">380</x:Double>
    <x:Double x:Key="Fadenstack.SidePanel.MinWidth">300</x:Double>
    <x:Double x:Key="Fadenstack.SidePanel.MaxWidth">560</x:Double>
    <x:Double x:Key="Fadenstack.Bubble.Width">340</x:Double>
    <x:Double x:Key="Fadenstack.Bubble.Width.Card">420</x:Double>
    <x:Double x:Key="Fadenstack.Sheet.Width">480</x:Double>
    <x:Double x:Key="Fadenstack.Drawer.Width">400</x:Double>
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="Fadenstack.Background" Color="#F5F7FB" />
            <SolidColorBrush x:Key="Fadenstack.Surface" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.SurfaceAlt" Color="#EEF0F6" />
            <SolidColorBrush x:Key="Fadenstack.SurfaceSubtle" Color="#08000000" />
            <SolidColorBrush x:Key="Fadenstack.Border" Color="#1F121C2D" />
            <SolidColorBrush x:Key="Fadenstack.BorderStrong" Color="#80121C2D" />
            <SolidColorBrush x:Key="Fadenstack.BorderHover" Color="#991A1F2F" />
            <SolidColorBrush x:Key="Fadenstack.Inverse" Color="#1F2937" />
            <SolidColorBrush x:Key="Fadenstack.InverseForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.SwitchKnob" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.Foreground" Color="#1A1F2F" />
            <SolidColorBrush x:Key="Fadenstack.ForegroundMuted" Color="#4B5565" />
            <SolidColorBrush x:Key="Fadenstack.Accent" Color="#4C6A92" />
            <SolidColorBrush x:Key="Fadenstack.AccentHover" Color="#3B5478" />
            <SolidColorBrush x:Key="Fadenstack.AccentLight" Color="#81A1C1" />
            <SolidColorBrush x:Key="Fadenstack.AccentForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.AccentText" Color="#3B5478" />
            <SolidColorBrush x:Key="Fadenstack.AccentIcon" Color="#4C6A92" />
            <SolidColorBrush x:Key="Fadenstack.NavSelected" Color="#3B5478" />
            <SolidColorBrush x:Key="Fadenstack.NavSelectedForeground" Color="#FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.Hover" Color="#1F4C6A92" />
            <SolidColorBrush x:Key="Fadenstack.Tint" Color="#0F4C6A92" />
            <SolidColorBrush x:Key="Fadenstack.Pressed" Color="#334C6A92" />
            <SolidColorBrush x:Key="Fadenstack.SplitDivider" Color="#4DFFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.Link" Color="#3B5478" />
            <SolidColorBrush x:Key="Fadenstack.Focus" Color="#3B5478" />
            <SolidColorBrush x:Key="Fadenstack.Danger" Color="#E53935" />
            <SolidColorBrush x:Key="Fadenstack.DangerText" Color="#C62828" />
            <SolidColorBrush x:Key="Fadenstack.Warning" Color="#FB8C00" />
            <SolidColorBrush x:Key="Fadenstack.WarningText" Color="#B26A00" />
            <SolidColorBrush x:Key="Fadenstack.Success" Color="#2E7D32" />
            <SolidColorBrush x:Key="Fadenstack.CodeBackground" Color="#F7F7F7" />
            <SolidColorBrush x:Key="Fadenstack.CodeInlineBackground" Color="#EEEEEE" />
            <SolidColorBrush x:Key="Fadenstack.UserBubble" Color="#1F4C6A92" />
            <SolidColorBrush x:Key="Fadenstack.AgentBubble" Color="#F5F5F5" />
            <SolidColorBrush x:Key="Fadenstack.InfoBackground" Color="#1F0288D1" />
            <SolidColorBrush x:Key="Fadenstack.WarningBackground" Color="#1FFB8C00" />
            <SolidColorBrush x:Key="Fadenstack.BlockedBackground" Color="#1FE53935" />
            <SolidColorBrush x:Key="Fadenstack.SuccessBackground" Color="#1F2E7D32" />
            <SolidColorBrush x:Key="Fadenstack.AddedBackground" Color="#1F2E7D32" />
            <SolidColorBrush x:Key="Fadenstack.RemovedBackground" Color="#1FE53935" />
            <SolidColorBrush x:Key="Fadenstack.Scrim" Color="#5905080F" />
            <SolidColorBrush x:Key="Fadenstack.ScrollThumb" Color="#664B5565" />
            <SolidColorBrush x:Key="Fadenstack.ScrollThumbHover" Color="#994B5565" />
            <SolidColorBrush x:Key="Fadenstack.BrandPlate" Color="#0A0E1A" />
            <SolidColorBrush x:Key="Fadenstack.BrandThread" Color="#E2325A" />
            <BoxShadows x:Key="Fadenstack.Elevation">0 8 24 0 #29000000</BoxShadows>
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="Fadenstack.Background" Color="#0A0E1A" />
            <SolidColorBrush x:Key="Fadenstack.Surface" Color="#111827" />
            <SolidColorBrush x:Key="Fadenstack.SurfaceAlt" Color="#171F32" />
            <SolidColorBrush x:Key="Fadenstack.SurfaceSubtle" Color="#08FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.Border" Color="#14FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.BorderStrong" Color="#61FFFFFF" />
            <SolidColorBrush x:Key="Fadenstack.BorderHover" Color="#99E0E0E0" />
            <SolidColorBrush x:Key="Fadenstack.Inverse" Color="#E5E7EB" />
            <SolidColorBrush x:Key="Fadenstack.InverseForeground" Color="#111827" />
            <SolidColorBrush x:Key="Fadenstack.SwitchKnob" Color="#E0E0E0" />
