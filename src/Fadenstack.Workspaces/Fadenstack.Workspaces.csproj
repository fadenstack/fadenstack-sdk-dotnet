<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fadenstack.Workspaces</RootNamespace>
    <PackageId>Fadenstack.Workspaces</PackageId>
    <Description>One model for the applications agents work with: running instances, the files or projects open in them (workspaces), the agents active in each, document leases, workspace-bound tools and the default system tools.</Description>
    <!-- A prototype: built and tested with the SDK, but not published until the workspace framework's
         open decisions are made. -->
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fadenstack.Agents\Fadenstack.Agents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- The device agent registry lives in Fadenstack.Agents (a packable package both hosts reference). -->
    <Using Include="Fadenstack.Agents.Registry" />
    <InternalsVisibleTo Include="Fadenstack.Workspaces.Tests" />
  </ItemGroup>
</Project>
