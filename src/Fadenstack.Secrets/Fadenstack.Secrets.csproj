<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- macOS and Linux run .NET 8+; .NET Framework hosts are Windows and keep DPAPI, so they never get these assemblies. -->
    <TargetFrameworks>net8.0</TargetFrameworks>
    <RootNamespace>Fadenstack.Secrets</RootNamespace>
    <PackageId>Fadenstack.Secrets</PackageId>
    <Description>Encryption at rest on macOS and Linux for Fadenstack: the data key lives in the OS key store (Keychain, Secret Service).</Description>
    <PackageTags>$(PackageTags);keychain;keyring;encryption</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Identity.Client.Extensions.Msal" Version="4.91.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fadenstack.Client\Fadenstack.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fadenstack.Secrets.Tests" />
  </ItemGroup>
</Project>
