<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Faden</RootNamespace>
    <PackageId>Fadenstack.Client</PackageId>
    <Description>The Fadenstack core client: an IChatClient for the gateway (agent-scoped or plain), sign-in and agent tokens, the agent profile, governance outcomes, tool classes and modes, and the server-session resources.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI.Abstractions" Version="10.10.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Faden.Client.Tests" />
    <InternalsVisibleTo Include="Faden.Agents" />
    <InternalsVisibleTo Include="Faden.Agents.Tests" />
  </ItemGroup>
</Project>
