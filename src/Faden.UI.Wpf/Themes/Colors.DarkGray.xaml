<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!--
        Dark gray colours: Office's Dark Gray theme draws its frame, pane headers and status bar in #525252 and the
        area around the page in #595A5A, where the black theme's #1F1F1F stood out as a hole. The panel sits a step
        darker than the frame, as Office's own panes do; text, links and states are lighter than in the dark
        colours so they keep their contrast on grey. Same keys as Colors.Dark.xaml.
    -->
    <SolidColorBrush x:Key="Faden.Background" Color="#444444" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Surface" Color="#4E4E4E" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.SurfaceAlt" Color="#585858" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Border" Color="#6A6A6A" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Foreground" Color="#F5F5F5" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.ForegroundMuted" Color="#C6C6C6" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Accent" Color="#2B7CD3" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.AccentHover" Color="#3B8DE0" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.AccentForeground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Hover" Color="#555555" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Pressed" Color="#5F5F5F" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Link" Color="#94C4F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Danger" Color="#FF9AA1" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Warning" Color="#F4C860" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Success" Color="#8EDC82" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.CodeBackground" Color="#3A3A3A" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.CodeInlineBackground" Color="#575757" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.UserBubble" Color="#3E4D61" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.InfoBackground" Color="#3A4B63" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.WarningBackground" Color="#54492F" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.BlockedBackground" Color="#583A3E" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.AddedBackground" Color="#34513A" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.RemovedBackground" Color="#583A3E" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Focus" Color="#94C4F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Scrim" Color="#66000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.ScrollThumb" Color="#747474" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.ScrollThumbHover" Color="#969696" po:Freeze="True" />
    <!-- The agent avatar (AgentAvatar): as in the dark colours. -->
    <SolidColorBrush x:Key="Faden.Avatar.PlateTop" Color="#F3F4F6" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.PlateSide" Color="#AEB7C6" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.Thread" Color="#FF4D6D" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.ThreadSide" Color="#C21E48" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.Hollow" Color="#8C0A0E1A" po:Freeze="True" />
    <FontFamily x:Key="Faden.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Faden.CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Faden.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
