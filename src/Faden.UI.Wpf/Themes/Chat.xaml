<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:vm="clr-namespace:Faden.UI.ViewModels;assembly=Faden.UI"
                    xmlns:parts="clr-namespace:Faden.UI.Parts;assembly=Faden.UI"
                    xmlns:md="clr-namespace:Faden.UI.Markdown;assembly=Faden.UI"
                    xmlns:b="clr-namespace:Faden.UI.Wpf.Behaviors"
                    xmlns:c="clr-namespace:Faden.UI.Wpf.Converters">
    <!--
        Styles and templates for the chat. Templates are implicit (by view-model type), so a host can replace
        any one of them by adding its own DataTemplate for that type. Colours come from Colors.*.xaml.
    -->

    <BooleanToVisibilityConverter x:Key="Faden.BoolToVisibility" />
    <c:InverseBoolToVisibilityConverter x:Key="Faden.InverseBoolToVisibility" />
    <c:InverseBoolConverter x:Key="Faden.InverseBool" />
    <c:EmptyToCollapsedConverter x:Key="Faden.EmptyToCollapsed" />
    <c:LevelToIndentConverter x:Key="Faden.LevelToIndent" />

    <!-- ===== Shape ======================================================================================== -->
    <!--
        Two radii. Containers (composer, cards, bubbles, code, menus) are 12; controls (buttons, fields, chips' parts)
        are 6. A control in a container's corner sits 6 in from it, so its curve follows the container's (12 - 6 = 6).
    -->
    <CornerRadius x:Key="Faden.Radius.Container">12</CornerRadius>
    <CornerRadius x:Key="Faden.Radius.Control">6</CornerRadius>
    <CornerRadius x:Key="Faden.Radius.Chip">8</CornerRadius>

    <!-- ===== Scroll bars: thin, themed, the thumb only (no arrows, no track); wider while hovered ============ -->

    <Style x:Key="Faden.ScrollPageStyle" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Faden.ScrollThumbStyle" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border x:Name="Bar" Background="{DynamicResource Faden.ScrollThumb}" CornerRadius="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Faden.ScrollThumbHover}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Bar" Property="Background" Value="{DynamicResource Faden.ScrollThumbHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Implicit inside the chat (this dictionary is merged into the view's resources), never the host's. -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Width" Value="10" />
        <Setter Property="MinWidth" Value="10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent">
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="3,4">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Faden.ScrollPageStyle}" Command="ScrollBar.PageUpCommand" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Faden.ScrollThumbStyle}" MinHeight="24" />
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Style="{StaticResource Faden.ScrollPageStyle}" Command="ScrollBar.PageDownCommand" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Track" Property="Margin" Value="2,4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent">
                                <Track x:Name="PART_Track" IsDirectionReversed="False" Margin="4,3">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Faden.ScrollPageStyle}" Command="ScrollBar.PageLeftCommand" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb Style="{StaticResource Faden.ScrollThumbStyle}" MinWidth="24" />
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton Style="{StaticResource Faden.ScrollPageStyle}" Command="ScrollBar.PageRightCommand" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="PART_Track" Property="Margin" Value="4,2" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- ===== Primitive styles ============================================================================ -->

    <Style x:Key="Faden.Icon" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Faden.IconFont}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Faden.Muted" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Faden.ForegroundMuted}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Faden.Mono" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Faden.CodeFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- A flat button: transparent until hovered. -->
    <Style x:Key="Faden.GhostButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Faden.Foreground}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Faden.Radius.Control}"
                            Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Faden.Hover}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Faden.Pressed}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Faden.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A ghost button that disappears when its command cannot run (Retry, Load earlier). -->
    <Style x:Key="Faden.GhostButton.HideDisabled" TargetType="Button" BasedOn="{StaticResource Faden.GhostButton}">
        <Style.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="Faden.PrimaryButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Faden.AccentForeground}" />
        <Setter Property="Background" Value="{DynamicResource Faden.Accent}" />
        <Setter Property="Padding" Value="12,5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" CornerRadius="{StaticResource Faden.Radius.Control}"
                            Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Faden.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Faden.Foreground}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Faden.SecondaryButton" TargetType="Button" BasedOn="{StaticResource Faden.GhostButton}">
        <Setter Property="Background" Value="{DynamicResource Faden.SurfaceAlt}" />
        <Setter Property="Padding" Value="12,5" />
    </Style>

    <!-- A text field for a host's own forms (sign-in, settings): rounded like the controls, accent on focus. -->
    <Style x:Key="Faden.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Faden.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Faden.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Faden.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Faden.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Faden.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Faden.Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Faden.Focus}" />
                        </Trigger>
                        <Trigger Property="IsReadOnly" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Faden.SurfaceAlt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Faden.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Faden.Foreground}" />
        <Setter Property="Background" Value="{DynamicResource Faden.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Faden.Border}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Faden.Foreground}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Faden.Accent}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,6" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{StaticResource Faden.Radius.Control}">
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Faden.Focus}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- A small rounded label (a tool's class). -->
    <Style x:Key="Faden.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Faden.Border}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="8,0,0,0" />
    </Style>

    <!-- A spinning arc; it only animates while visible. -->
    <Style x:Key="Faden.Spinner" TargetType="Control">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Path x:Name="Arc" Stroke="{DynamicResource Faden.Accent}" StrokeThickness="2" StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" Stretch="Uniform" RenderTransformOrigin="0.5,0.5"
                          Data="M 7,1 A 6,6 0 1 1 1,7">
                        <Path.RenderTransform>
                            <RotateTransform Angle="0" />
                        </Path.RenderTransform>
                    </Path>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsVisible" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="Spin">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Arc"
                                                         Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                                         From="0" To="360" Duration="0:0:0.9" RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="Spin" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ===== Markdown blocks ============================================================================ -->

    <DataTemplate DataType="{x:Type md:ParagraphBlock}">
        <TextBlock b:MarkdownText.Inlines="{Binding Inlines}" TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,10" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:HeadingBlock}">
        <TextBlock x:Name="Text" b:MarkdownText.Inlines="{Binding Inlines}" TextWrapping="Wrap" FontWeight="SemiBold"
                   FontSize="14" Margin="0,6,0,8" />
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Level}" Value="1">
                <Setter TargetName="Text" Property="FontSize" Value="20" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="2">
                <Setter TargetName="Text" Property="FontSize" Value="17" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Level}" Value="3">
                <Setter TargetName="Text" Property="FontSize" Value="15" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:CodeBlock}">
        <Border Background="{DynamicResource Faden.CodeBackground}" BorderBrush="{DynamicResource Faden.Border}" BorderThickness="1"
                CornerRadius="{StaticResource Faden.Radius.Container}" Margin="0,2,0,12">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,5,5,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource Faden.GhostButton}" ToolTip="Copy code"
                            Command="{Binding DataContext.CopyCodeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                        <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Text="&#xE8C8;" />
                    </Button>
                    <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Language}" />
                </DockPanel>
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="12,4,12,10">
                    <TextBlock Style="{StaticResource Faden.Mono}" TextWrapping="NoWrap" Text="{Binding Code}" />
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:ListItem}">
        <DockPanel Margin="{Binding Level, Converter={StaticResource Faden.LevelToIndent}}">
            <TextBlock DockPanel.Dock="Left" Text="{Binding Marker}" MinWidth="18" Foreground="{DynamicResource Faden.ForegroundMuted}" />
            <TextBlock b:MarkdownText.Inlines="{Binding Inlines}" TextWrapping="Wrap" LineHeight="20" />
        </DockPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:ListBlock}">
        <ItemsControl ItemsSource="{Binding Items}" Focusable="False" Margin="4,0,0,10" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:QuoteBlock}">
        <Border BorderBrush="{DynamicResource Faden.Border}" BorderThickness="3,0,0,0" Padding="12,2" Margin="0,0,0,10">
            <TextBlock b:MarkdownText.Inlines="{Binding Inlines}" TextWrapping="Wrap" Foreground="{DynamicResource Faden.ForegroundMuted}" />
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:TableBlock}">
        <Border BorderBrush="{DynamicResource Faden.Border}" BorderThickness="1" CornerRadius="6" Margin="0,2,0,12"
                HorizontalAlignment="Left">
            <ContentControl b:MarkdownTable.Table="{Binding}" Focusable="False" />
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type md:RuleBlock}">
        <Border Height="1" Background="{DynamicResource Faden.Border}" Margin="0,6,0,14" />
    </DataTemplate>

    <!-- ===== Answer parts ============================================================================== -->

    <DataTemplate DataType="{x:Type parts:MarkdownPart}">
        <ItemsControl ItemsSource="{Binding Blocks}" Focusable="False" />
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:ReasoningPart}">
        <StackPanel Margin="0,0,0,8">
            <Button Style="{StaticResource Faden.GhostButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <Control Style="{StaticResource Faden.Spinner}" Visibility="{Binding IsStreaming, Converter={StaticResource Faden.BoolToVisibility}}" Margin="0,0,8,0" />
                    <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Title}" />
                    <TextBlock x:Name="Chevron" Style="{StaticResource Faden.Icon}" FontSize="9" Margin="8,0,0,0"
                               Foreground="{DynamicResource Faden.ForegroundMuted}" Text="&#xE76C;" />
                </StackPanel>
            </Button>
            <Border BorderBrush="{DynamicResource Faden.Border}" BorderThickness="2,0,0,0" Padding="12,2" Margin="8,4,0,0"
                    Visibility="{Binding IsExpanded, Converter={StaticResource Faden.BoolToVisibility}}">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontStyle="Italic" Foreground="{DynamicResource Faden.ForegroundMuted}" />
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:ToolCallPart}">
        <StackPanel Margin="0,1,0,3">
            <Button Style="{StaticResource Faden.GhostButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left"
                    ToolTip="{Binding Source}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="16" Height="16">
                        <Control x:Name="Busy" Style="{StaticResource Faden.Spinner}" Visibility="Collapsed" />
                        <TextBlock x:Name="Mark" Style="{StaticResource Faden.Icon}" FontSize="12" Text="&#xE73E;"
                                   Foreground="{DynamicResource Faden.Success}" />
                    </Grid>
                    <TextBlock Text="{Binding Title}" Margin="8,0,0,0" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Faden.Badge}">
                        <TextBlock Style="{StaticResource Faden.Muted}" FontSize="11" Text="{Binding ClassLabel}" />
                    </Border>
                    <TextBlock Style="{StaticResource Faden.Muted}" Margin="8,0,0,0" Text="{Binding DurationText}" />
                    <TextBlock x:Name="Chevron" Style="{StaticResource Faden.Icon}" FontSize="9" Margin="8,0,0,0"
                               Foreground="{DynamicResource Faden.ForegroundMuted}" Text="&#xE76C;"
                               Visibility="{Binding HasDetails, Converter={StaticResource Faden.BoolToVisibility}}" />
                </StackPanel>
            </Button>
            <Border Visibility="{Binding IsExpanded, Converter={StaticResource Faden.BoolToVisibility}}" Margin="30,2,0,8"
                    Background="{DynamicResource Faden.CodeBackground}" BorderBrush="{DynamicResource Faden.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Faden.Radius.Container}" Padding="12,10">
                <StackPanel>
                    <StackPanel Visibility="{Binding ArgumentsText, Converter={StaticResource Faden.EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource Faden.Muted}" Text="Input" Margin="0,0,0,2" />
                        <TextBlock Style="{StaticResource Faden.Mono}" Text="{Binding ArgumentsText}" Margin="0,0,0,8" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding ResultText, Converter={StaticResource Faden.EmptyToCollapsed}}">
                        <TextBlock Style="{StaticResource Faden.Muted}" Text="Output" Margin="0,0,0,2" />
                        <ScrollViewer MaxHeight="240" VerticalScrollBarVisibility="Auto">
                            <TextBlock Style="{StaticResource Faden.Mono}" Text="{Binding ResultText}" />
                        </ScrollViewer>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsRunning}" Value="True">
                <Setter TargetName="Busy" Property="Visibility" Value="Visible" />
                <Setter TargetName="Mark" Property="Visibility" Value="Collapsed" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Failed">
                <Setter TargetName="Mark" Property="Text" Value="&#xE711;" />
                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Faden.Danger}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Denied">
                <Setter TargetName="Mark" Property="Text" Value="&#xE733;" />
                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Faden.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding State}" Value="Cancelled">
                <Setter TargetName="Mark" Property="Text" Value="&#xE71A;" />
                <Setter TargetName="Mark" Property="Foreground" Value="{DynamicResource Faden.ForegroundMuted}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- The approval card: answered in place, like Copilot's "Allow" / "Deny". -->
    <DataTemplate DataType="{x:Type parts:ApprovalPart}">
        <Border x:Name="Card" Margin="0,6,0,8" Padding="14,12" CornerRadius="{StaticResource Faden.Radius.Container}" BorderThickness="1"
                BorderBrush="{DynamicResource Faden.Accent}" Background="{DynamicResource Faden.Surface}" MaxWidth="640"
                HorizontalAlignment="Left">
            <StackPanel>
                <DockPanel>
                    <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Faden.Icon}" Text="&#xE946;"
                               Foreground="{DynamicResource Faden.Accent}" Margin="0,0,10,0" />
                    <Border DockPanel.Dock="Right" Style="{StaticResource Faden.Badge}">
                        <TextBlock Style="{StaticResource Faden.Muted}" FontSize="11" Text="{Binding ClassLabel}" />
                    </Border>
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
                </DockPanel>
                <TextBlock Text="{Binding Reason}" TextWrapping="Wrap" Margin="0,6,0,0" Foreground="{DynamicResource Faden.ForegroundMuted}"
                           Visibility="{Binding Reason, Converter={StaticResource Faden.EmptyToCollapsed}}" />
                <Border Background="{DynamicResource Faden.CodeBackground}" CornerRadius="{StaticResource Faden.Radius.Control}" Padding="10,6" Margin="0,8,0,0"
                        Visibility="{Binding ArgumentsText, Converter={StaticResource Faden.EmptyToCollapsed}}">
                    <ScrollViewer MaxHeight="160" VerticalScrollBarVisibility="Auto">
                        <TextBlock Style="{StaticResource Faden.Mono}" Text="{Binding ArgumentsText}" />
                    </ScrollViewer>
                </Border>
                <WrapPanel Margin="0,12,0,0" Visibility="{Binding IsPending, Converter={StaticResource Faden.BoolToVisibility}}">
                    <Button Style="{StaticResource Faden.PrimaryButton}" Content="Allow" Command="{Binding AllowCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Faden.SecondaryButton}" Content="Allow for this chat" Command="{Binding AllowForSessionCommand}" Margin="0,0,8,0" />
                    <Button Style="{StaticResource Faden.SecondaryButton}" Content="Deny" Command="{Binding DenyCommand}" />
                </WrapPanel>
                <TextBlock Style="{StaticResource Faden.Muted}" Margin="0,8,0,0" Text="{Binding StateText}"
                           Visibility="{Binding IsPending, Converter={StaticResource Faden.InverseBoolToVisibility}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsDestructive}" Value="True">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Faden.Warning}" />
                <Setter TargetName="Glyph" Property="Text" Value="&#xE7BA;" />
                <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Faden.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding IsPending}" Value="False">
                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource Faden.Border}" />
                <Setter TargetName="Card" Property="Opacity" Value="0.85" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:NoticePart}">
        <Border x:Name="Box" Margin="0,4,0,8" Padding="12,8" CornerRadius="{StaticResource Faden.Radius.Control}" BorderThickness="3,0,0,0"
                BorderBrush="{DynamicResource Faden.Accent}" Background="{DynamicResource Faden.InfoBackground}">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Margin="0,2,0,0" />
                <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0"
                           Visibility="{Binding Detail, Converter={StaticResource Faden.EmptyToCollapsed}}" />
            </StackPanel>
        </Border>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding Severity}" Value="Warning">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Faden.Warning}" />
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Faden.WarningBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Blocked">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Faden.Danger}" />
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Faden.BlockedBackground}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Severity}" Value="Error">
                <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Faden.Danger}" />
                <Setter TargetName="Box" Property="Background" Value="{DynamicResource Faden.BlockedBackground}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:CitationsPart}">
        <StackPanel Margin="0,0,0,6">
            <Button Style="{StaticResource Faden.GhostButton}" Command="{Binding ToggleCommand}" HorizontalAlignment="Left">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Text="&#xE8A5;" Foreground="{DynamicResource Faden.ForegroundMuted}" />
                    <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Title}" Margin="8,0,0,0" />
                    <TextBlock x:Name="Chevron" Style="{StaticResource Faden.Icon}" FontSize="9" Margin="8,0,0,0"
                               Foreground="{DynamicResource Faden.ForegroundMuted}" Text="&#xE76C;" />
                </StackPanel>
            </Button>
            <ItemsControl ItemsSource="{Binding Citations}" Focusable="False" Margin="30,2,0,4"
                          Visibility="{Binding IsExpanded, Converter={StaticResource Faden.BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="0,1">
                            <TextBlock Text="{Binding Title}" />
                            <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Detail}" Margin="8,0,0,0" />
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                <Setter TargetName="Chevron" Property="Text" Value="&#xE70D;" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:CardPart}">
        <Border Margin="0,4,0,8" Padding="14,10" CornerRadius="{StaticResource Faden.Radius.Container}" BorderThickness="1" BorderBrush="{DynamicResource Faden.Border}"
                Background="{DynamicResource Faden.Surface}" HorizontalAlignment="Left" MinWidth="280">
            <StackPanel>
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" />
                <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Subtitle}"
                           Visibility="{Binding Subtitle, Converter={StaticResource Faden.EmptyToCollapsed}}" />
                <ItemsControl ItemsSource="{Binding Fields}" Focusable="False" Margin="0,6,0,0" Grid.IsSharedSizeScope="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" SharedSizeGroup="Label" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Label}" Margin="0,0,16,0" />
                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:TablePart}">
        <StackPanel Margin="0,4,0,8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4"
                       Visibility="{Binding Title, Converter={StaticResource Faden.EmptyToCollapsed}}" />
            <Border BorderBrush="{DynamicResource Faden.Border}" BorderThickness="1" CornerRadius="{StaticResource Faden.Radius.Control}" HorizontalAlignment="Left">
                <StackPanel>
                    <Border Background="{DynamicResource Faden.SurfaceAlt}" CornerRadius="5,5,0,0">
                    <ItemsControl ItemsSource="{Binding Headers}" Focusable="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding}" FontWeight="SemiBold" Margin="10,5" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    </Border>
                    <ItemsControl ItemsSource="{Binding Rows}" Focusable="False">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{DynamicResource Faden.Border}" BorderThickness="0,1,0,0">
                                    <ItemsControl ItemsSource="{Binding}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Rows="1" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="10,5" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:ProgressPart}">
        <StackPanel Margin="0,4,0,8" MaxWidth="360" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Label}" Margin="0,0,0,4" />
            <ProgressBar Height="4" Minimum="0" Maximum="1" Value="{Binding Value, Mode=OneWay, TargetNullValue=0}"
                         IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" BorderThickness="0"
                         Foreground="{DynamicResource Faden.Accent}" Background="{DynamicResource Faden.SurfaceAlt}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate DataType="{x:Type parts:DiffPart}">
        <StackPanel Margin="0,4,0,8">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Margin="0,0,0,4" />
            <Border BorderBrush="{DynamicResource Faden.Border}" BorderThickness="1" CornerRadius="6" Padding="0,4">
                <ItemsControl ItemsSource="{Binding Lines}" Focusable="False">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Line" Padding="10,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock x:Name="Sign" Style="{StaticResource Faden.Mono}" Text=" " Width="14" />
                                    <TextBlock Style="{StaticResource Faden.Mono}" Text="{Binding Text}" />
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding Kind}" Value="Added">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Faden.AddedBackground}" />
                                    <Setter TargetName="Sign" Property="Text" Value="+" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                    <Setter TargetName="Line" Property="Background" Value="{DynamicResource Faden.RemovedBackground}" />
                                    <Setter TargetName="Sign" Property="Text" Value="-" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </StackPanel>
    </DataTemplate>

    <!-- ===== A turn: the user's message, then the answer ====================================================== -->

    <DataTemplate DataType="{x:Type vm:TurnViewModel}">
        <StackPanel Margin="20,14,20,6">
            <Border x:Name="Bubble" HorizontalAlignment="Right" MaxWidth="560" CornerRadius="{StaticResource Faden.Radius.Container}" Padding="12,8"
                    Background="{DynamicResource Faden.UserBubble}" BorderThickness="1" BorderBrush="Transparent">
                <TextBlock Text="{Binding UserText}" TextWrapping="Wrap" LineHeight="20" />
            </Border>
            <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False" HorizontalAlignment="Right" Margin="0,4,0,0"
                          Visibility="{Binding HasAttachments, Converter={StaticResource Faden.BoolToVisibility}}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border CornerRadius="{StaticResource Faden.Radius.Chip}" BorderThickness="1" BorderBrush="{DynamicResource Faden.Border}" Padding="6,1" Margin="4,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Faden.Icon}" FontSize="10" Text="&#xE8A5;" Margin="0,0,4,0"
                                           Foreground="{DynamicResource Faden.ForegroundMuted}" />
                                <TextBlock Style="{StaticResource Faden.Muted}" FontSize="11" Text="{Binding Title}" ToolTip="{Binding Subtitle}" />
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0"
                        Visibility="{Binding IsPromptBlocked, Converter={StaticResource Faden.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Faden.Muted}" Text="Not sent" Foreground="{DynamicResource Faden.Danger}" Margin="0,0,6,0" />
                <Button Style="{StaticResource Faden.GhostButton}" Command="{Binding EditCommand}">
                    <TextBlock Foreground="{DynamicResource Faden.Link}" FontSize="12" Text="Edit and resend" />
                </Button>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,12,0,6">
                <Border Width="22" Height="22" CornerRadius="11" Background="{DynamicResource Faden.Accent}">
                    <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Text="&#xE99A;" Foreground="{DynamicResource Faden.AccentForeground}" />
                </Border>
                <TextBlock Margin="8,0,0,0" FontWeight="SemiBold" VerticalAlignment="Center"
                           Text="{Binding DataContext.Title, RelativeSource={RelativeSource AncestorType=UserControl}}" />
            </StackPanel>

            <ItemsControl ItemsSource="{Binding Parts}" Focusable="False" Margin="30,0,0,0" />

            <StackPanel Orientation="Horizontal" Margin="30,2,0,0"
                        Visibility="{Binding StatusText, Converter={StaticResource Faden.EmptyToCollapsed}}">
                <Control x:Name="Busy" Style="{StaticResource Faden.Spinner}" Margin="0,0,8,0"
                         Visibility="{Binding IsRunning, Converter={StaticResource Faden.BoolToVisibility}}" />
                <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding StatusText}" />
            </StackPanel>

            <TextBlock Margin="30,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Faden.Danger}" Text="{Binding ErrorMessage}"
                       Visibility="{Binding ErrorMessage, Converter={StaticResource Faden.EmptyToCollapsed}}" />

            <StackPanel Orientation="Horizontal" Margin="26,2,0,0"
                        Visibility="{Binding IsRunning, Converter={StaticResource Faden.InverseBoolToVisibility}}">
                <Button Style="{StaticResource Faden.GhostButton.HideDisabled}" Command="{Binding CopyCommand}" ToolTip="Copy">
                    <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Foreground="{DynamicResource Faden.ForegroundMuted}" Text="&#xE8C8;" />
                </Button>
                <Button Style="{StaticResource Faden.GhostButton.HideDisabled}" Command="{Binding RetryCommand}" ToolTip="Try again">
                    <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Foreground="{DynamicResource Faden.ForegroundMuted}" Text="&#xE72C;" />
                </Button>
                <TextBlock Style="{StaticResource Faden.Muted}" FontSize="11" Margin="8,0,0,0" Text="{Binding DurationText}" />
                <TextBlock Style="{StaticResource Faden.Muted}" FontSize="11" Margin="8,0,0,0" Text="{Binding UsageText}" />
            </StackPanel>
        </StackPanel>
        <DataTemplate.Triggers>
            <DataTrigger Binding="{Binding IsPromptBlocked}" Value="True">
                <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource Faden.Danger}" />
            </DataTrigger>
        </DataTemplate.Triggers>
    </DataTemplate>

    <!-- A mode in the mode menu: label and what it means; greyed out above the ceiling. -->
    <DataTemplate DataType="{x:Type vm:ToolModeOption}">
        <StackPanel Margin="2,2,12,2">
            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
            <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding Description}" TextWrapping="Wrap" MaxWidth="260" />
        </StackPanel>
    </DataTemplate>
</ResourceDictionary>
