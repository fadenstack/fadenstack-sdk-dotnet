<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    mc:Ignorable="po">
    <!--
        Light colours: neutral greys, as Office's and Windows' light themes use; blue only for what acts.
        Every template uses these keys through DynamicResource.
    -->
    <SolidColorBrush x:Key="Faden.Background" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Surface" Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.SurfaceAlt" Color="#EFEFEF" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Border" Color="#D4D4D4" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Foreground" Color="#1F1F1F" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.ForegroundMuted" Color="#5E5E5E" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Accent" Color="#0F6CBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.AccentHover" Color="#115EA3" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.AccentForeground" Color="#FFFFFF" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Hover" Color="#F0F0F0" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Pressed" Color="#E3E3E3" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Link" Color="#0F6CBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Danger" Color="#C42B1C" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Warning" Color="#9D5D00" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Success" Color="#0F7B0F" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.CodeBackground" Color="#F7F7F7" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.CodeInlineBackground" Color="#EEEEEE" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.UserBubble" Color="#EBF3FC" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.InfoBackground" Color="#EBF3FC" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.WarningBackground" Color="#FFF4CE" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.BlockedBackground" Color="#FDE7E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.AddedBackground" Color="#DFF6DD" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.RemovedBackground" Color="#FDE7E9" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Focus" Color="#0F6CBD" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Scrim" Color="#33000000" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.ScrollThumb" Color="#C2C2C2" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.ScrollThumbHover" Color="#9E9E9E" po:Freeze="True" />
    <!-- The agent avatar (AgentAvatar): navy plates, the rose thread plate, the hollow under the lid. -->
    <SolidColorBrush x:Key="Faden.Avatar.PlateTop" Color="#1C2436" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.PlateSide" Color="#0A0E1A" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.Thread" Color="#E2325A" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.ThreadSide" Color="#A8143E" po:Freeze="True" />
    <SolidColorBrush x:Key="Faden.Avatar.Hollow" Color="#610A0E1A" po:Freeze="True" />
    <FontFamily x:Key="Faden.Font">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Faden.CodeFont">Cascadia Mono, Consolas, Courier New</FontFamily>
    <FontFamily x:Key="Faden.IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>
</ResourceDictionary>
