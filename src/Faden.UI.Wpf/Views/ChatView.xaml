<UserControl x:Class="Faden.UI.Wpf.Views.ChatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:Faden.UI.ViewModels;assembly=Faden.UI"
             xmlns:b="clr-namespace:Faden.UI.Wpf.Behaviors"
             xmlns:local="clr-namespace:Faden.UI.Wpf.Views"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:AgentChatViewModel}"
             d:DesignWidth="480" d:DesignHeight="720"
             Background="{DynamicResource Faden.Background}" Foreground="{DynamicResource Faden.Foreground}"
             FontFamily="{DynamicResource Faden.Font}" FontSize="13" UseLayoutRounding="True"
             TextOptions.TextFormattingMode="Display">
    <!--
        The chat panel: header (agent, tool mode, history, new chat), the conversation (virtualized turns),
        the composer. Binds to an AgentChatViewModel; it has no logic of its own.
    -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Faden.UI.Wpf;component/Themes/Colors.Light.xaml" />
                <ResourceDictionary Source="/Faden.UI.Wpf;component/Themes/Chat.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <UserControl.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}" />
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding NewChatCommand}" />
    </UserControl.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border x:Name="Header" BorderBrush="{DynamicResource Faden.Border}" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <ToggleButton x:Name="ModeButton" Style="{StaticResource Faden.GhostButton}" ToolTip="{Binding ToolModeHint}"
                                  IsChecked="{Binding IsModeMenuOpen, Mode=TwoWay}" IsEnabled="{Binding IsReady}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=ModeMenu, Converter={StaticResource Faden.InverseBool}}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Text="&#xE90F;" Margin="0,0,6,0" />
                            <TextBlock Text="{Binding SelectedToolMode.Label}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Faden.Icon}" FontSize="9" Text="&#xE70D;" Margin="6,0,0,0" />
                        </StackPanel>
                    </ToggleButton>
                    <Popup x:Name="ModeMenu" IsOpen="{Binding IsModeMenuOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=ModeButton}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                        <Border Background="{DynamicResource Faden.Surface}" BorderBrush="{DynamicResource Faden.Border}" BorderThickness="1"
                                CornerRadius="{StaticResource Faden.Radius.Container}" Padding="6" Margin="0,4,8,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.25" />
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Style="{StaticResource Faden.Muted}" Text="Tools in this chat" Margin="8,4,8,4" />
                                <ItemsControl ItemsSource="{Binding ToolModes}" Focusable="False">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Faden.GhostButton}" HorizontalContentAlignment="Left" Padding="8,6"
                                                    Command="{Binding DataContext.SelectToolModeCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                    CommandParameter="{Binding}" Content="{Binding}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Style="{StaticResource Faden.Muted}" Text="{Binding ToolModeHint}" TextWrapping="Wrap" MaxWidth="280"
                                           Margin="8,6,8,4" />
                            </StackPanel>
                        </Border>
                    </Popup>
                    <ToggleButton x:Name="HistoryButton" Style="{StaticResource Faden.GhostButton}" ToolTip="Chats" Margin="4,0,0,0"
                                  AutomationProperties.Name="Chats" IsChecked="{Binding IsHistoryOpen, Mode=TwoWay}"
                                  IsHitTestVisible="{Binding IsOpen, ElementName=HistoryMenu, Converter={StaticResource Faden.InverseBool}}">
                        <TextBlock Style="{StaticResource Faden.Icon}" Text="&#xE81C;" />
                    </ToggleButton>
                    <Button Style="{StaticResource Faden.GhostButton}" ToolTip="New chat (Ctrl+N)" AutomationProperties.Name="New chat"
                            Margin="4,0,0,0" Command="{Binding NewChatCommand}">
                        <TextBlock Style="{StaticResource Faden.Icon}" Text="&#xE710;" />
                    </Button>
                </StackPanel>
                <local:AgentAvatar Small="True" Width="24" Height="24" Margin="0,0,10,0" />
                <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <!-- Conversation -->
        <Grid Grid.Row="1">
            <!-- Empty chat: the agent's greeting and suggestions -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="440" Margin="24"
                        Visibility="{Binding IsEmpty, Converter={StaticResource Faden.BoolToVisibility}}">
                <local:AgentAvatar Width="56" Height="56" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding Title}" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="{Binding Greeting}" TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Faden.ForegroundMuted}" />
                <ItemsControl ItemsSource="{Binding Suggestions}" Focusable="False" Margin="0,16,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Faden.GhostButton}" HorizontalContentAlignment="Left" Padding="12,8" Margin="0,3"
                                    BorderBrush="{DynamicResource Faden.Border}"
                                    Command="{Binding DataContext.SendSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                    CommandParameter="{Binding}">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- The turns: virtualized and recycled, scrolled by pixel, kept at the bottom while the user is there -->
            <ItemsControl ItemsSource="{Binding Turns}" Focusable="False"
                          Visibility="{Binding IsEmpty, Converter={StaticResource Faden.InverseBoolToVisibility}}"
                          VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel" VirtualizingPanel.CacheLengthUnit="Page" VirtualizingPanel.CacheLength="1"
                          ScrollViewer.CanContentScroll="True">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <VirtualizingStackPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.Template>
                    <ControlTemplate TargetType="ItemsControl">
                        <ScrollViewer CanContentScroll="True" Focusable="False" HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto" Padding="0,0,0,12" b:StickToBottom.IsEnabled="True">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </ControlTemplate>
                </ItemsControl.Template>
            </ItemsControl>

            <Button Style="{StaticResource Faden.GhostButton.HideDisabled}" Command="{Binding LoadEarlierCommand}"
                    VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,8,0,0" Background="{DynamicResource Faden.Surface}"
                    BorderBrush="{DynamicResource Faden.Border}" Padding="12,4">
                <TextBlock Style="{StaticResource Faden.Muted}" Text="Show earlier messages" />
            </Button>

            <Border VerticalAlignment="Top" Margin="12" Padding="12,8" CornerRadius="{StaticResource Faden.Radius.Control}" BorderThickness="3,0,0,0"
                    BorderBrush="{DynamicResource Faden.Danger}" Background="{DynamicResource Faden.BlockedBackground}"
                    Visibility="{Binding Error, Converter={StaticResource Faden.EmptyToCollapsed}}">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource Faden.SecondaryButton}" Content="Try again"
                            Command="{Binding InitializeCommand}" Margin="12,0,0,0" />
                    <TextBlock Text="{Binding Error}" TextWrapping="Wrap" VerticalAlignment="Center" />
                </DockPanel>
            </Border>
        </Grid>

        <!-- Composer -->
        <Border Grid.Row="2" Margin="12,4,12,12" Padding="12,8,6,6" CornerRadius="{StaticResource Faden.Radius.Container}" BorderThickness="1"
                BorderBrush="{DynamicResource Faden.Border}" Background="{DynamicResource Faden.Surface}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <!-- Attached context: chips; an implicit one (the current selection) can be switched off -->
                <ItemsControl ItemsSource="{Binding Attachments}" Focusable="False" Margin="0,0,0,6"
                              Visibility="{Binding Attachments.Count, Converter={StaticResource Faden.EmptyToCollapsed}}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:AttachmentViewModel}">
                            <Border x:Name="Chip" CornerRadius="{StaticResource Faden.Radius.Chip}" BorderThickness="1" BorderBrush="{DynamicResource Faden.Border}"
                                    Background="{DynamicResource Faden.SurfaceAlt}" Padding="6,2,2,2" Margin="0,0,6,4">
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Faden.GhostButton}" Padding="2" Command="{Binding ToggleCommand}"
                                            ToolTip="Include with the next message" Visibility="{Binding IsImplicit, Converter={StaticResource Faden.BoolToVisibility}}">
                                        <TextBlock x:Name="Eye" Style="{StaticResource Faden.Icon}" FontSize="11" Text="&#xE7B3;" />
                                    </Button>
                                    <TextBlock x:Name="ChipIcon" Style="{StaticResource Faden.Icon}" FontSize="11" Text="&#xE8A5;" Margin="0,0,4,0"
                                               Foreground="{DynamicResource Faden.ForegroundMuted}"
                                               Visibility="{Binding IsImplicit, Converter={StaticResource Faden.InverseBoolToVisibility}}" />
                                    <TextBlock x:Name="ChipTitle" Text="{Binding Title}" VerticalAlignment="Center" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Subtitle}" FontSize="12" />
                                    <Button Style="{StaticResource Faden.GhostButton}" Padding="3" Margin="2,0,0,0" ToolTip="Remove"
                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" Visibility="{Binding IsImplicit, Converter={StaticResource Faden.InverseBoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Faden.Icon}" FontSize="9" Text="&#xE711;" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                                    <Setter TargetName="ChipTitle" Property="Foreground" Value="{DynamicResource Faden.ForegroundMuted}" />
                                    <Setter TargetName="Eye" Property="Text" Value="&#xED1A;" />
                                    <Setter TargetName="Chip" Property="Background" Value="Transparent" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBox x:Name="Composer" Grid.Row="1" Text="{Binding Input, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True"
                         TextWrapping="Wrap" MaxHeight="200" MinHeight="40" VerticalScrollBarVisibility="Auto"
                         BorderThickness="0" Background="Transparent" Foreground="{DynamicResource Faden.Foreground}"
                         CaretBrush="{DynamicResource Faden.Foreground}" Padding="0,2" IsEnabled="{Binding IsReady}"
                         b:ComposerFocus.Chat="{Binding}" AutomationProperties.Name="Message">
                    <TextBox.InputBindings>
                        <!-- Enter sends; Shift+Enter is a new line (AcceptsReturn) -->
                        <KeyBinding Key="Enter" Command="{Binding SendCommand}" />
                    </TextBox.InputBindings>
                </TextBox>
                <TextBlock Grid.Row="1" Text="Ask a question, or tell the agent what to do" IsHitTestVisible="False"
                           Foreground="{DynamicResource Faden.ForegroundMuted}" Padding="2,2" VerticalAlignment="Top">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=Composer}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <DockPanel Grid.Row="2" Margin="0,6,0,0">
                    <Grid DockPanel.Dock="Right">
                        <Button Style="{StaticResource Faden.PrimaryButton}" Padding="8,5" ToolTip="Send (Enter)" AutomationProperties.Name="Send"
                                Command="{Binding SendCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource Faden.InverseBoolToVisibility}}">
                            <TextBlock Style="{StaticResource Faden.Icon}" FontSize="13" Text="&#xE724;" Foreground="{DynamicResource Faden.AccentForeground}" />
                        </Button>
                        <Button Style="{StaticResource Faden.SecondaryButton}" Padding="8,5" ToolTip="Stop (Esc)" AutomationProperties.Name="Stop"
                                Command="{Binding StopCommand}"
                                Visibility="{Binding IsBusy, Converter={StaticResource Faden.BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Faden.Icon}" FontSize="13" Text="&#xE71A;" />
                        </Button>
                    </Grid>
                    <!-- A host's own buttons (e.g. "Add context") -->
                    <ContentPresenter DockPanel.Dock="Left" Margin="0,0,6,0" VerticalAlignment="Center"
                                      Content="{Binding ComposerToolbar, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                    <TextBlock Style="{StaticResource Faden.Muted}" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding SelectedToolMode.Label, Mode=OneWay}" /><Run Text=" · " /><Run Text="{Binding SelectedToolMode.Description, Mode=OneWay}" />
                    </TextBlock>
                </DockPanel>
            </Grid>
        </Border>

        <!--
            The chats: a dropdown under the header, as wide as the panel, so the conversation stays in view and a
            narrow pane (an Office task pane) crops nothing. Its items sit 6 in from its 12 corners.
        -->
        <Popup x:Name="HistoryMenu" IsOpen="{Binding IsHistoryOpen, Mode=TwoWay}" PlacementTarget="{Binding ElementName=Header}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade"
               Width="{Binding ActualWidth, ElementName=Header}">
            <Border Margin="8,4,8,16" Background="{DynamicResource Faden.Surface}" BorderBrush="{DynamicResource Faden.Border}"
                    BorderThickness="1" CornerRadius="{StaticResource Faden.Radius.Container}" Padding="6" MaxHeight="440">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.3" />
                </Border.Effect>
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="8,2,0,4">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Faden.GhostButton}" Command="{Binding NewChatCommand}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Faden.Icon}" FontSize="11" Text="&#xE710;" Margin="0,0,6,0" />
                                <TextBlock Text="New chat" FontSize="12" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <TextBlock Text="Chats" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <TextBlock DockPanel.Dock="Top" Style="{StaticResource Faden.Muted}" Text="No chats yet." Margin="8,4,8,8"
                               Visibility="{Binding Sessions.Count, Converter={StaticResource Faden.EmptyToCollapsed}, ConverterParameter=invert}" />
                    <ItemsControl ItemsSource="{Binding Sessions}" Focusable="False"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VirtualizingStackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.Template>
                            <ControlTemplate TargetType="ItemsControl">
                                <ScrollViewer CanContentScroll="True" Focusable="False" VerticalScrollBarVisibility="Auto"
                                              HorizontalScrollBarVisibility="Disabled">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </ControlTemplate>
                        </ItemsControl.Template>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionItemViewModel}">
                                <Grid x:Name="Row" Margin="0,1">
                                    <Button x:Name="Open" Style="{StaticResource Faden.GhostButton}" HorizontalContentAlignment="Stretch" Padding="10,6,34,6"
                                            Command="{Binding DataContext.OpenSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}" AutomationProperties.Name="{Binding Title}">
                                        <DockPanel>
                                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Faden.Muted}" FontSize="11" Text="{Binding WhenText}"
                                                       Margin="8,0,0,0" />
                                            <TextBlock x:Name="TitleText" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Button>
                                    <Button x:Name="Delete" Style="{StaticResource Faden.GhostButton}" HorizontalAlignment="Right" Margin="0,0,4,0"
                                            ToolTip="Delete chat" AutomationProperties.Name="Delete chat" Visibility="Hidden"
                                            Command="{Binding DataContext.DeleteSessionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}">
                                        <TextBlock Style="{StaticResource Faden.Icon}" FontSize="12" Foreground="{DynamicResource Faden.ForegroundMuted}" Text="&#xE74D;" />
                                    </Button>
                                </Grid>
                                <DataTemplate.Triggers>
                                    <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Delete" Property="Visibility" Value="Visible" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                                        <Setter TargetName="Open" Property="Background" Value="{DynamicResource Faden.Hover}" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </DockPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
