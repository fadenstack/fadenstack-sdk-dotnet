<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fadenstack.Agents</RootNamespace>
    <PackageId>Fadenstack.Agents</PackageId>
    <Description>Agents on Fadenstack: the agent builder, the tool loop with host tools, tool modes and approvals, local encrypted sessions, and typed governance outcomes.</Description>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.AI" Version="10.10.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <!-- Restricts a named pipe to the current user on .NET Framework (PipeSecurity); .NET 8 has PipeOptions.CurrentUserOnly. -->
    <PackageReference Include="System.IO.Pipes.AccessControl" Version="5.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fadenstack.Client\Fadenstack.Client.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Fadenstack.Agents.Delegation" />
    <InternalsVisibleTo Include="Fadenstack.Agents.Tests" />
    <InternalsVisibleTo Include="Fadenstack.Mcp" />
    <InternalsVisibleTo Include="Fadenstack.Provenance" />
    <InternalsVisibleTo Include="Fadenstack.Workspaces" />
  </ItemGroup>
</Project>
