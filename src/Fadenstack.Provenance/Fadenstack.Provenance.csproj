<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>Fadenstack.Provenance</RootNamespace>
    <PackageId>Fadenstack.Provenance</PackageId>
    <Description>Content provenance for Fadenstack agents: tools place what a model wrote through one pipeline that marks it as AI-generated where the host can carry a mark (HTML, Markdown, key-value fields, sidecar files, HTTP headers, pictures), has the server sign a record of each placement, and reports which layers held.</Description>
    <PackageTags>$(PackageTags);provenance;content-credentials;ai-act</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Fadenstack.Agents\Fadenstack.Agents.csproj" />
  </ItemGroup>
  <!-- The words a mark shows people are the module's own: Resources/ProvenanceText.resx (English) and its translations,
       built into satellite assemblies (sdk/52 P1: a module owns its texts). -->
  <ItemGroup>
    <InternalsVisibleTo Include="Fadenstack.Provenance.Tests" />
  </ItemGroup>
</Project>
