<Project>
  <!-- Shared by every project. Libraries are netstandard2.0: one package for
       .NET Framework 4.7.2+ hosts (add-ins, desktop applications) and .NET 8/10. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The copyright holder, as in NOTICE. -->
    <Authors>Emagin8 UG (haftungsbeschränkt)</Authors>
    <Company>Emagin8 UG (haftungsbeschränkt)</Company>
    <Product>Fadenstack</Product>
    <Copyright>Copyright 2026 Emagin8 UG (haftungsbeschränkt) and contributors</Copyright>
    <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    <PackageProjectUrl>https://developers.fadenstack.com/sdk/dotnet/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/fadenstack/fadenstack-sdk-dotnet</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <!-- The release: a tag v<Version> publishes it (.github/workflows/release.yml checks they match). -->
    <Version>0.3.0-rc.1</Version>
  </PropertyGroup>

  <!-- Strong names: a strong-named host or add-in can only load strong-named assemblies. The key is public on
       purpose (Microsoft's advice for open-source libraries): a strong name is an identity, not a signature anyone
       should trust. PublicKey is what InternalsVisibleTo names the friend assemblies with; all are signed with this key. -->
  <PropertyGroup>
    <SignAssembly>true</SignAssembly>
    <AssemblyOriginatorKeyFile>$(MSBuildThisFileDirectory)Fadenstack.snk</AssemblyOriginatorKeyFile>
    <PublicKey></PublicKey>
  </PropertyGroup>
</Project>
