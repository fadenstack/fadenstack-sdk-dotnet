{
  "$defs": {
    "LayerOutcome": {
      "additionalProperties": false,
      "description": "One layer of one mark: applied, or not and why.",
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "layer": {
          "enum": [
            "watermark",
            "metadata",
            "fingerprint",
            "label"
          ],
          "title": "Layer",
          "type": "string"
        },
        "method": {
          "description": "e.g. trustmark-Q, c2pa, xmp, vllm-gumbel, html-attribute",
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "sink-cannot-carry",
                "stripped-by-host",
                "short-text",
                "exempt-edit",
                "no-watermark-remote-model",
                "no-watermark-greedy",
                "runtime-without-watermark",
                "server-unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "verified": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "for an applied layer: read back from the host after placing (true), or not readable there (false); none when the SDK did not try",
          "title": "Verified"
        }
      },
      "required": [
        "layer",
        "method",
        "applied"
      ],
      "title": "LayerOutcome",
      "type": "object"
    }
  },
  "$id": "https://fadenstack.com/schemas/provenance/v1/placement-report.schema.json",
  "additionalProperties": false,
  "description": "What the SDK reports after placing content: where, how much, which layers held. Never the content.",
  "properties": {
    "edit_kind": {
      "enum": [
        "generated",
        "rewritten",
        "summarised",
        "translated",
        "corrected",
        "formatted",
        "extracted"
      ],
      "title": "Edit Kind",
      "type": "string"
    },
    "failure": {
      "anyOf": [
        {
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9_.:-]{1,64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "only with written false: the error's name as a short code, never its message or any content",
      "title": "Failure"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/LayerOutcome"
      },
      "title": "Layers",
      "type": "array"
    },
    "length_class": {
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "title": "Length Class",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "record_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the placement's signed record; none for content exempt from marking",
      "title": "Record Id"
    },
    "sink_kind": {
      "description": "e.g. word.range, html.editor, nextcloud.file",
      "title": "Sink Kind",
      "type": "string"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    },
    "written": {
      "default": true,
      "description": "false only for an insert that failed after the record was signed: the record is marked not written",
      "title": "Written",
      "type": "boolean"
    }
  },
  "required": [
    "tool",
    "sink_kind",
    "media_type",
    "edit_kind",
    "length_class",
    "layers"
  ],
  "title": "PlacementReport",
  "type": "object"
}
