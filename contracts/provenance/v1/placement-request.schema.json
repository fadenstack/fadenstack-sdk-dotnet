{
  "$defs": {
    "LayerOutcome": {
      "additionalProperties": false,
      "description": "One layer of one mark: applied, or not and why.",
      "properties": {
        "applied": {
          "title": "Applied",
          "type": "boolean"
        },
        "layer": {
          "enum": [
            "watermark",
            "metadata",
            "fingerprint",
            "label"
          ],
          "title": "Layer",
          "type": "string"
        },
        "method": {
          "description": "e.g. trustmark-Q, c2pa, xmp, vllm-gumbel, html-attribute",
          "title": "Method",
          "type": "string"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "sink-cannot-carry",
                "stripped-by-host",
                "short-text",
                "exempt-edit",
                "no-watermark-remote-model",
                "no-watermark-greedy",
                "runtime-without-watermark",
                "server-unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        }
      },
      "required": [
        "layer",
        "method",
        "applied"
      ],
      "title": "LayerOutcome",
      "type": "object"
    }
  },
  "$id": "https://fadenstack.com/schemas/provenance/v1/placement-request.schema.json",
  "additionalProperties": false,
  "description": "``POST /api/v1/provenance/placements``: a placement report and the agent that placed the content.",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent"
    },
    "edit_kind": {
      "enum": [
        "generated",
        "rewritten",
        "summarised",
        "translated",
        "corrected",
        "formatted",
        "extracted"
      ],
      "title": "Edit Kind",
      "type": "string"
    },
    "layers": {
      "items": {
        "$ref": "#/$defs/LayerOutcome"
      },
      "title": "Layers",
      "type": "array"
    },
    "length_class": {
      "enum": [
        "short",
        "medium",
        "long"
      ],
      "title": "Length Class",
      "type": "string"
    },
    "media_type": {
      "title": "Media Type",
      "type": "string"
    },
    "record_id": {
      "title": "Record Id",
      "type": "string"
    },
    "sink_kind": {
      "description": "e.g. word.range, html.editor, nextcloud.file",
      "title": "Sink Kind",
      "type": "string"
    },
    "tool": {
      "title": "Tool",
      "type": "string"
    }
  },
  "required": [
    "record_id",
    "tool",
    "sink_kind",
    "media_type",
    "edit_kind",
    "length_class",
    "layers"
  ],
  "title": "PlacementRequest",
  "type": "object"
}
