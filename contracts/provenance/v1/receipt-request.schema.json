{
  "$defs": {
    "WatermarkStatus": {
      "additionalProperties": false,
      "description": "Whether a generation carries a watermark, whose, and if not, why.",
      "properties": {
        "algorithm": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Algorithm"
        },
        "applied": {
          "enum": [
            "model",
            "engine",
            "upstream",
            "none"
          ],
          "title": "Applied",
          "type": "string"
        },
        "context_width": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "vLLM's context width, for model watermarks",
          "title": "Context Width"
        },
        "key_version": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the watermark key's version, for model watermarks",
          "title": "Key Version"
        },
        "reason": {
          "anyOf": [
            {
              "enum": [
                "sink-cannot-carry",
                "stripped-by-host",
                "short-text",
                "exempt-edit",
                "no-watermark-remote-model",
                "no-watermark-greedy",
                "runtime-without-watermark",
                "server-unavailable"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reason"
        },
        "tokenizer": {
          "anyOf": [
            {
              "maxLength": 256,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the model repository whose tokenizer generation used, for model watermarks",
          "title": "Tokenizer"
        },
        "vendor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "the remote provider whose own mark it is, for upstream",
          "title": "Vendor"
        }
      },
      "required": [
        "applied"
      ],
      "title": "WatermarkStatus",
      "type": "object"
    }
  },
  "$id": "https://fadenstack.com/schemas/provenance/v1/receipt-request.schema.json",
  "additionalProperties": false,
  "description": "``POST /api/v1/provenance/receipts``: the gateway, after a model's answer, with the answer's hash only.",
  "properties": {
    "agent": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent"
    },
    "content_sha256": {
      "description": "SHA-256 of the normalised text, hex",
      "pattern": "^[0-9a-f]{64}$",
      "title": "Content Sha256",
      "type": "string"
    },
    "kind": {
      "const": "text",
      "default": "text",
      "title": "Kind",
      "type": "string"
    },
    "model": {
      "title": "Model",
      "type": "string"
    },
    "model_version": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Model Version"
    },
    "watermark": {
      "$ref": "#/$defs/WatermarkStatus"
    }
  },
  "required": [
    "model",
    "content_sha256",
    "watermark"
  ],
  "title": "ReceiptRequest",
  "type": "object"
}
