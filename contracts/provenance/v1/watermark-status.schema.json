{
  "$id": "https://fadenstack.com/schemas/provenance/v1/watermark-status.schema.json",
  "additionalProperties": false,
  "description": "Whether a generation carries a watermark, whose, and if not, why.",
  "properties": {
    "algorithm": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Algorithm"
    },
    "applied": {
      "enum": [
        "model",
        "engine",
        "upstream",
        "none"
      ],
      "title": "Applied",
      "type": "string"
    },
    "context_width": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "vLLM's context width, for model watermarks",
      "title": "Context Width"
    },
    "key_version": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the watermark key's version, for model watermarks",
      "title": "Key Version"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "sink-cannot-carry",
            "stripped-by-host",
            "short-text",
            "exempt-edit",
            "no-watermark-remote-model",
            "no-watermark-greedy",
            "runtime-without-watermark",
            "server-unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "vendor": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "the remote provider whose own mark it is, for upstream",
      "title": "Vendor"
    }
  },
  "required": [
    "applied"
  ],
  "title": "WatermarkStatus",
  "type": "object"
}
