{
  "$id": "https://fadenstack.com/schemas/provenance/v1/layer-outcome.schema.json",
  "additionalProperties": false,
  "description": "One layer of one mark: applied, or not and why.",
  "properties": {
    "applied": {
      "title": "Applied",
      "type": "boolean"
    },
    "layer": {
      "enum": [
        "watermark",
        "metadata",
        "fingerprint",
        "label"
      ],
      "title": "Layer",
      "type": "string"
    },
    "method": {
      "description": "e.g. trustmark-Q, c2pa, xmp, vllm-gumbel, html-attribute",
      "title": "Method",
      "type": "string"
    },
    "reason": {
      "anyOf": [
        {
          "enum": [
            "sink-cannot-carry",
            "stripped-by-host",
            "short-text",
            "exempt-edit",
            "no-watermark-remote-model",
            "no-watermark-greedy",
            "runtime-without-watermark",
            "server-unavailable"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "verified": {
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "for an applied layer: read back from the host after placing (true), or not readable there (false); none when the SDK did not try",
      "title": "Verified"
    }
  },
  "required": [
    "layer",
    "method",
    "applied"
  ],
  "title": "LayerOutcome",
  "type": "object"
}
