<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fadenstack.UI\Fadenstack.UI.csproj" />
    <!-- The real skills workshop for the skill editor's view model tests (a temporary folder). -->
    <ProjectReference Include="..\..\src\Fadenstack.Skills\Fadenstack.Skills.csproj" />
    <Compile Include="..\Fadenstack.Client.Tests\FakeServer.cs" Link="FakeServer.cs" />
    <Compile Include="..\Fadenstack.Client.Tests\OpenAiFake.cs" Link="OpenAiFake.cs" />
    <Compile Include="..\Fadenstack.Agents.Tests\Gateway.cs" Link="Gateway.cs" />
    <Compile Include="..\Fadenstack.Agents.Tests\PageTools.cs" Link="PageTools.cs" />
    <Compile Include="..\Fadenstack.Agents.Tests\FakeGrants.cs" Link="FakeGrants.cs" />
    <Compile Include="..\Fadenstack.Agents.Tests\AbortedStream.cs" Link="AbortedStream.cs" />
    <Compile Include="..\..\samples\Fadenstack.Samples.Wpf\DemoGateway.cs" Link="DemoGateway.cs" />
    <Compile Include="..\..\samples\Fadenstack.Samples.Console\DemoTools.cs" Link="DemoTools.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- The injection suite's corpus (sdk/51 7.1): the same file the agent tests run, for the image gate (G4). -->
    <None Include="..\Fadenstack.Agents.Tests\Injection\corpus.json" Link="Injection\corpus.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The skins' Markdown drawing code, read as text: no bitmap, no download (G4). -->
    <None Include="..\..\src\Fadenstack.UI.Wpf\Behaviors\MarkdownText.cs" Link="Skins\Behaviors\MarkdownText.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Fadenstack.UI.Avalonia\Views\MarkdownView.cs" Link="Skins\Views\MarkdownView.cs" CopyToOutputDirectory="PreserveNewest" />
    <!-- The cases both SDKs test their Markdown-to-HTML against: the TypeScript SDK has the same file. -->
    <None Include="vectors\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The "Report a problem" mail as a table: the TypeScript SDK holds the same file (subject, body, link and copy for given inputs). -->
    <None Include="ReportProblem\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The WPF skin's colours, for ThemeContrastTests (read as text: these tests do not load WPF). -->
    <None Include="..\..\src\Fadenstack.UI.Wpf\Themes\Colors.*.xaml" Link="Themes\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <!-- The card templates and the panel's key bindings, for BypassTemplateTests (read as XML). -->
    <None Include="..\..\src\Fadenstack.UI.Wpf\Themes\Chat.xaml" Link="Themes\Chat.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Fadenstack.UI.Wpf\Views\ChatView.xaml" Link="Views\ChatView.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
