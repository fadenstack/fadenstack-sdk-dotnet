<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- The WPF skin is for Windows: it targets net472 and net8.0-windows; the tests run on the newest. -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fadenstack.UI.Wpf\Fadenstack.UI.Wpf.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Skills\Fadenstack.Skills.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- What the views exposed to a UI driver before the styling pass: the automation names and ids must not change. -->
    <Content Include="automation-before.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <!-- The wizard's fakes (the server, the endpoint checks, the stores, the clock): the tests drive the same real view model as the UI tests do. -->
    <Compile Include="..\Fadenstack.UI.Tests\WizardFakes.cs" Link="Harness\WizardFakes.cs" />
    <!-- The skill editor's fakes (a real workshop on a temporary folder, a scripted model, the file dialogs): the tests drive the same real view models as the UI tests do. -->
    <Compile Include="..\Fadenstack.UI.Tests\SkillEditorFakes.cs" Link="Harness\SkillEditorFakes.cs" />
  </ItemGroup>
</Project>
