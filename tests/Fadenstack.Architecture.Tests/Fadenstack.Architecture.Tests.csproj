<Project Sdk="Microsoft.NET.Sdk">
  <!-- The architecture rules (fadenstack-dev sdk/52 §4 and §6, P5): layers, the light core, strict MVVM in the skins.
       net10.0-windows, so the WPF skin (net472; net8.0-windows) can be referenced and read; its rows are skipped elsewhere. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageReference Include="TngTech.ArchUnitNET" Version="0.13.5" />
    <PackageReference Include="TngTech.ArchUnitNET.xUnit" Version="0.13.5" />
  </ItemGroup>
  <ItemGroup>
    <!-- Every library of the SDK, so its built assembly is next to the tests (A1 reads what each one references). -->
    <ProjectReference Include="..\..\src\Fadenstack.Client\Fadenstack.Client.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Agents\Fadenstack.Agents.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Agents.Delegation\Fadenstack.Agents.Delegation.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Mcp\Fadenstack.Mcp.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Provenance\Fadenstack.Provenance.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Workspaces\Fadenstack.Workspaces.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Secrets\Fadenstack.Secrets.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.UI\Fadenstack.UI.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.UI.Avalonia\Fadenstack.UI.Avalonia.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.UI.Wpf\Fadenstack.UI.Wpf.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- UseWPF leaves System.IO out of the implicit usings (Path would clash with WPF's); these tests read files. -->
    <Using Include="System.IO" />
    <None Include="codebehind-allowlist.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
