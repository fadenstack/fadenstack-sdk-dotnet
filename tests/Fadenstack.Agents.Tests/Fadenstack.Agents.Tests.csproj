<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0;net48</TargetFrameworks>
    <IsTestProject>true</IsTestProject>
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- A MAF workflow runs a Fadenstack agent (sdk/51 F02, the AIAgent smoke test); tests only, never the SDK. -->
    <PackageReference Include="Microsoft.Agents.AI.Workflows" Version="1.28.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\src\Fadenstack.Agents\Fadenstack.Agents.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Agents.Delegation\Fadenstack.Agents.Delegation.csproj" />
    <ProjectReference Include="..\..\src\Fadenstack.Mcp\Fadenstack.Mcp.csproj" />
    <Compile Include="..\Fadenstack.Client.Tests\FakeServer.cs" Link="FakeServer.cs" />
    <Compile Include="..\Fadenstack.Client.Tests\TelemetryCapture.cs" Link="TelemetryCapture.cs" />
    <Compile Include="..\Fadenstack.Client.Tests\OpenAiFake.cs" Link="OpenAiFake.cs" />
  </ItemGroup>
  <ItemGroup>
    <!-- Core's agent templates (release/0.7.1): the apps' contracts/*.json with local_skills_mode, as AgentDefinition reads them. -->
    <None Include="Definitions\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- The AG-UI golden files (F07): the same bytes as the TypeScript SDK's packages/agents/test/agui. -->
    <None Include="AgUi\*.jsonl" CopyToOutputDirectory="PreserveNewest" />
    <!-- The injection corpus (sdk/51 7.1): the same bytes as the TypeScript SDK's packages/agents/test/injection/corpus.json. -->
    <None Include="Injection\corpus.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Condition="'$(TargetFramework)' == 'net48'">
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Using Include="System.Net.Http" />
  </ItemGroup>
</Project>
